# Settings for `rok run -- serve`. Copy to `.env` (git-ignored); variables
# already in the process environment win over this file.

# Public base URL: OAuth callback ({URL}/auth/github/callback) and links.
ROKSTONES_URL=https://rokstones.io
# Plain HTTP listen address; TLS ends at the reverse proxy.
ROKSTONES_ADDR=127.0.0.1:8080

# GitHub OAuth app (Settings > Developer settings > OAuth Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub logins that may create publish tokens (comma-separated).
ROKSTONES_ADMINS=

# Accounts, sessions, tokens and owners (db.rokon).
ROKSTONES_DATA=/var/lib/rokstones/data
# Index checkout the server commits to and pushes from (with its own git
# credentials); it must track an upstream branch.
ROKSTONES_INDEX=/var/lib/rokstones/rokstones.io-index

# Only for tests against a fake GitHub.
# GITHUB_OAUTH_URL=https://github.com
# GITHUB_API_URL=https://api.github.com
