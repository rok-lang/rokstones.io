// The registry index: one file per stone, one `Stone { .. }` line per
// version (see the index's README). Reading, semver order, reverse
// dependencies, and each stone's README fetched from its source commit.

use rok::std::fs;
use rok::std::rokon;
use rok::std::rokon::Value;
use rok::std::process::Command;
use rok::core::cmp::Ordering;
use pkg::layout;
use pkg::apidoc;

pub struct Req {
    pub name: str;
    pub req: str;
    /// `"normal"`, `"dev"` or `"native"`.
    pub kind: str;
    /// Another index's url; `""` for this one.
    pub registry: str;
}

pub struct Version {
    pub vers: str;
    pub deps: List<Req>;
    pub url: str;
    pub rev: str;
    pub cksum: str;
    pub yanked: bool;
    /// From the manifest; `""` when not given.
    pub description: str;
    pub license: str;
    /// Feature name and what it enables, in manifest order.
    pub features: List<(str, List<str>)>;
    /// When its line was added to the index (`YYYY-MM-DD`, commit date);
    /// `""` when the index has no git history.
    pub date: str = "";
}

/// What a commit's tree holds, counted at build time.
pub struct Facts {
    /// Every file (blob) in the tree, and their total size in bytes.
    pub files: usize;
    pub bytes: i64;
    /// `.rok` files and their lines that are not blank.
    pub rok_files: usize;
    pub rok_lines: usize;
}

/// Package metadata from the commit's `rok.rokon`; empty when not given.
pub struct Meta {
    pub keywords: List<str>;
    /// Names only: an `<address>` after a name is dropped.
    pub authors: List<str>;
    /// http(s) addresses only; `""`: none.
    pub homepage: str;
    pub documentation: str;
}

pub fn no_meta() -> Meta { Meta { keywords: List::new(), authors: List::new(), homepage: "", documentation: "" } }

pub struct RDep {
    pub name: str;
    pub req: str;
}

pub struct Stone {
    pub name: str;
    /// Path of its file in the index (`ge/om/geom`).
    pub file: str;
    /// Publish order, oldest first.
    pub versions: List<Version>;
    pub latest: Version;
    /// Last commit touching its file: unix time and `YYYY-MM-DD`; 0 / `""`
    /// when the index has no git history.
    pub time: i64;
    pub date: str;
    /// Rendered README of the latest version; `""` when unavailable.
    pub readme: str;
    /// The latest version's description, else the README's first
    /// paragraph, as text.
    pub desc: str;
    /// Stones whose latest version depends on this one (normal deps).
    pub rdeps: List<RDep>;
    /// The latest version's tree; none when it could not be read.
    pub facts: Facts | none;
    /// Its public modules (apidoc.rok); empty when unavailable.
    pub api: List<web::apidoc::Module>;
    /// Why `api` is empty: `"tree"` (not fetched), `"lib"` (no
    /// src/lib.rok); `""` when it is not.
    pub api_none: str;
    /// `use ..;` for the install box (apidoc::import_line); `""`: none.
    pub import: str;
    pub meta: Meta;
    /// The version a version page shows (`readme`, `api`, .. are its);
    /// `""` on the stone's own pages.
    pub at: str = "";
    /// The stone's latest version, on a version page.
    pub top: str = "";
    /// One stone per version for its version pages, newest first; empty
    /// in those stones themselves.
    pub views: List<Stone> = List::new();
}

pub struct Index {
    pub stones: List<Stone>;
    /// Malformed lines and misplaced files.
    pub errors: List<str>;
}

/// Where README text comes from.
pub struct Readmes {
    /// Cache directory (`<cache>/git`, `<cache>/readme/<name>/<rev>.md`).
    pub cache: str;
    /// Directory of `<name>.md` used instead of git (`--demo`); `""`: none.
    pub fixed: str;
    /// Directory of `<name>/` source trees used instead of git (`--demo`).
    pub fixed_src: str = "";
    /// Never run `git fetch`.
    pub offline: bool;
}

/// A package name (spec 9.10.3): lowercase ASCII `[a-z0-9_-]+`, starting with a letter.
pub fn is_name(s: str) -> bool {
    if s.is_empty() { return false; }
    let first = true;
    for c in s.chars() {
        let ok = c.is_ascii_lowercase() || (!first && (c.is_ascii_digit() || c == '_' || c == '-'));
        if !ok { return false; }
        first = false;
    }
    true
}

/// A stone's file: `1/a`, `2/ab`, `3/a/abc`, `ab/cd/abcd..`.
pub fn shard(name: str) -> str {
    let n = name.to_lowercase();
    let k = n.len();
    if k == 1 { return "1/" + n; }
    if k == 2 { return "2/" + n; }
    if k == 3 { return "3/" + n[:1] + "/" + n; }
    n[:2] + "/" + n[2:4] + "/" + n
}

fn is_hex40(s: str) -> bool {
    if s.len() != 40 { return false; }
    for c in s.chars() {
        if !(c.is_ascii_digit() || (c >= 'a' && c <= 'f')) { return false; }
    }
    true
}

fn num(s: str) -> u64 { try s.parse::<u64>() catch _ { 0u64 } }

fn is_num(s: str) -> bool {
    if s.is_empty() { return false; }
    for c in s.chars() {
        if !c.is_ascii_digit() { return false; }
    }
    true
}

fn cmp_u64(a: u64, b: u64) -> Ordering {
    if a < b { Ordering::Less } else if a > b { Ordering::Greater } else { Ordering::Equal }
}

fn cmp_str(a: str, b: str) -> Ordering {
    if a < b { Ordering::Less } else if a > b { Ordering::Greater } else { Ordering::Equal }
}

/// `1.2.3-pre+build` -> core `1.2.3`, pre `pre` (build dropped).
fn split_vers(v: str) -> (str, str) {
    let s = v;
    if let k: usize = s.find("+") { s = s[:k]; }
    if let k: usize = s.find("-") { return (s[:k], s[k + 1:]); }
    (s, "")
}

/// Semver precedence.
pub fn cmp_vers(a: str, b: str) -> Ordering {
    let (ca, pa) = split_vers(a);
    let (cb, pb) = split_vers(b);
    let xa: List<str> = List::new();
    for p in ca.split(".") { xa.push(p); }
    let xb: List<str> = List::new();
    for p in cb.split(".") { xb.push(p); }
    for k in 0usize..3usize {
        let na = if k < xa.len() { num(xa[k]) } else { 0u64 };
        let nb = if k < xb.len() { num(xb[k]) } else { 0u64 };
        let o = cmp_u64(na, nb);
        if o != Ordering::Equal { return o; }
    }
    // A pre-release sorts before its release.
    if pa.is_empty() || pb.is_empty() { return cmp_u64(pb.len() as u64, pa.len() as u64); }
    let ia: List<str> = List::new();
    for p in pa.split(".") { ia.push(p); }
    let ib: List<str> = List::new();
    for p in pb.split(".") { ib.push(p); }
    let k = 0usize;
    while k < ia.len() && k < ib.len() {
        let x = ia[k];
        let y = ib[k];
        let o = if is_num(x) && is_num(y) {
            cmp_u64(num(x), num(y))
        } else if is_num(x) != is_num(y) {
            if is_num(x) { Ordering::Less } else { Ordering::Greater }
        } else {
            cmp_str(x, y)
        };
        if o != Ordering::Equal { return o; }
        k += 1;
    }
    cmp_u64(ia.len() as u64, ib.len() as u64)
}

pub fn is_pre(v: str) -> bool { !split_vers(v).1.is_empty() }

/// The version shown by default: the highest not yanked, a release over a
/// pre-release; the highest of all when every version is yanked.
fn pick_latest(vs: List<Version>) -> Version {
    let best = vs[0];
    let rank = |v: Version| if v.yanked { 0 } else if is_pre(v.vers) { 1 } else { 2 };
    for v in vs {
        let r = rank(v);
        let rb = rank(best);
        if r > rb || (r == rb && cmp_vers(v.vers, best.vers) == Ordering::Greater) { best = v; }
    }
    best
}

/// The requirement `rok add` writes for `v`: `^` and the version, or `=`
/// for a pre-release, which `rok add` only takes as `name@=<version>`.
pub fn add_req(v: str) -> str {
    if is_pre(v) { "=" + v } else { "^" + v }
}

fn get_str(f: OrderedDict<str, Value>, k: str) -> str | none {
    if let v: Value = f.get(k) {
        if let Value::Str(s) = v { return s; }
    }
    none
}

fn fields_of(v: Value, name: str) -> OrderedDict<str, Value> | none {
    if let Value::Struct { name: n, fields } = v {
        if n is none || (n ?? "") == name { return fields; }
    }
    none
}

pub struct LineError {
    pub msg: str;
}

impl Display for LineError {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(self.msg) }
}

impl Debug for LineError {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try f.write_str(f"LineError({self.msg})") }
}

impl Error for LineError {}

fn bad(msg: str) -> LineError { LineError { msg: msg } }

fn parse_req(v: Value) throws (LineError) -> Req {
    let f: OrderedDict<str, Value> = OrderedDict::new();
    if let x: OrderedDict<str, Value> = fields_of(v, "") { f = x; } else { throw bad("a dependency is `{ name: .., req: .., kind: .. }`"); }
    let name = get_str(f, "name") ?? "";
    if !is_name(name) { throw bad(f"bad dependency name `{name}`"); }
    let kind = get_str(f, "kind") ?? "normal";
    if kind != "normal" && kind != "dev" && kind != "native" { throw bad(f"bad dependency kind `{kind}`"); }
    Req { name: name, req: get_str(f, "req") ?? "*", kind: kind, registry: get_str(f, "registry") ?? "" }
}

/// One index line: the stone's name and the version.
pub fn parse_line(line: str) throws (LineError) -> (str, Version) {
    let v = try rokon::parse(line) catch e { throw bad(f"{e}"); };
    let f: OrderedDict<str, Value> = OrderedDict::new();
    if let x: OrderedDict<str, Value> = fields_of(v, "Stone") { f = x; } else { throw bad("not a `Stone { .. }`"); }
    let name = get_str(f, "name") ?? "";
    if !is_name(name) { throw bad(f"bad name `{name}`"); }
    let vers = get_str(f, "vers") ?? "";
    if vers.is_empty() { throw bad("no `vers`"); }
    let deps: List<Req> = List::new();
    if let d: Value = f.get("deps") {
        if let Value::List(xs) = d {
            for x in xs { deps.push(try parse_req(x)); }
        } else {
            throw bad("`deps` is a list");
        }
    }
    let url = "";
    let rev = "";
    if let s: Value = f.get("source") {
        if let Value::Variant { path, args, named } = s {
            if path == "Dep::git" && args.len() == 1 {
                if let Value::Str(u) = args[0] { url = u; }
                rev = get_str(named, "rev") ?? "";
            }
        }
    }
    if url.is_empty() || !is_hex40(rev) { throw bad("`source` is `Dep::git(\"<url>\", rev: \"<commit>\")`"); }
    let yanked = false;
    if let y: Value = f.get("yanked") {
        if let Value::Bool(b) = y { yanked = b; }
    }
    let features: List<(str, List<str>)> = List::new();
    if let Value::Dict(d) = f.get("features") ?? Value::None {
        for k in d.keys() {
            let Value::Str(fname) = k else { continue; };
            let on: List<str> = List::new();
            if let Value::List(xs) = d[k] {
                for x in xs {
                    if let Value::Str(e) = x { on.push(e); }
                }
            }
            features.push((fname, on));
        }
    }
    (name, Version { vers: vers, deps: deps, url: url, rev: rev, cksum: get_str(f, "cksum") ?? "", yanked: yanked, description: get_str(f, "description") ?? "", license: get_str(f, "license") ?? "", features: features })
}

/// `git args..`; its stdout, or none when it fails or cannot start.
fn git(args: List<str>) -> str | none {
    let o = try Command::new("git").args(args).env("GIT_TERMINAL_PROMPT", "0").output() catch _ { return none; };
    if !o.status.success() { return none; }
    try str::from_utf8(o.stdout) catch _ { none }
}

/// Last commit (unix time, date) of each file of the index `dir`.
fn file_dates(dir: str) -> Dict<str, (i64, str)> {
    let out: Dict<str, (i64, str)> = Dict::new();
    let log = git(["-C", dir, "log", "--relative", "--name-only", "--format=@%ct %cs"]) ?? "";
    let cur = (0i64, "");
    for l in log.split("\n") {
        if l.starts_with("@") {
            if let p: (str, str) = l[1:].split_once(" ") {
                cur = (try p.0.parse::<i64>() catch _ { 0i64 }, p.1);
            }
        } else if !l.is_empty() && !out.contains_key(l) {
            out.insert(l, cur);
        }
    }
    out
}

fn fetchable(url: str) -> bool {
    url.starts_with("https://") || url.starts_with("http://") || url.starts_with("file://") || url.starts_with("/")
}

/// A bare repository under `cache` that holds commit `rev` of `url`
/// (fetched if missing); none when it cannot be fetched.
pub fn fetch_commit(cache: str, url: str, rev: str) -> str | none {
    let db = cache + "/git";
    if !fs::exists(db) {
        try fs::create_dir_all(cache) catch _ { return none; };
        if git(["init", "-q", "--bare", db]) is none { return none; }
    }
    if git(["-C", db, "cat-file", "-e", rev + "^{commit}"]) is none {
        if git(["-C", db, "fetch", "-q", "--depth", "1", url, rev]) is none { return none; }
    }
    db
}

/// Whether commit `rev` in repository `db` has the file `path`.
pub fn has_file(db: str, rev: str, path: str) -> bool { git(["-C", db, "cat-file", "-e", f"{rev}:{path}"]) is str }

/// The tree hash of commit `rev` in repository `db`.
pub fn tree_of(db: str, rev: str) -> str | none {
    match git(["-C", db, "rev-parse", rev + "^{tree}"]) {
        t: str => t.trim(),
        none => none,
    }
}

/// README text of `url` at `rev`, cached by commit. A failed fetch is
/// not cached, so the next online build tries again.
fn readme_text(r: Readmes, name: str, url: str, rev: str) -> str {
    if !r.fixed.is_empty() {
        let p = f"{r.fixed}/{name}.md";
        return if fs::exists(p) { try fs::read_to_str(p) catch _ { "" } } else { "" };
    }
    let cached = f"{r.cache}/readme/{name}/{rev}.md";
    if fs::exists(cached) { return try fs::read_to_str(cached) catch _ { "" }; }
    if r.offline || !fetchable(url) { return ""; }
    let db = fetch_commit(r.cache, url, rev) ?? {
        eprintln(f"warning: {name}: cannot fetch {url} {rev[:12]}");
        return "";
    };
    let text = "";
    for f in ["README.md", "readme.md", "Readme.md", "README"] {
        if let t: str = git(["-C", db, "show", f"{rev}:{f}"]) {
            text = t;
            break;
        }
    }
    try fs::create_dir_all(f"{r.cache}/readme/{name}") catch _ { return text; };
    try fs::write(cached, text) catch _ {};
    text
}

/// A commit's tree: in the git cache, or a fixture directory (`--demo`).
struct Tree {
    db: str;
    rev: str;
    /// Fixture directory; `""` for git.
    dir: str;
}

/// The tree of `url` at `rev`; none offline when the cache lacks it, or
/// when it cannot be fetched.
fn tree_of_stone(r: Readmes, name: str, url: str, rev: str) -> Tree | none {
    if !r.fixed.is_empty() {
        let d = f"{r.fixed_src}/{name}";
        return if !r.fixed_src.is_empty() && fs::exists(d) { Tree { db: "", rev: rev, dir: d } } else { none };
    }
    let db = r.cache + "/git";
    if r.offline || !fetchable(url) {
        if !fs::exists(db) || git(["-C", db, "cat-file", "-e", rev + "^{commit}"]) is none { return none; }
        return Tree { db: db, rev: rev, dir: "" };
    }
    match fetch_commit(r.cache, url, rev) {
        d: str => Tree { db: d, rev: rev, dir: "" },
        none => none,
    }
}

/// Every file of `t` and its size, sorted by path.
fn tree_files(t: Tree) -> List<(str, i64)> {
    let out: List<(str, i64)> = List::new();
    if !t.dir.is_empty() {
        for entry in fs::walk(t.dir) {
            let e = try entry.get() catch _ { continue; };
            if !e.is_file() { continue; }
            let size = try fs::metadata(e.path()) catch _ { continue; };
            out.push((e.path().as_str()[t.dir.len() + 1:], size.len() as i64));
        }
        out.sort_by(|a: (str, i64), b: (str, i64)| a.0.cmp(b.0));
        return out;
    }
    // `<mode> blob <sha> <size>\t<path>`; submodules are commits, not blobs.
    for l in (git(["-C", t.db, "ls-tree", "-r", "-l", "-z", t.rev]) ?? "").split("\u{0}") {
        let (head, path) = l.split_once("\t") ?? ("", "");
        let ws: List<str> = List::new();
        for w in head.split(" ") {
            if !w.is_empty() { ws.push(w); }
        }
        if ws.len() != 4 || ws[1] != "blob" { continue; }
        out.push((path, try ws[3].parse::<i64>() catch _ { 0i64 }));
    }
    out
}

/// File `path` of `t`, as text.
fn tree_read(t: Tree, path: str) -> str | none {
    if !t.dir.is_empty() {
        let p = t.dir + "/" + path;
        return if fs::exists(p) { try fs::read_to_str(p) catch _ { none } } else { none };
    }
    git(["-C", t.db, "show", f"{t.rev}:{path}"])
}

fn nonblank(text: str) -> usize {
    let n = 0usize;
    for l in text.split("\n") {
        if !l.trim().is_empty() { n += 1; }
    }
    n
}

fn facts_of(t: Tree, files: List<(str, i64)>) -> Facts {
    let f = Facts { files: files.len(), bytes: 0i64, rok_files: 0usize, rok_lines: 0usize };
    for (p, size) in files {
        f.bytes += size;
        if p.ends_with(".rok") { f.rok_files += 1; }
    }
    if !t.dir.is_empty() {
        for (p, _size) in files {
            if p.ends_with(".rok") { f.rok_lines += nonblank(tree_read(t, p) ?? ""); }
        }
        return f;
    }
    // `<rev>:<path>:<count>` per file with a non-blank line.
    for l in (git(["-C", t.db, "grep", "-I", "-c", "-e", "[^[:space:]]", t.rev, "--", "*.rok"]) ?? "").split("\n") {
        if let k: usize = l.rfind(":") { f.rok_lines += try l[k + 1:].parse::<usize>() catch _ { 0usize }; }
    }
    f
}

/// The date each version's line was first added to the index `dir`
/// (commit date, `YYYY-MM-DD`), by `name@vers`; empty without history.
pub fn version_dates(dir: str) -> Dict<str, str> {
    let out: Dict<str, str> = Dict::new();
    let log = git(["-C", dir, "log", "--reverse", "--relative", "--no-renames", "--no-color", "--no-ext-diff", "-p", "-U0", "--format==%cs"]) ?? "";
    // `=<date>` heads each commit; no line of a patch starts with `=`.
    let cur = "";
    for l in log.split("\n") {
        if l.starts_with("=") {
            cur = l[1:];
        } else if l.starts_with("+Stone {") {
            let (name, v) = try parse_line(l[1:]) catch _ { continue; };
            let key = name + "@" + v.vers;
            if !out.contains_key(key) { out.insert(key, cur); }
        }
    }
    out
}

/// Where a README's relative link points: the file in the source repo
/// at the commit (GitHub / GitLab style), else the repo itself.
pub fn repo_link(url: str, rev: str, h: str) -> str {
    if h.starts_with("#") || h.starts_with("https://") || h.starts_with("http://") || h.starts_with("mailto:") { return h; }
    // Any other scheme (`javascript:` ..) is dropped.
    if h.contains(":") { return "#"; }
    let web = web_of(url);
    if web.is_empty() { return "#"; }
    let path = h;
    while path.starts_with("./") { path = path[2:]; }
    while path.starts_with("/") { path = path[1:]; }
    let lower = path.to_lowercase();
    let raw = false;
    for ext in [".png", ".jpg", ".jpeg", ".gif", ".svg", ".webp"] {
        if lower.ends_with(ext) { raw = true; }
    }
    f"{web}/{if raw { "raw" } else { "blob" }}/{rev}/{path}"
}

/// The repo's web page for a GitHub / GitLab / Codeberg url; `""` otherwise.
pub fn web_of(url: str) -> str {
    let u = url.strip_suffix(".git") ?? url;
    u = u.strip_suffix("/") ?? u;
    for host in ["https://github.com/", "https://gitlab.com/", "https://codeberg.org/"] {
        if u.starts_with(host) { return u; }
    }
    ""
}

/// Link to the source tree at `rev`.
pub fn tree_link(url: str, rev: str) -> str {
    let web = web_of(url);
    if web.is_empty() { return if fetchable(url) && !url.starts_with("/") { url } else { "" }; }
    if web.starts_with("https://codeberg.org/") { return f"{web}/src/commit/{rev}"; }
    f"{web}/tree/{rev}"
}

/// First paragraph of rendered HTML, as text, at most `n` chars.
fn first_para(html: str, n: usize) -> str {
    let a = html.find("<p>") ?? html.len();
    if a == html.len() { return ""; }
    let rest = html[a + 3:];
    let b = rest.find("</p>") ?? rest.len();
    let t = markdown::strip_tags(rest[:b]).replace("\n", " ").trim();
    if t.char_count() <= n { return t; }
    let out = StrBuf::new();
    let k = 0usize;
    for c in t.chars() {
        if k >= n { break; }
        out.push(c);
        k += 1;
    }
    out.to_str().trim_end() + "..."
}

/// The stone `k` as version `v` shows it: README, tree facts, API and
/// metadata of its commit.
fn shown(r: Readmes, k: str, file: str, versions: List<Version>, v: Version, rdeps: List<RDep>, t: i64, d: str) -> Stone {
    let html = "";
    let text = readme_text(r, k, v.url, v.rev);
    let facts: Facts | none = none;
    let api: List<web::apidoc::Module> = List::new();
    let api_none = "tree";
    let meta = no_meta();
    if let tr: Tree = tree_of_stone(r, k, v.url, v.rev) {
        let fl = tree_files(tr);
        facts = facts_of(tr, fl);
        api = apidoc::collect(k.replace("-", "_"), |p| tree_read(tr, p));
        api_none = if api.is_empty() { "lib" } else { "" };
        meta = meta_of(tree_read(tr, "rok.rokon") ?? "");
    }
    if !text.is_empty() {
        let doc = markdown::render_untrusted(text, layout::md(|h| repo_link(v.url, v.rev, h)));
        html = fix_headings(doc.html, k);
    }
    Stone {
        name: k,
        file: file,
        versions: versions,
        latest: v,
        time: t,
        date: d,
        readme: html,
        desc: if v.description.is_empty() { first_para(html, 140) } else { v.description },
        rdeps: rdeps,
        facts: facts,
        api: api,
        api_none: api_none,
        import: apidoc::import_line(k.replace("-", "_"), api, text),
        meta: meta,
    }
}

/// A new `Stone` with the fields of `s`.
fn again(s: Stone) -> Stone {
    Stone { name: s.name, file: s.file, versions: s.versions, latest: s.latest, time: s.time, date: s.date, readme: s.readme, desc: s.desc, rdeps: s.rdeps, facts: s.facts, api: s.api, api_none: s.api_none, import: s.import, meta: s.meta }
}

fn str_list(f: OrderedDict<str, Value>, k: str) -> List<str> {
    let out: List<str> = List::new();
    if let Value::List(xs) = f.get(k) ?? Value::None {
        for x in xs {
            if let Value::Str(s) = x {
                let t = s.trim();
                if !t.is_empty() && !out.contains(t) { out.push(t); }
            }
        }
    }
    out
}

fn web_url(u: str) -> str {
    let t = u.trim();
    if (t.starts_with("https://") || t.starts_with("http://")) && !t.contains(" ") { t } else { "" }
}

/// Keywords, authors, homepage and documentation from a `rok.rokon`.
pub fn meta_of(text: str) -> Meta {
    let m = no_meta();
    let v = try rokon::parse(text) catch _ { return m; };
    let f = fields_of(v, "Package") ?? { return m; };
    m.keywords = str_list(f, "keywords");
    for a in str_list(f, "authors") {
        // `Name <mail>`: the name; an address alone stays out.
        let n = (if let k: usize = a.find("<") { a[:k] } else { a }).trim();
        if !n.is_empty() && !n.contains("@") { m.authors.push(n); }
    }
    m.homepage = web_url(get_str(f, "homepage") ?? "");
    m.documentation = web_url(get_str(f, "documentation") ?? "");
    m
}

/// A README under the stone's own `<h1>`: a leading `<h1>` that is the
/// stone's name goes, and any other `<h1>` moves every heading down one.
pub fn fix_headings(html: str, name: str) -> str {
    let out = html.trim_start();
    if out.starts_with("<h1") {
        if let e: usize = out.find("</h1>") {
            let open = out.find(">") ?? 0;
            let text = markdown::strip_tags(out[open + 1:e]).trim();
            text = (text.strip_prefix("#") ?? text).trim();
            if text.to_lowercase() == name.to_lowercase() { out = out[e + 5:].trim_start(); }
        }
    }
    if !out.contains("<h1") { return out; }
    for k in [5, 4, 3, 2, 1] { out = out.replace(f"<h{k}", f"<h{k + 1}").replace(f"</h{k}>", f"</h{k + 1}>"); }
    out
}

pub fn load(dir: str, r: Readmes) -> Index {
    let errors: List<str> = List::new();
    let by_name: Dict<str, List<Version>> = Dict::new();
    let files: Dict<str, str> = Dict::new();
    for entry in fs::walk(dir) {
        let e = try entry.get() catch err {
            errors.push(f"{err}");
            continue;
        };
        if !e.is_file() { continue; }
        let rel = e.path().as_str()[dir.len() + 1:];
        // Top-level files (config.rokon, README.md), git internals and
        // native packages.
        if !rel.contains("/") || rel.starts_with(".") || rel.starts_with("native/") { continue; }
        let text = try fs::read_to_str(e.path()) catch err {
            errors.push(f"{rel}: {err}");
            continue;
        };
        let n = 0usize;
        for line in text.split("\n") {
            n += 1;
            if line.trim().is_empty() { continue; }
            let (name, v) = try parse_line(line) catch err {
                errors.push(f"{rel}:{n}: {err}");
                continue;
            };
            if shard(name) != rel {
                errors.push(f"{rel}:{n}: `{name}` belongs in {shard(name)}");
                continue;
            }
            if !by_name.contains_key(name) {
                by_name.insert(name, List::new());
                files.insert(name, rel);
            }
            by_name[name].push(v);
        }
    }

    let names: List<str> = List::new();
    for k in by_name.keys() { names.push(k); }
    names.sort();

    let latest: Dict<str, Version> = Dict::new();
    for k in names { latest.insert(k, pick_latest(by_name[k])); }
    let rdeps: Dict<str, List<RDep>> = Dict::new();
    for k in names {
        let seen: Set<str> = Set::new();
        for d in latest[k].deps {
            if d.kind != "normal" || !d.registry.is_empty() || seen.contains(d.name) { continue; }
            seen.insert(d.name);
            if !rdeps.contains_key(d.name) { rdeps.insert(d.name, List::new()); }
            rdeps[d.name].push(RDep { name: k, req: d.req });
        }
    }

    let dates = file_dates(dir);
    let published = version_dates(dir);
    for k in names {
        let vs = by_name[k];
        for i in 0..vs.len() { vs[i].date = published.get(k + "@" + vs[i].vers) ?? ""; }
        latest[k].date = published.get(k + "@" + latest[k].vers) ?? "";
    }
    let stones: List<Stone> = List::new();
    for k in names {
        let l = latest[k];
        let (t, d) = dates.get(files[k]) ?? (0i64, "");
        let s = shown(r, k, files[k], by_name[k], l, rdeps.get(k) ?? List::new(), t, d);
        let vs: List<Version> = List::new();
        for v in by_name[k] { vs.push(v); }
        vs.sort_by(|a: Version, b: Version| cmp_vers(b.vers, a.vers));
        let views: List<Stone> = List::new();
        for v in vs {
            let x = if v.vers == l.vers { again(s) } else { shown(r, k, files[k], by_name[k], v, s.rdeps, t, d) };
            x.at = v.vers;
            x.top = l.vers;
            views.push(x);
        }
        s.views = views;
        stones.push(s);
    }
    Index { stones: stones, errors: errors }
}

#[cfg(test)]
fn expect(ok: bool, what: str) {
    if !ok { panic(what); }
}

#[test]
fn semver_order() {
    expect(cmp_vers("1.2.3", "1.10.0") == Ordering::Less, "numeric parts");
    expect(cmp_vers("1.0.0-alpha", "1.0.0") == Ordering::Less, "pre before release");
    expect(cmp_vers("1.0.0-alpha.2", "1.0.0-alpha.10") == Ordering::Less, "numeric pre ids");
    expect(cmp_vers("1.0.0-alpha", "1.0.0-alpha.1") == Ordering::Less, "shorter pre first");
    expect(cmp_vers("1.0.0+b", "1.0.0") == Ordering::Equal, "build ignored");
    expect(add_req("1.2.3") == "^1.2.3" && add_req("0.1.0") == "^0.1.0" && add_req("1.0.0-rc.1") == "=1.0.0-rc.1", "add_req");
}

#[test]
fn readme_headings() {
    let a = "<h1 id=\"json\"><a class=\"anchor\" href=\"#json\">#</a>JSON</h1>\n<p>x</p>\n<h2>Use</h2>";
    expect(fix_headings(a, "json") == "<p>x</p>\n<h2>Use</h2>", "name heading dropped");
    expect(fix_headings("<h1>Other</h1><h2>b</h2><h6>c</h6>", "json") == "<h2>Other</h2><h3>b</h3><h6>c</h6>", "demoted");
    expect(fix_headings("<p>a</p><h2>b</h2>", "json") == "<p>a</p><h2>b</h2>", "left alone");
}

#[test]
fn manifests() {
    let m = meta_of("Package { name: \"x\", version: \"0.1.0\", keywords: [\"json\", \"parser\", \"json\"], authors: [\"Ann Lee <ann@x.org>\", \"bob@x.org\"], homepage: \"javascript:x\", documentation: \"https://x.org/doc\" }");
    expect(m.keywords.len() == 2 && m.authors.len() == 1 && m.authors[0] == "Ann Lee", "lists");
    expect(m.homepage.is_empty() && m.documentation == "https://x.org/doc", "links");
    expect(meta_of("not rokon").keywords.is_empty(), "bad manifest");
}

#[test]
fn shards() {
    expect(shard("a") == "1/a" && shard("Ab") == "2/ab" && shard("num") == "3/n/num", "short");
    expect(shard("Geom") == "ge/om/geom", "long");
    expect(is_name("geom_2") && is_name("rok-syntax") && !is_name("2d") && !is_name("-a") && !is_name("Geom") && !is_name(""), "names");
}

#[test]
fn lines() {
    let (name, v) = try parse_line("Stone { name: \"geom\", vers: \"0.3.1\", deps: [{ name: \"num\", req: \"^1.2\", kind: \"normal\" }], source: Dep::git(\"https://github.com/o/geom\", rev: \"4f0c2a9e1b7d3c58a6e09f21d4b8c7a3e5f60123\"), cksum: \"x\", yanked: false, license: \"MIT\" }") catch e { panic(e.msg); };
    expect(name == "geom" && v.vers == "0.3.1" && v.deps.len() == 1 && v.deps[0].req == "^1.2", "fields");
    expect(v.license == "MIT" && v.description.is_empty() && v.features.is_empty(), "meta");
    expect(v.url == "https://github.com/o/geom" && !v.yanked, "source");
    let bad = try parse_line("Stone { name: \"x\", vers: \"1.0.0\", deps: [], source: Dep::path(\"..\"), cksum: \"\", yanked: false }") catch _ { ("", v) };
    expect(bad.0.is_empty(), "path source rejected");
    expect(repo_link("https://github.com/o/r.git", "abc", "docs/a.md") == "https://github.com/o/r/blob/abc/docs/a.md", "blob link");
    expect(repo_link("https://github.com/o/r", "abc", "./img/x.PNG") == "https://github.com/o/r/raw/abc/img/x.PNG", "raw link");
    expect(repo_link("https://github.com/o/r", "abc", "javascript:alert(1)") == "#", "scheme dropped");
}
