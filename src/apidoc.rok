// API docs of a stone, from its sources at the published commit: one
// section per public module reachable from `src/lib.rok` through
// `pub mod`, listing its `pub` items with their `///` docs. Signatures
// are shown as written.
//
// The scanner is rok-lang.org's src/apidoc.rok (the std API pages),
// copied as is: the source is scanned, not compiled. Comments, strings
// and chars are masked out first, so item boundaries are found by
// bracket depth alone. Docs come from the stone's author and are
// rendered untrusted.

use markdown::esc;

pub struct Member {
    pub name: str;
    pub sig: str;
    pub doc: str;
}

pub struct Item {
    /// `fn`, `struct`, `enum`, `trait`, `type`, `const`, `static`, `use`.
    pub kind: str;
    pub name: str;
    pub sig: str;
    pub doc: str;
    /// Fields, variants, trait items, inherent methods.
    pub members: List<Member>;
    /// `impl Trait for Self` headers.
    pub traits: List<str>;
}

pub struct Module {
    /// `json::read`.
    pub path: str;
    /// Source file in the stone's tree (`src/read.rok`).
    pub file: str;
    pub doc: str;
    pub items: List<Item>;
    /// Inherent impls of types not declared here, by type.
    pub impls: List<Item>;
    pub children: List<str>;
}

fn mask(cs: List<char>) -> List<char> {
    let out: List<char> = List::new();
    for c in cs { out.push(c); }
    let i = 0usize;
    let n = cs.len();
    while i < n {
        let c = cs[i];
        let nx = if i + 1 < n { cs[i + 1] } else { ' ' };
        if c == '/' && nx == '/' {
            let k = i;
            while k < n && cs[k] != '\n' { k += 1; }
            blank(out, i, k);
            i = k;
        } else if c == '/' && nx == '*' {
            let k = i + 2;
            let depth = 1;
            while k < n && depth > 0 {
                if cs[k] == '/' && k + 1 < n && cs[k + 1] == '*' {
                    depth += 1;
                    k += 1;
                } else if cs[k] == '*' && k + 1 < n && cs[k + 1] == '/' {
                    depth -= 1;
                    k += 1;
                }
                k += 1;
            }
            blank(out, i, k);
            i = k;
        } else if c == '"' || ((c == 'f' || c == 'r' || c == 'b' || c == 'c') && (nx == '"' || (c == 'r' && nx == '#')) && (i == 0 || !is_ident(cs[i - 1]))) {
            let k = str_end(cs, i);
            blank(out, i, k);
            i = k;
        } else if c == '\'' {
            let k = char_end(cs, i);
            blank(out, i, k);
            i = if k > i { k } else { i + 1 };
        } else {
            i += 1;
        }
    }
    out
}

fn is_ident(c: char) -> bool { c.is_alphanumeric() || c == '_' }

fn blank(out: List<char>, a: usize, b: usize) {
    for k in a..b {
        if out[k] != '\n' { out[k] = ' '; }
    }
}

/// End of the char literal at `i`, or `i` if it is not one.
fn char_end(cs: List<char>, i: usize) -> usize {
    let n = cs.len();
    let k = i + 1;
    if k < n && cs[k] == '\\' { k += 2; } else { k += 1; }
    while k < n && k < i + 12 && cs[k] != '\'' && cs[k] != '\n' { k += 1; }
    if k < n && cs[k] == '\'' { k + 1 } else { i }
}

/// End of the string literal at `i` (`"`, `f"`, `r#"`, `f"""` ..).
fn str_end(cs: List<char>, i: usize) -> usize {
    let n = cs.len();
    let k = i;
    let fmt = cs[k] == 'f';
    let raw = cs[k] == 'r';
    if cs[k] != '"' { k += 1; }
    let hashes = 0usize;
    while k < n && cs[k] == '#' {
        hashes += 1;
        k += 1;
    }
    let triple = k + 2 < n && cs[k + 1] == '"' && cs[k + 2] == '"';
    k += if triple { 3 } else { 1 };
    while k < n {
        let c = cs[k];
        if c == '\\' && !raw {
            k += 2;
        } else if c == '"' && (!triple || (k + 2 < n && cs[k + 1] == '"' && cs[k + 2] == '"')) {
            let e = k + (if triple { 3 } else { 1 });
            let h = 0usize;
            while h < hashes && e < n && cs[e] == '#' {
                h += 1;
                e += 1;
            }
            if h == hashes { return e; }
            k += 1;
        } else if fmt && c == '{' && k + 1 < n && cs[k + 1] == '{' {
            k += 2;
        } else if fmt && c == '{' {
            k = hole_end(cs, k + 1);
        } else {
            k += 1;
        }
    }
    n
}

/// End of an f-string hole's code from `i` (after its `}`); strings in
/// it may reuse the quote.
fn hole_end(cs: List<char>, i: usize) -> usize {
    let n = cs.len();
    let k = i;
    let depth = 0;
    while k < n {
        let c = cs[k];
        if c == '"' || ((c == 'f' || c == 'r') && k + 1 < n && cs[k + 1] == '"' && !is_ident(cs[k - 1])) {
            k = str_end(cs, k);
            continue;
        }
        if c == '{' { depth += 1; }
        if c == '}' {
            if depth == 0 { return k + 1; }
            depth -= 1;
        }
        k += 1;
    }
    n
}

struct Scan {
    src: List<char>;
    m: List<char>;
}

fn text(cs: List<char>, a: usize, b: usize) -> str {
    let out = StrBuf::new();
    for k in a..b { out.push(cs[k]); }
    out.to_str()
}

/// Matching close of the bracket at `i`.
fn close_of(m: List<char>, i: usize) -> usize {
    let depth = 0;
    let k = i;
    while k < m.len() {
        let c = m[k];
        if c == '(' || c == '[' || c == '{' { depth += 1; }
        if c == ')' || c == ']' || c == '}' {
            depth -= 1;
            if depth == 0 { return k; }
        }
        k += 1;
    }
    m.len()
}

/// One declaration in a body: `[start, head_end)` is its header (up to
/// its `{`, `;` or `,`), `body` the `{..}` range if any.
struct Decl {
    start: usize;
    head_end: usize;
    body_start: usize;
    body_end: usize;
}

/// The declarations in `m[a..b]`, split at `;` / `,` / a closing `}`.
fn decls(m: List<char>, a: usize, b: usize) -> List<Decl> {
    let out: List<Decl> = List::new();
    let i = a;
    while i < b {
        while i < b && (m[i].is_whitespace() || m[i] == ';' || m[i] == ',') { i += 1; }
        if i >= b { break; }
        let start = i;
        let k = i;
        let bs = 0usize;
        let be = 0usize;
        let body = false;
        // `#[..]` attributes belong to the declaration.
        while k < b {
            let c = m[k];
            if c == '#' && k + 1 < b && m[k + 1] == '[' {
                k = close_of(m, k + 1) + 1;
                continue;
            }
            if c == '(' || c == '[' || (c == '{' && is_use(text(m, start, k))) {
                k = close_of(m, k) + 1;
                continue;
            }
            if c == '{' {
                bs = k;
                be = close_of(m, k);
                k = be + 1;
                // `= expr { .. }` initializers run on to their `;`.
                if !head_has(m, start, bs, '=') {
                    body = true;
                    break;
                }
                continue;
            }
            if c == ';' || c == ',' { break; }
            k += 1;
        }
        let head_end = if body { bs } else { k };
        if !body {
            bs = 0;
            be = 0;
        }
        out.push(Decl { start: start, head_end: head_end, body_start: bs, body_end: be });
        i = k + 1;
    }
    out
}

/// Whether a header so far is a `use` (its `{..}` is a list, not a body).
fn is_use(h: str) -> bool {
    let t = h.trim_start();
    if t.starts_with("pub(") {
        if let k: usize = t.find(")") { t = t[k + 1:].trim_start(); }
    } else if t.starts_with("pub ") {
        t = t[4:].trim_start();
    }
    t.starts_with("use ")
}

fn head_has(m: List<char>, a: usize, b: usize, c: char) -> bool {
    let depth = 0;
    for k in a..b {
        let x = m[k];
        if x == '(' || x == '[' || x == '<' { depth += 1; }
        if x == ')' || x == ']' || x == '>' { depth -= 1; }
        if x == c && depth == 0 && !(k + 1 < b && m[k + 1] == '=') && !(k > 0 && (m[k - 1] == '=' || m[k - 1] == '!' || m[k - 1] == '<' || m[k - 1] == '>')) { return true; }
    }
    false
}

/// The `///` lines right above `start` (through attribute lines).
fn doc_above(src: List<char>, start: usize) -> str {
    let lines: List<str> = List::new();
    let e = start;
    while e > 0 && src[e - 1] != '\n' { e -= 1; }
    while e > 0 {
        let b = e - 1;
        let a = b;
        while a > 0 && src[a - 1] != '\n' { a -= 1; }
        let l = text(src, a, b).trim();
        if l.starts_with("///") && !l.starts_with("////") {
            let t = l[3:];
            lines.push(if t.starts_with(" ") { t[1:] } else { t });
        } else if !l.starts_with("#[") {
            break;
        }
        e = a;
    }
    let out = StrBuf::new();
    let k = lines.len();
    while k > 0 {
        k -= 1;
        out.push_str(lines[k]);
        out.push('\n');
    }
    out.to_str()
}

/// Whether `d` carries `#[doc(hidden)]`: a compiler hook that is `pub`
/// only for lowered code.
fn hidden(s: Scan, d: Decl) -> bool { text(s.src, d.start, d.head_end).contains("#[doc(hidden)]") }

/// Words of a masked header after its attributes.
fn words(m: List<char>, a: usize, b: usize) -> List<str> {
    let out: List<str> = List::new();
    let k = a;
    while k < b {
        if m[k] == '#' && k + 1 < b && m[k + 1] == '[' {
            k = close_of(m, k + 1) + 1;
            continue;
        }
        if is_ident(m[k]) {
            let j = k;
            while j < b && is_ident(m[j]) { j += 1; }
            out.push(text(m, k, j));
            k = j;
        } else {
            if m[k] == '(' && out.len() > 0 && out[out.len() - 1] == "pub" {
                // `pub(pkg)`: keep the restriction as one word.
                let j = close_of(m, k);
                out[out.len() - 1] = "pub" + text(m, k, j + 1);
                k = j + 1;
                continue;
            }
            if !m[k].is_whitespace() { out.push(text(m, k, k + 1)); }
            k += 1;
        }
    }
    out
}

/// Header text from the original source, attributes dropped, lines
/// dedented, trailing `{` / `;` / `,` gone.
fn sig(s: Scan, d: Decl) -> str {
    let a = d.start;
    while a < d.head_end && s.m[a] == '#' {
        a = close_of(s.m, a + 1) + 1;
        while a < d.head_end && s.m[a].is_whitespace() { a += 1; }
    }
    let col = 0usize;
    let k = a;
    while k > 0 && s.src[k - 1] != '\n' {
        k -= 1;
        col += 1;
    }
    let out = StrBuf::new();
    let first = true;
    for l in text(s.src, a, d.head_end).trim_end().lines() {
        if !first { out.push('\n'); }
        let t = l;
        if !first {
            let cut = 0usize;
            for c in l.chars() {
                if c != ' ' || cut == col { break; }
                cut += 1;
            }
            t = l[cut:];
        }
        out.push_str(t);
        first = false;
    }
    out.to_str().trim_end()
}

fn kind_of(ws: List<str>) -> (str, str, bool) {
    // (kind, name, public)
    let public = ws.len() > 0 && (ws[0] == "pub" || ws[0] == "pub(shy)");
    let k = 0usize;
    while k < ws.len() && (ws[k].starts_with("pub") || ws[k] == "async" || ws[k] == "unsafe" || ws[k] == "const" && k + 1 < ws.len() && ws[k + 1] == "fn") { k += 1; }
    if k >= ws.len() { return ("", "", false); }
    let kind = ws[k];
    let name = if k + 1 < ws.len() { ws[k + 1] } else { "" };
    if kind == "extern" && k + 1 < ws.len() && ws[k + 1] == "fn" { return ("fn", if k + 2 < ws.len() { ws[k + 2] } else { "" }, public); }
    (kind, name, public)
}

/// Members of a struct / enum / trait / impl body.
fn members(s: Scan, d: Decl, kind: str, trait_impl: bool) -> List<Member> {
    let out: List<Member> = List::new();
    if d.body_start == 0 || trait_impl { return out; }
    for m in decls(s.m, d.body_start + 1, d.body_end) {
        let ws = words(s.m, m.start, m.head_end);
        if ws.len() == 0 { continue; }
        let (k, _name, public) = kind_of(ws);
        let keep = if kind == "enum" {
            true
        } else if kind == "trait" {
            k == "fn" || k == "type" || k == "const"
        } else if kind == "impl" {
            public && (k == "fn" || k == "const" || k == "type")
        } else {
            public
        };
        if keep && !hidden(s, m) { out.push(Member { name: member_name(ws), sig: sig(s, m), doc: doc_above(s.src, m.start) }); }
    }
    out
}

/// The declared name: the first word that is not a modifier.
fn member_name(ws: List<str>) -> str {
    for w in ws {
        if w.starts_with("pub") || w == "async" || w == "unsafe" || w == "const" || w == "fn" || w == "type" || w == "static" { continue; }
        return w;
    }
    ""
}

/// Type name of an `impl` header's words (after `for` if any).
fn impl_target(ws: List<str>) -> (str, bool) {
    let k = 0usize;
    let depth = 0;
    let for_at = 0usize;
    while k < ws.len() {
        if ws[k] == "<" { depth += 1; }
        if ws[k] == ">" { depth -= 1; }
        if ws[k] == "for" && depth == 0 { for_at = k; }
        k += 1;
    }
    // Skip `impl` and its `<..>` parameters.
    let i = if for_at > 0 { for_at + 1 } else { 1 };
    if for_at == 0 && i < ws.len() && ws[i] == "<" {
        let depth = 0;
        while i < ws.len() {
            if ws[i] == "<" { depth += 1; }
            if ws[i] == ">" {
                depth -= 1;
                if depth == 0 { i += 1; break; }
            }
            i += 1;
        }
    }
    (if i < ws.len() { ws[i] } else { "" }, for_at > 0)
}

/// Child module names declared `pub mod x;`.
fn scan(path: str, file: str, src_text: str) -> Module {
    let src: List<char> = List::new();
    for c in src_text.chars() { src.push(c); }
    let s = Scan { src: src, m: mask(src) };
    let md = Module { path: path, file: file, doc: lead_doc(src_text), items: List::new(), impls: List::new(), children: List::new() };
    let by_name: Dict<str, usize> = Dict::new();
    let impls: List<Decl> = List::new();
    for d in decls(s.m, 0, s.m.len()) {
        let ws = words(s.m, d.start, d.head_end);
        let (kind, name, public) = kind_of(ws);
        if kind == "impl" {
            impls.push(d);
            continue;
        }
        if !public || hidden(s, d) { continue; }
        if kind == "mod" {
            md.children.push(name);
            continue;
        }
        let k = if kind == "union" { "struct" } else { kind };
        if !(k == "fn" || k == "struct" || k == "enum" || k == "trait" || k == "type" || k == "const" || k == "static" || k == "use") { continue; }
        let it = Item { kind: k, name: if k == "use" { sig(s, d)["pub use ".len():] } else { name }, sig: sig(s, d), doc: doc_above(s.src, d.start), members: members(s, d, k, false), traits: List::new() };
        if k != "use" { by_name.insert(name, md.items.len()); }
        md.items.push(it);
    }
    for d in impls {
        let ws = words(s.m, d.start, d.head_end);
        let (ty, is_trait) = impl_target(ws);
        let target = if let i: usize = by_name.get(ty) {
            md.items[i]
        } else {
            let found: Item | none = none;
            for it in md.impls {
                if it.name == ty { found = it; }
            }
            if let it: Item = found {
                it
            } else {
                let it = Item { kind: "impl", name: ty, sig: "", doc: "", members: List::new(), traits: List::new() };
                md.impls.push(it);
                it
            }
        };
        if is_trait {
            target.traits.push(sig(s, d));
        } else {
            target.members.extend(members(s, d, "impl", false));
        }
    }
    // Foreign types with only trait impls are noise.
    let kept: List<Item> = List::new();
    for it in md.impls {
        if it.members.len() > 0 { kept.push(it); }
    }
    md.impls = kept;
    md
}

/// The file's leading comment block (`//` or `//!`).
fn lead_doc(src: str) -> str {
    let out = StrBuf::new();
    for l in src.lines() {
        let t = l.trim();
        if !t.starts_with("//") { break; }
        let body = if t.starts_with("//!") { t[3:] } else { t[2:] };
        out.push_str(if body.starts_with(" ") { body[1:] } else { body });
        out.push('\n');
    }
    out.to_str()
}

/// Every public module of the stone `krate` (its name as code spells it,
/// `rok_syntax`), DFS from `src/lib.rok`; `read` gives a file of the
/// tree. Empty when there is no `src/lib.rok`.
pub fn collect(krate: str, read: fn(str) -> (str | none)) -> List<Module> {
    let mods: List<Module> = List::new();
    walk(read, "src/lib.rok", krate, mods);
    mods
}

fn walk(read: fn(str) -> (str | none), file: str, path: str, mods: List<Module>) {
    let text = read(file) ?? { return; };
    let m = scan(path, file, text);
    mods.push(m);
    let dir = if file.ends_with("/lib.rok") { file[:file.len() - "lib.rok".len()] } else { file[:file.len() - ".rok".len()] + "/" };
    for c in m.children {
        // A module already read (a cycle through `#[path]`) is skipped.
        let seen = false;
        for q in mods {
            if q.path == path + "::" + c { seen = true; }
        }
        if seen { continue; }
        walk(read, dir + c + ".rok", path + "::" + c, mods);
    }
}

/// `src` with a link mapper for relative links in docs.
fn md(text: str, link: fn(str) -> str) -> str {
    if text.trim().is_empty() { return ""; }
    "<div class=\"md\">" + markdown::render_untrusted(text, markdown::Options { link: link, code: doc_code }).html + "</div>"
}

/// Fenced code in a doc comment is rok unless it says otherwise.
fn doc_code(lang: str, body: str) -> (str | none) {
    if lang == "" || lang == "rok" { return rok_syntax::highlight_rok(body); }
    if lang == "rokon" { return rok_syntax::highlight_rokon(body); }
    none
}

/// The first sentence of `doc`, as text.
pub fn summary(doc: str) -> str {
    let t = doc.trim().replace("\n", " ");
    if let k: usize = t.find(". ") { return t[:k + 1]; }
    t
}

/// The id prefix of a module: `""` for the crate root, `read.` for
/// `json::read`, `h2.engine.` for `http::h2::engine`.
fn prefix(m: Module) -> str {
    let k = m.path.find("::") ?? m.path.len();
    if k == m.path.len() { return ""; }
    m.path[k + 2:].replace("::", ".") + "."
}

fn mod_id(m: Module) -> str {
    let p = prefix(m);
    if p.is_empty() { "mod" } else { "mod." + p[:p.len() - 1] }
}

fn item_id(m: Module, it: Item) -> str {
    if it.kind == "impl" { return prefix(m) + "impl." + it.name; }
    prefix(m) + it.kind + "." + it.name
}

const KINDS: [(str, str); 8] = [
    ("use", "Re-exports"), ("struct", "Structs"), ("enum", "Enums"), ("trait", "Traits"),
    ("type", "Type aliases"), ("fn", "Functions"), ("const", "Constants"), ("static", "Statics"),
];

fn sig_html(sig: str) -> str {
    if sig.contains("\n") || !sig.contains("fn ") { return rok_syntax::highlight_rok(sig); }
    let fn_at = sig.find("fn ") ?? 0;
    let pieces: List<str> = List::new();
    let seps: List<str> = List::new();
    let cur = StrBuf::new();
    let sep = "";
    let depth = 0;
    let params = false;
    let done = false;
    let skip = false;
    let prev = ' ';
    let pos = 0usize;
    for c in sig.chars() {
        let at = pos;
        pos += c.len_utf8();
        if skip {
            skip = false;
            if c == ' ' { continue; }
        }
        if depth == 0 && done && c == ' ' && (sig[at:].starts_with(" -> ") || sig[at:].starts_with(" where ")) {
            pieces.push(cur.to_str());
            seps.push(sep);
            cur.clear();
            sep = " ";
            prev = c;
            continue;
        }
        cur.push(c);
        if c == '(' || c == '[' || c == '{' || c == '<' {
            depth += 1;
        } else if c == ')' || c == ']' || c == '}' || (c == '>' && prev != '-') {
            depth -= 1;
        }
        if c == '(' && depth == 1 && !params && !done && at > fn_at {
            params = true;
            pieces.push(cur.to_str());
            seps.push(sep);
            cur.clear();
            sep = "<wbr>";
        } else if c == ')' && depth == 0 && params {
            params = false;
            done = true;
        } else if c == ',' && depth == 1 && params {
            pieces.push(cur.to_str());
            seps.push(sep);
            cur.clear();
            sep = " ";
            skip = true;
        }
        prev = c;
    }
    if !cur.is_empty() {
        pieces.push(cur.to_str());
        seps.push(sep);
    }
    let out = StrBuf::new();
    for k in 0..pieces.len() {
        out.push_str(seps[k]);
        out.push_str(f"<span class=\"nw\">{rok_syntax::highlight_rok(pieces[k])}</span>");
    }
    out.to_str()
}

fn item_html(m: Module, it: Item, link: fn(str) -> str) -> str {
    let id = item_id(m, it);
    let title = if it.kind == "impl" { "impl " + it.name } else { it.name };
    let out = StrBuf::new();
    out.push_str(f"<section class=\"api-item\" id=\"{esc(id)}\"><h4><a href=\"#{esc(id)}\">{esc(title)}</a></h4>");
    if !it.sig.is_empty() { out.push_str(f"<pre class=\"sig\"><code>{sig_html(it.sig)}</code></pre>"); }
    out.push_str(md(it.doc, link));
    if it.members.len() > 0 {
        out.push_str("<ul class=\"members\">");
        for mb in it.members {
            out.push_str(f"<li id=\"{esc(id + "." + mb.name)}\"><pre><code>{sig_html(mb.sig)}</code></pre>{md(mb.doc, link)}</li>");
        }
        out.push_str("</ul>");
    }
    if it.traits.len() > 0 {
        out.push_str(f"<details class=\"impls\"><summary>{if it.traits.len() == 1 { "1 trait implementation" } else { f"{it.traits.len()} trait implementations" }}</summary><ul>");
        for t in it.traits { out.push_str(f"<li><code>{rok_syntax::highlight_rok(t)}</code></li>"); }
        out.push_str("</ul></details>");
    }
    out.push_str("</section>");
    out.to_str()
}

/// The API tab's body: every module, its items by kind.
pub fn body(mods: List<Module>, link: fn(str) -> str) -> str {
    let out = StrBuf::new();
    for m in mods {
        out.push_str(f"<section class=\"api-mod\" id=\"{mod_id(m)}\"><h2 class=\"api-path\"><code>{esc(m.path).replace("::", "::<wbr>")}</code></h2>");
        out.push_str(md(m.doc, link));
        let bare = true;
        for (kind, label) in KINDS {
            let its: List<Item> = List::new();
            for it in m.items {
                if it.kind == kind { its.push(it); }
            }
            if its.len() == 0 { continue; }
            bare = false;
            out.push_str(f"<h3 class=\"t-label\">{label}</h3>");
            if kind == "use" {
                out.push_str("<ul class=\"uses\">");
                for it in its { out.push_str(f"<li><code>{rok_syntax::highlight_rok(it.sig)}</code></li>"); }
                out.push_str("</ul>");
                continue;
            }
            for it in its { out.push_str(item_html(m, it, link)); }
        }
        if m.impls.len() > 0 {
            bare = false;
            out.push_str("<h3 class=\"t-label\">Implementations</h3>");
            for it in m.impls { out.push_str(item_html(m, it, link)); }
        }
        if bare && m.children.is_empty() { out.push_str("<p class=\"t-ui muted\">No public items.</p>"); }
        out.push_str("</section>");
    }
    out.to_str()
}

/// The Symbols list: modules and their items (re-exports left out, they
/// are listed where they are declared).
pub fn symbols(mods: List<Module>) -> str {
    let out = StrBuf::new();
    for m in mods {
        let items = StrBuf::new();
        for (kind, _label) in KINDS {
            if kind == "use" { continue; }
            for it in m.items {
                if it.kind == kind { items.push_str(f"<li><a href=\"#{esc(item_id(m, it))}\"><span class=\"kd\">{kind}</span>{esc(it.name)}</a></li>"); }
            }
        }
        for it in m.impls { items.push_str(f"<li><a href=\"#{esc(item_id(m, it))}\"><span class=\"kd\">impl</span>{esc(it.name)}</a></li>"); }
        if mods.len() > 1 { out.push_str(f"<a class=\"sm\" href=\"#{mod_id(m)}\"><code>{esc(m.path)}</code></a>"); }
        if !items.is_empty() { out.push_str(f"<ul>{items.to_str()}</ul>"); }
    }
    out.to_str()
}

/// Number of items listed (re-exports aside).
pub fn count(mods: List<Module>) -> usize {
    let n = 0usize;
    for m in mods {
        for it in m.items {
            if it.kind != "use" { n += 1; }
        }
        n += m.impls.len();
    }
    n
}

/// Whether `name` is an item declared, or re-exported, at the crate root.
fn at_root(mods: List<Module>, name: str) -> bool {
    if mods.is_empty() { return false; }
    for it in mods[0].items {
        if it.kind != "use" && it.name == name { return true; }
        if it.kind == "use" {
            for n in use_names(it.sig) {
                if n == name { return true; }
            }
        }
    }
    false
}

/// The names a `use` line brings in: `use a::b::{C, d as e};` -> `C`, `e`.
fn use_names(line: str) -> List<str> {
    let out: List<str> = List::new();
    let t = line.trim();
    t = t.strip_prefix("pub ") ?? t;
    t = (t.strip_prefix("use ") ?? t).trim_end();
    t = (t.strip_suffix(";") ?? t).trim();
    let list = t;
    if let k: usize = t.find("{") {
        list = t[k + 1:];
        list = list.strip_suffix("}") ?? list;
    } else if let k: usize = t.rfind("::") {
        list = t[k + 2:];
    }
    for part in list.split(",") {
        let p = part.trim();
        if let k: usize = p.find(" as ") { p = p[k + 4:].trim(); }
        if !p.is_empty() && p != "self" && p != "*" { out.push(p); }
    }
    out
}

fn is_type_kind(mods: List<Module>, name: str) -> bool {
    if mods.is_empty() { return false; }
    for it in mods[0].items {
        if it.name == name && (it.kind == "struct" || it.kind == "enum" || it.kind == "trait") { return true; }
    }
    // A re-exported name: a type when it is capitalized.
    at_root(mods, name) && !name.is_empty() && name[:1] != name[:1].to_lowercase()
}

/// The import line the install box shows, from the stone's own code: the
/// README's first `use <krate>::..;` line when every name in it is at the
/// crate root (cut to its first type when long), else the first type the
/// root module's doc names in backticks, else `use <krate>;`. Empty when
/// there is no API to check against.
pub fn import_line(krate: str, mods: List<Module>, readme: str) -> str {
    if mods.is_empty() { return ""; }
    for raw in readme.lines() {
        let l = raw.trim();
        if !l.starts_with("use " + krate + "::") || !l.ends_with(";") { continue; }
        let names = use_names(l);
        let ok = names.len() > 0;
        for n in names {
            if !at_root(mods, n) { ok = false; }
        }
        if !ok { continue; }
        if l.char_count() <= 36 { return l; }
        for n in names {
            if is_type_kind(mods, n) { return f"use {krate}::{n};"; }
        }
        return f"use {krate}::{names[0]};";
    }
    let doc = mods[0].doc;
    let parts: List<str> = List::new();
    for p in doc.split("`") { parts.push(p); }
    let k = 1usize;
    while k < parts.len() {
        if is_type_kind(mods, parts[k]) { return f"use {krate}::{parts[k]};"; }
        k += 2;
    }
    f"use {krate};"
}

#[test]
fn signature_pieces() {
    // The head, each parameter, the return type; `fn(T) -> bool` inside a
    // parameter stays whole.
    let h = sig_html("pub fn retain(self, keep: fn(T) -> bool) -> List<T>");
    assert(h.split("class=\"nw\"").count() == 5, h);
    assert(h.contains("<wbr><span") && !h.contains("( ") && !h.contains("<span class=\"nw\"> "), h);
    assert(sig_html("pub struct List<T>").split("class=\"nw\"").count() == 1, "not a fn");
}

#[test]
fn imports() {
    let lib = "// A thing. `parse` reads into a `Value`.\npub mod read;\nmod conv;\npub use read::{Event, Tokenizer};\n/// A value.\npub enum Value { A, B }\npub fn parse(s: str) -> Value { Value::A }\n";
    let files: Dict<str, str> = Dict::new();
    files.insert("src/lib.rok", lib);
    files.insert("src/read.rok", "/// Events.\npub struct Event { pub at: usize; }\npub struct Tokenizer {}\nimpl Tokenizer {\n    pub fn new() -> Tokenizer { Tokenizer {} }\n    fn hidden(self) {}\n}\n");
    let mods = collect("j", |p| files.get(p));
    assert(mods.len() == 2 && mods[1].path == "j::read", "modules");
    assert(mods[1].items.len() == 2 && mods[1].items[1].members.len() == 1, "members");
    assert(count(mods) == 4, "count");
    assert(import_line("j", mods, "") == "use j::Value;", "from the doc");
    assert(import_line("j", mods, "```rok\nuse j::{Event, parse};\n```") == "use j::{Event, parse};", "from the readme");
    assert(import_line("j", mods, "use j::{Nope};\n") == "use j::Value;", "unknown names skipped");
    assert(import_line("j", mods, "use j::{Event, Tokenizer, parse, Value};\n") == "use j::Event;", "long line cut");
    assert(import_line("j", List::new(), "") == "", "no api");
    assert(use_names("pub use a::b::{C, d as e};").len() == 2, "use names");
    assert(mods[0].items[0].kind == "use" && mods[0].items[0].sig == "pub use read::{Event, Tokenizer}", "brace use");
    assert(body(mods, |h| h).contains("id=\"read.struct.Tokenizer.new\""), "member ids");
}
