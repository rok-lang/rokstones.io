// Trusted publishing: a GitHub Actions job's OIDC token (a JWT GitHub
// signs with RS256) is traded for a short-lived publish token scoped to
// the stones whose trusted publishers match its claims.

use rok::std::fs;
use rok::std::rokon;
use rok::core::crypto::HashAlgorithm;
use rok::core::crypto::rsa::PublicKey;
use rok::core::encoding::base64;
use pkg::index;
use pkg::index::ApiError;
use pkg::json;
use pkg::secret;
use pkg::stones;

pub const GITHUB_ISSUER: str = "https://token.actions.githubusercontent.com";
/// Seconds a clock may be off.
pub const LEEWAY: i64 = 60i64;
/// Seconds an exchanged token lasts.
pub const TOKEN_SECS: i64 = 1800i64;
/// GitHub's tokens are about 1 KiB.
pub const MAX_JWT: usize = 8192;
/// Trusted publishers per stone.
pub const MAX_PER_STONE: usize = 16;

/// A workflow that may publish `stone`.
#[derive(Rokon)]
#[rokon(deny_unknown_fields)]
pub struct TrustedPublisher {
    pub stone: str;
    /// `owner/repo` on GitHub.
    pub repository: str;
    /// GitHub's numeric id of the repository's owner, so a deleted and
    /// re-registered owner name does not match; 0: not checked.
    pub owner_id: i64 = 0i64;
    /// File name under `.github/workflows/`.
    pub workflow: str;
    /// The GitHub environment the job must run in; "": any.
    pub environment: str = "";
    pub id: str = "";
    /// The login that added it; "" for the bootstrap file.
    pub added_by: str = "";
    pub added: i64 = 0i64;
    /// From ROKSTONES_TRUSTED: replaced at each start, removed only there.
    pub seeded: bool = false;
}

/// An exchanged token, stored as SHA-256.
#[derive(Rokon)]
pub struct TrustToken {
    pub hash: str;
    /// `index::key` of each stone it may publish and yank.
    pub stones: List<str>;
    /// `github:<workflow_ref>`, recorded as the publisher.
    pub publisher: str;
    pub repository: str;
    /// The OIDC token's `jti`: it is traded once.
    pub jti: str;
    pub created: i64;
    pub expires: i64;
    /// When the OIDC token expires: the record outlives it for the jti check.
    pub jwt_expires: i64;
}

/// Whether the record is still needed: a live token or a jti to refuse.
pub fn live(t: TrustToken, now: i64) -> bool { t.expires > now || t.jwt_expires + LEEWAY > now }

/// The token `t` (`rkt_` + 64 hex) while it lasts.
pub fn token_of(tokens: List<TrustToken>, t: str, now: i64) -> TrustToken | none {
    if !t.starts_with("rkt_") || t.len() != 68 { return none; }
    let h = secret::sha256_hex(t);
    let found: TrustToken | none = none;
    for k in tokens {
        if secret::same(k.hash, h) && k.expires > now { found = k; }
    }
    found
}

fn unauthorized(msg: str) -> ApiError { index::err(401, msg) }

/// A JWT split up; `signed` is `header.payload`, what the signature covers.
pub struct Jwt {
    pub header: Dict<str, str>;
    pub claims: Dict<str, str>;
    pub signed: str;
    pub sig: List<u8>;
}

fn b64(part: str, what: str) throws (ApiError) -> List<u8> {
    try base64::decode(part, base64::URL_SAFE_NO_PAD) catch _ { throw index::err(400, f"the OIDC token's {what} is not base64url"); }
}

/// A JSON object of scalars; a key given twice is refused, so no two
/// readers can see different claims.
fn object(b: List<u8>, what: str) throws (ApiError) -> Dict<str, str> {
    let text = try str::from_utf8(b) catch _ { throw index::err(400, f"the OIDC token's {what} is not UTF-8"); };
    if !text.trim().starts_with("{") { throw index::err(400, f"the OIDC token's {what} is not a JSON object"); }
    let seen: Set<str> = Set::new();
    for (k, _, _) in json::members(text) {
        if seen.contains(k) { throw index::err(400, f"the OIDC token's {what} has `{k}` twice"); }
        seen.insert(k);
    }
    json::fields(text)
}

/// `t` as a JWT; anything but RS256 is refused before a key is looked up.
pub fn parse_jwt(t: str) throws (ApiError) -> Jwt {
    if t.is_empty() || t.len() > MAX_JWT { throw index::err(400, "`jwt` is the OIDC token of a GitHub Actions job"); }
    let parts: List<str> = List::new();
    for p in t.split(".") { parts.push(p); }
    if parts.len() != 3 || parts[0].is_empty() || parts[1].is_empty() || parts[2].is_empty() {
        throw index::err(400, "`jwt` is not a JWT (header.payload.signature)");
    }
    let header = try object(try b64(parts[0], "header"), "header");
    let alg = header.get("alg") ?? "";
    if alg != "RS256" { throw unauthorized(f"the OIDC token is signed with `{alg}`; only RS256 is taken"); }
    let typ = header.get("typ") ?? "JWT";
    if typ != "JWT" { throw unauthorized(f"the OIDC token's type is `{typ}`, not JWT"); }
    if (header.get("kid") ?? "").is_empty() { throw unauthorized("the OIDC token names no key (`kid`)"); }
    let claims = try object(try b64(parts[1], "payload"), "payload");
    let sig = try b64(parts[2], "signature");
    Jwt { header: header, claims: claims, signed: parts[0] + "." + parts[1], sig: sig }
}

/// The RS256 signing key `kid` of a JWKS document.
pub fn find_key(jwks: str, kid: str) -> PublicKey | none {
    let keys = json::member(jwks, "keys") ?? { return none; };
    for k in json::items(keys) {
        let f = json::fields(k);
        if (f.get("kid") ?? "") != kid || (f.get("kty") ?? "") != "RSA" { continue; }
        if (f.get("alg") ?? "RS256") != "RS256" || (f.get("use") ?? "sig") != "sig" { continue; }
        let n = try base64::decode(f.get("n") ?? "", base64::URL_SAFE_NO_PAD) catch _ { continue; };
        let e = try base64::decode(f.get("e") ?? "", base64::URL_SAFE_NO_PAD) catch _ { continue; };
        return try PublicKey::new(n, e) catch _ { continue; };
    }
    none
}

fn time_claim(c: Dict<str, str>, k: str) throws (ApiError) -> i64 | none {
    let v = c.get(k) ?? { return none; };
    try v.parse::<i64>() catch _ { throw unauthorized(f"the OIDC token's `{k}` is not a time"); }
}

/// Check `j`'s signature with `key`, its issuer, audience and times.
pub fn check(j: Jwt, key: PublicKey, issuer: str, audience: str, now: i64) throws (ApiError) {
    if (j.header.get("alg") ?? "") != "RS256" { throw unauthorized("only RS256 is taken"); }
    if !key.verify_pkcs1v15(HashAlgorithm::Sha256, j.signed, j.sig) { throw unauthorized("the OIDC token's signature does not verify"); }
    let c = j.claims;
    if (c.get("iss") ?? "") != issuer { throw unauthorized(f"the OIDC token is not from {issuer}"); }
    let aud = c.get("aud") ?? "";
    if aud != audience { throw unauthorized(f"the OIDC token's audience is `{aud}`; request it with `audience={audience}`"); }
    let exp = (try time_claim(c, "exp")) ?? { throw unauthorized("the OIDC token has no `exp`"); };
    let iat = (try time_claim(c, "iat")) ?? { throw unauthorized("the OIDC token has no `iat`"); };
    if now > exp + LEEWAY { throw unauthorized("the OIDC token expired; request a new one"); }
    if iat > now + LEEWAY { throw unauthorized("the OIDC token was issued in the future; check the server's clock"); }
    if let nbf: i64 = try time_claim(c, "nbf") {
        if nbf > now + LEEWAY { throw unauthorized("the OIDC token is not valid yet"); }
    }
    for k in ["jti", "repository", "repository_owner_id", "workflow_ref"] {
        if (c.get(k) ?? "").is_empty() { throw unauthorized(f"the OIDC token has no `{k}`; it is not from a GitHub Actions job"); }
    }
}

/// Whether the claims of a checked token are publisher `p`'s: same
/// repository (and owner id), its workflow file (any ref), and its
/// environment when it names one.
pub fn matches(p: TrustedPublisher, c: Dict<str, str>) -> bool {
    let repo = c.get("repository") ?? "";
    if !is_repo(repo) || repo.to_lowercase() != p.repository.to_lowercase() { return false; }
    if p.owner_id != 0i64 && (c.get("repository_owner_id") ?? "") != f"{p.owner_id}" { return false; }
    // `owner/repo/.github/workflows/<file>@<ref>`: the caller's, not a
    // reusable workflow's (that is `job_workflow_ref`).
    let wref = c.get("workflow_ref") ?? "";
    if !wref.to_lowercase().starts_with(repo.to_lowercase() + "/") { return false; }
    if !wref[repo.len() + 1:].starts_with(".github/workflows/" + p.workflow + "@") { return false; }
    if !p.environment.is_empty() && (c.get("environment") ?? "").to_lowercase() != p.environment.to_lowercase() { return false; }
    true
}

fn is_gh_name(x: str, most: usize) -> bool {
    if x.is_empty() || x.len() > most || x == "." || x == ".." { return false; }
    for ch in x.chars() {
        if !(ch.is_ascii_alphanumeric() || ch == '-' || ch == '_' || ch == '.') { return false; }
    }
    true
}

/// `owner/repo`, in GitHub's name characters.
pub fn is_repo(s: str) -> bool {
    let (o, r) = s.split_once("/") ?? { return false; };
    is_gh_name(o, 39usize) && is_gh_name(r, 100usize)
}

/// A workflow file name: `publish.yml`.
pub fn is_workflow(s: str) -> bool {
    if !(s.ends_with(".yml") || s.ends_with(".yaml")) || s.starts_with(".") { return false; }
    is_gh_name(s, 255usize)
}

/// Refuse a publisher that could never match, or match too much.
pub fn check_publisher(p: TrustedPublisher) throws (ApiError) {
    if !stones::is_name(p.stone) { throw index::err(400, f"`{p.stone}` is not a stone name"); }
    if !is_repo(p.repository) { throw index::err(400, f"`{p.repository}` is not a GitHub repository; write `owner/repo`"); }
    if !is_workflow(p.workflow) { throw index::err(400, f"`{p.workflow}` is not a workflow file name; write the file's name under .github/workflows, e.g. `publish.yml`"); }
    if p.environment.len() > 255 || p.environment.trim() != p.environment { throw index::err(400, "an environment name is at most 255 bytes, with no spaces around it"); }
    for ch in p.environment.chars() {
        if (ch as u32) < 0x20u32 { throw index::err(400, "an environment name has no control characters"); }
    }
    if p.owner_id < 0i64 { throw index::err(400, "`owner_id` is GitHub's numeric id of the owner"); }
}

/// The same workflow for the same stone.
pub fn same(a: TrustedPublisher, b: TrustedPublisher) -> bool {
    index::key(a.stone) == index::key(b.stone) && a.repository.to_lowercase() == b.repository.to_lowercase() && a.workflow == b.workflow && a.environment.to_lowercase() == b.environment.to_lowercase()
}

/// The bootstrap file: `[TrustedPublisher { stone, repository, owner_id,
/// workflow, environment }, ..]`, each checked and marked `seeded`.
pub fn read_seeds(path: str) throws -> List<TrustedPublisher> {
    let list: List<TrustedPublisher> = try rokon::from_str(try fs::read_to_str(path));
    for i in 0..list.len() {
        try check_publisher(list[i]) catch e { throw index::err(0, f"{path}: {e.msg}"); };
        if !list[i].id.is_empty() || !list[i].added_by.is_empty() || list[i].added != 0i64 || list[i].seeded {
            throw index::err(0, f"{path}: give `stone`, `repository`, `owner_id`, `workflow` and `environment` only");
        }
        let p = list[i];
        list[i].id = "seed-" + secret::sha256_hex(f"{index::key(p.stone)}\n{p.repository.to_lowercase()}\n{p.workflow}\n{p.environment}")[:12];
        list[i].seeded = true;
    }
    list
}

/// `kept` without its seeded publishers, then `seeds`.
pub fn merge_seeds(kept: List<TrustedPublisher>, seeds: List<TrustedPublisher>) -> List<TrustedPublisher> {
    let out: List<TrustedPublisher> = List::new();
    for p in kept {
        if !p.seeded { out.push(p); }
    }
    for s in seeds { out.push(s); }
    out
}

/// The stones (`index::key`) whose publishers match checked claims `c`.
pub fn grant(all: List<TrustedPublisher>, c: Dict<str, str>) -> List<str> {
    let out: List<str> = List::new();
    for p in all {
        let k = index::key(p.stone);
        if matches(p, c) && !out.contains(k) { out.push(k); }
    }
    out
}

