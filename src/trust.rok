#[cfg(test)]
fn jwks_of(kid: str) -> str {
    let k = test_key().public_key();
    let n = base64::encode(k.modulus(), base64::URL_SAFE_NO_PAD);
    let e = base64::encode(k.exponent(), base64::URL_SAFE_NO_PAD);
    f"{{\"keys\":[{{\"kty\":\"RSA\",\"alg\":\"RS256\",\"use\":\"sig\",\"kid\":\"other\",\"n\":\"{n}\",\"e\":\"AQAB\",\"x\":[1]}},{{\"n\":\"{n}\",\"kty\":\"RSA\",\"kid\":\"{kid}\",\"e\":\"{e}\",\"use\":\"sig\",\"alg\":\"RS256\"}}]}}"
}

#[cfg(test)]
fn sign(header: str, claims: str) -> str {
    let h = base64::encode(header, base64::URL_SAFE_NO_PAD);
    let c = base64::encode(claims, base64::URL_SAFE_NO_PAD);
    let s = try! test_key().sign_pkcs1v15(HashAlgorithm::Sha256, h + "." + c);
    h + "." + c + "." + base64::encode(s, base64::URL_SAFE_NO_PAD)
}

#[cfg(test)]
const NOW: i64 = 1800000000i64;

#[cfg(test)]
fn claims(more: str) -> str {
    f"{{\"jti\":\"j-1\",\"sub\":\"repo:acme/geom:ref:refs/tags/v1.0.0\",\"aud\":\"rokstones.io\",\"ref\":\"refs/tags/v1.0.0\",\"repository\":\"acme/geom\",\"repository_owner\":\"acme\",\"repository_owner_id\":\"42\",\"workflow_ref\":\"acme/geom/.github/workflows/publish.yml@refs/tags/v1.0.0\",\"job_workflow_ref\":\"acme/ci/.github/workflows/rok.yml@refs/heads/main\",\"environment\":\"Release\",\"iss\":\"{GITHUB_ISSUER}\",\"nbf\":{NOW - 10i64},\"iat\":{NOW - 10i64},\"exp\":{NOW + 290i64}{more}}}"
}

#[cfg(test)]
const HEADER: str = "{\"typ\":\"JWT\",\"alg\":\"RS256\",\"x5t\":\"x\",\"kid\":\"k1\"}";

#[cfg(test)]
fn verdict(jwt: str, jwks: str, aud: str, now: i64) -> str {
    let j = try parse_jwt(jwt) catch e { return f"{e.status} {e.msg}"; };
    let key = find_key(jwks, j.header.get("kid") ?? "") ?? { return "no key"; };
    try check(j, key, GITHUB_ISSUER, aud, now) catch e { return f"{e.status} {e.msg}"; };
    "ok"
}

#[test]
fn oidc_tokens() {
    let jwks = jwks_of("k1");
    let good = sign(HEADER, claims(""));
    let v = verdict(good, jwks, "rokstones.io", NOW);
    expect(v == "ok", v);
    let j = try! parse_jwt(good);
    expect(j.claims["repository"] == "acme/geom" && j.claims["exp"] == f"{NOW + 290i64}", "claims");
    expect(find_key(jwks, "nope") is none && find_key("{}", "k1") is none && find_key("{\"keys\":[{\"kid\":\"k1\",\"kty\":\"RSA\",\"alg\":\"RS512\"}]}", "k1") is none, "keys");
    expect(verdict(good, jwks_of("k2"), "rokstones.io", NOW) == "no key", "unknown kid");
    v = verdict(good, jwks, "evil.example", NOW);
    expect(v == "401 the OIDC token's audience is `rokstones.io`; request it with `audience=evil.example`", v);
    expect(verdict(good, jwks, "rokstones.io", NOW + 290i64 + LEEWAY) == "ok", "leeway");
    expect(verdict(good, jwks, "rokstones.io", NOW + 291i64 + LEEWAY).contains("expired"), "expired");
    expect(verdict(good, jwks, "rokstones.io", NOW - 100i64).contains("future"), "iat");
    expect(verdict(sign(HEADER, claims(",\"nbf\":1900000000")), jwks, "rokstones.io", NOW).contains("twice"), "duplicate claim");
    let later = claims("").replace(f"\"nbf\":{NOW - 10i64}", f"\"nbf\":{NOW + 100i64}");
    expect(verdict(sign(HEADER, later), jwks, "rokstones.io", NOW).contains("not valid yet"), "nbf");
    let other = claims("").replace(GITHUB_ISSUER, "https://evil.example");
    expect(verdict(sign(HEADER, other), jwks, "rokstones.io", NOW).contains("is not from"), "issuer");
    expect(verdict(sign(HEADER, claims("").replace("\"jti\":\"j-1\",", "")), jwks, "rokstones.io", NOW).contains("no `jti`"), "jti");
    // A signature over other claims.
    let parts: List<str> = List::new();
    for p in good.split(".") { parts.push(p); }
    let forged = parts[0] + "." + base64::encode(claims("").replace("acme/geom", "acme/evil"), base64::URL_SAFE_NO_PAD) + "." + parts[2];
    expect(verdict(forged, jwks, "rokstones.io", NOW).contains("does not verify"), "forged");
    expect(verdict(parts[0] + "." + parts[1] + ".AAAA", jwks, "rokstones.io", NOW).contains("does not verify"), "short signature");
    // `none`, HMAC keyed with the public key, no kid, another type.
    for h in ["{\"alg\":\"none\",\"kid\":\"k1\"}", "{\"alg\":\"HS256\",\"kid\":\"k1\"}", "{\"alg\":\"RS256\"}", "{\"alg\":\"RS256\",\"kid\":\"k1\",\"typ\":\"at+jwt\"}"] {
        let t = base64::encode(h, base64::URL_SAFE_NO_PAD) + "." + parts[1] + "." + parts[2];
        expect(verdict(t, jwks, "rokstones.io", NOW).starts_with("401 "), h);
    }
    for t in ["", "a.b", "a.b.c.d", "a..c", parts[0] + "." + parts[1] + ".a+b/", "x".repeat(MAX_JWT + 1)] {
        expect(verdict(t, jwks, "rokstones.io", NOW).starts_with("400 "), t);
    }
}

#[cfg(test)]
fn publisher(stone: str, repo: str, workflow: str, env: str) -> TrustedPublisher {
    TrustedPublisher { stone: stone, repository: repo, owner_id: 42i64, workflow: workflow, environment: env }
}

#[test]
fn claim_matching() {
    let c = (try! parse_jwt(sign(HEADER, claims("")))).claims;
    expect(matches(publisher("geom", "acme/geom", "publish.yml", ""), c), "plain");
    expect(matches(publisher("geom", "ACME/Geom", "publish.yml", "release"), c), "case of repo and environment");
    expect(!matches(publisher("geom", "acme/geom", "rok.yml", ""), c), "reusable workflow is not the caller");
    expect(!matches(publisher("geom", "acme/geom", "Publish.yml", ""), c), "workflow file case");
    expect(!matches(publisher("geom", "acme/geom", "publish.y", ""), c), "workflow prefix");
    expect(!matches(publisher("geom", "acme/geo", "publish.yml", ""), c), "repo prefix");
    expect(!matches(publisher("geom", "acme/geom", "publish.yml", "staging"), c), "environment");
    let p = publisher("geom", "acme/geom", "publish.yml", "");
    p.owner_id = 43i64;
    expect(!matches(p, c), "owner id");
    p.owner_id = 0i64;
    expect(matches(p, c), "owner id unchecked");
    let all = [publisher("geom", "acme/geom", "publish.yml", ""), publisher("Ge-om", "acme/geom", "publish.yml", "release"), publisher("other", "acme/other", "publish.yml", "")];
    let g = grant(all, c);
    expect(g.len() == 2 && g.contains("geom") && g.contains("ge_om") && !g.contains("other"), f"{g:?}");
    expect(is_repo("rok-lang/rok-syntax") && !is_repo("rok-lang") && !is_repo("a/b/c") && !is_repo("a/..") && !is_repo("a b/c"), "repos");
    expect(is_workflow("publish.yml") && is_workflow("release.yaml") && !is_workflow("a/b.yml") && !is_workflow("publish") && !is_workflow(".yml"), "workflows");
    let status = 0;
    try check_publisher(publisher("geom", "acme/geom", "../x.yml", "")) catch e { status = e.status; };
    expect(status == 400, "bad workflow");
}

#[test]
fn tokens_and_seeds() {
    let t = "rkt_" + "cd".repeat(32);
    let rec = TrustToken { hash: secret::sha256_hex(t), stones: ["geom"], publisher: "github:x", repository: "acme/geom", jti: "j", created: NOW, expires: NOW + TOKEN_SECS, jwt_expires: NOW + 300i64 };
    expect(token_of([rec], t, NOW) is TrustToken && token_of([rec], t, NOW + TOKEN_SECS) is none, "expiry");
    expect(token_of([rec], "rks_" + "cd".repeat(32), NOW) is none && token_of([rec], t.replace("rkt_c", "rkt_d"), NOW) is none, "lookup");
    expect(live(rec, NOW + TOKEN_SECS - 1i64) && !live(rec, NOW + TOKEN_SECS + 1i64), "pruning");
    let dir = f"{tmp()}/rokstones-trust-{try! secret::random_hex(4)}";
    try! fs::create_dir_all(dir);
    let path = dir + "/trusted.rokon";
    try! fs::write(path, "[\n    TrustedPublisher { stone: \"json\", repository: \"rok-lang/json\", owner_id: 341800840, workflow: \"publish.yml\" },\n]\n");
    let seeds = try read_seeds(path) catch e { panic(f"{e}"); };
    expect(seeds.len() == 1 && seeds[0].seeded && seeds[0].id.starts_with("seed-") && seeds[0].owner_id == 341800840i64, "seed");
    let kept = merge_seeds([publisher("geom", "acme/geom", "publish.yml", ""), seeds[0]], seeds);
    expect(kept.len() == 2 && !kept[0].seeded && kept[1].seeded, "merge");
    try! fs::write(path, "[TrustedPublisher { stone: \"json\", repository: \"rok-lang/json\", workflow: \"publish.yml\", enviroment: \"x\" }]");
    expect((try read_seeds(path) catch _ { List::<TrustedPublisher>::new() }).is_empty(), "typo refused");
    try! fs::write(path, "[TrustedPublisher { stone: \"json\", repository: \"rok-lang/json\", workflow: \"publish.yml\", seeded: true }]");
    expect((try read_seeds(path) catch _ { List::<TrustedPublisher>::new() }).is_empty(), "the server's own fields refused");
    try! fs::remove_dir_all(dir);
}

#[cfg(test)]
fn tmp() -> str {
    let t = try rok::std::env::var("TMPDIR") catch _ { "/tmp" };
    t.strip_suffix("/") ?? t
}
