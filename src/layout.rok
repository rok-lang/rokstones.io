// Page chrome (header, search, footer) and the generated pages: landing,
// stone list, one page per stone.

use pkg::Site;
use markdown::{Options, esc};
use pkg::stones;
use pkg::stones::{Stone, Version};

/// `../` once per directory level of `out`, back to the site root.
pub fn root_of(out: str) -> str {
    let n = 0usize;
    for c in out.chars() {
        if c == '/' { n += 1; }
    }
    "../".repeat(n)
}

pub fn dir_of(p: str) -> str {
    if let k: usize = p.rfind("/") { return p[:k]; }
    ""
}

pub fn stone_out(name: str) -> str { f"stones/{name}.html" }

/// Markdown options: `link` for hrefs, ```rok / ```rokon highlighted.
pub fn md(link: fn(str) -> str) -> Options { Options { link: link, code: code_html } }

fn code_html(lang: str, body: str) -> (str | none) {
    if lang == "rok" { return rok_syntax::highlight_rok(body); }
    if lang == "rokon" { return rok_syntax::highlight_rokon(body); }
    none
}

fn short(rev: str) -> str { if rev.len() > 12 { rev[:12] } else { rev } }

fn search_box(big: bool) -> str {
    let cls = if big { "search big" } else { "search" };
    let id = if big { "results-big" } else { "results" };
    f"<div class=\"{cls}\" role=\"search\"><input class=\"q\" type=\"search\" placeholder=\"Search stones\" aria-label=\"Search stones\" aria-keyshortcuts=\"/\" autocomplete=\"off\" role=\"combobox\" aria-autocomplete=\"list\" aria-expanded=\"false\" aria-controls=\"{id}\"><kbd aria-hidden=\"true\">/</kbd><ul id=\"{id}\" class=\"results\" role=\"listbox\" aria-label=\"Search results\" hidden></ul><p class=\"sr-only\" role=\"status\"></p></div>"
}

/// `s` cut to `n` characters, with an ellipsis if it was longer.
fn clip(s: str, n: usize) -> str {
    let out = StrBuf::new();
    let k = 0usize;
    for c in s.chars() {
        if k == n {
            out.push_str("...");
            break;
        }
        out.push(c);
        k += 1;
    }
    out.to_str()
}

/// `<head>` from the charset to the icons. `root` leads to the icons and
/// stylesheet, `url` is the canonical address, `img` the og:image.
fn head(site: Site, root: str, full: str, desc: str, url: str, img: str, extra: str) -> str {
    f"<meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
<title>{esc(full)}</title>
<script>try{{const t=localStorage.getItem(\"theme\");if(t)document.documentElement.dataset.theme=t}}catch(e){{}}</script>
<meta name=\"description\" content=\"{desc}\">
<link rel=\"canonical\" href=\"{esc(url)}\">
{extra}<meta property=\"og:type\" content=\"website\">
<meta property=\"og:site_name\" content=\"{esc(site.title)}\">
<meta property=\"og:title\" content=\"{esc(full)}\">
<meta property=\"og:description\" content=\"{desc}\">
<meta property=\"og:url\" content=\"{esc(url)}\">
<meta property=\"og:image\" content=\"{esc(img)}\">
<meta name=\"twitter:card\" content=\"summary_large_image\">
<meta name=\"theme-color\" content=\"#fcfbfd\" media=\"(prefers-color-scheme: light)\">
<meta name=\"theme-color\" content=\"#15151b\" media=\"(prefers-color-scheme: dark)\">
<link rel=\"stylesheet\" href=\"{root}style.css\">
<link rel=\"icon\" href=\"{root}logo.svg\" type=\"image/svg+xml\">
<link rel=\"icon\" href=\"{root}favicon.ico\" sizes=\"32x32\">
<link rel=\"apple-touch-icon\" href=\"{root}apple-touch-icon.png\">
"
}

