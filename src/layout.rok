// Page chrome (header, search, footer) and the generated pages: landing,
// stone list, publishing guide, one page per stone plus its tab pages.

use pkg::Site;
use markdown::{Options, esc};
use pkg::stones;
use pkg::stones::{Stone, Version};

/// The address of output file `out`, root-relative and canonical: no
/// `.html`, a directory index is the directory, no trailing slash
/// (`stones/index.html` -> `/stones`, `index.html` -> `/`).
pub fn url(out: str) -> str {
    let p = out.strip_suffix(".html") ?? out;
    if p == "index" { return "/"; }
    "/" + (p.strip_suffix("/index") ?? p)
}

pub fn dir_of(p: str) -> str {
    if let k: usize = p.rfind("/") { return p[:k]; }
    ""
}

pub fn stone_out(name: str) -> str { f"stones/{name}.html" }

/// A stone's tab page: `versions`, `dependencies` or `dependents`.
pub fn tab_out(name: str, tab: str) -> str { f"stones/{name}/{tab}.html" }

/// Markdown options: `link` for hrefs, ```rok / ```rokon highlighted.
pub fn md(link: fn(str) -> str) -> Options { Options { link: link, code: code_html } }

fn code_html(lang: str, body: str) -> (str | none) {
    if lang == "rok" { return rok_syntax::highlight_rok(body); }
    if lang == "rokon" { return rok_syntax::highlight_rokon(body); }
    none
}

fn short(rev: str) -> str { if rev.len() > 8 { rev[:8] } else { rev } }

fn plural(n: usize, one: str, many: str) -> str { if n == 1 { f"1 {one}" } else { f"{n} {many}" } }

/// `s` cut to `n` characters, with an ellipsis if it was longer.
fn clip(s: str, n: usize) -> str {
    let out = StrBuf::new();
    let k = 0usize;
    for c in s.chars() {
        if k == n {
            out.push_str("...");
            break;
        }
        out.push(c);
        k += 1;
    }
    out.to_str()
}

// Stone glyph: the rokstones pebble, turned, stretched and tinted by a hash
// of the name. Same hash as the design canvas and og/render.mjs.

fn name_hash(name: str) -> i64 {
    let h = 7i64;
    for c in name.chars() { h = (h * 31i64 + ((c as u32) as i64)) % 9973i64; }
    h
}

const PEBBLE: str = "M30 4C47 3 61 15 61 31C62 48 49 61 33 61C15 61 3 50 3 33C2 16 14 5 30 4Z";

/// `<svg>` of the glyph, `px` square; the colour comes from `--h` in CSS.
fn glyph(name: str, px: i32, cls: str) -> str {
    let h = name_hash(name);
    let k = 80i64 + h % 25i64;
    let sx = if k >= 100i64 { f"1.0{k - 100i64}" } else { f"0.{k}" };
    f"<svg class=\"{cls}\" width=\"{px}\" height=\"{px}\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" style=\"--h:{h % 360i64}\"><path d=\"{PEBBLE}\" transform=\"rotate({h % 70i64 - 35i64} 32 32) translate(32 32) scale({sx} 1) translate(-32 -32)\"/></svg>"
}

pub fn hue(name: str) -> i64 { name_hash(name) % 360i64 }

fn icon_search() -> str {
    "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M20 20l-4-4\"/></svg>"
}

fn search_box() -> str {
    f"<form class=\"search\" role=\"search\" action=\"/stones\">{icon_search()}<input class=\"q\" name=\"q\" type=\"search\" placeholder=\"Search stones\" aria-label=\"Search stones\" aria-keyshortcuts=\"/ Control+K Meta+K\" autocomplete=\"off\" spellcheck=\"false\" role=\"combobox\" aria-autocomplete=\"list\" aria-expanded=\"false\" aria-controls=\"results\"><kbd class=\"kbd\" aria-hidden=\"true\">/</kbd><ul id=\"results\" class=\"results\" role=\"listbox\" aria-label=\"Search results\" hidden></ul><p class=\"sr-only\" role=\"status\"></p></form>"
}

/// `<head>` from the charset to the icons. `url` is the canonical address,
/// `img` the og:image (versioned by main.rok's og_version) and `alt`
/// its text.
fn head(site: Site, full: str, desc: str, url: str, img: str, alt: str) -> str {
    let img = esc(img);
    let alt = esc(alt);
    f"<meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
<title>{esc(full)}</title>
<script src=\"/theme.js\"></script>
<meta name=\"description\" content=\"{desc}\">
<link rel=\"canonical\" href=\"{esc(url)}\">
<meta property=\"og:type\" content=\"website\">
<meta property=\"og:site_name\" content=\"{esc(site.title)}\">
<meta property=\"og:title\" content=\"{esc(full)}\">
<meta property=\"og:description\" content=\"{desc}\">
<meta property=\"og:url\" content=\"{esc(url)}\">
<meta property=\"og:image\" content=\"{img}\">
<meta property=\"og:image:type\" content=\"image/png\">
<meta property=\"og:image:width\" content=\"{site.og_w}\">
<meta property=\"og:image:height\" content=\"{site.og_h}\">
<meta property=\"og:image:alt\" content=\"{alt}\">
<meta name=\"twitter:card\" content=\"summary_large_image\">
<meta name=\"twitter:image\" content=\"{img}\">
<meta name=\"twitter:image:alt\" content=\"{alt}\">
<meta name=\"theme-color\" content=\"#fbfbfc\" media=\"(prefers-color-scheme: light)\">
<meta name=\"theme-color\" content=\"#090a0d\" media=\"(prefers-color-scheme: dark)\">
<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">
<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>
<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&amp;family=Geist+Mono:wght@400;500&amp;display=swap\">
<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css\">
<link rel=\"stylesheet\" href=\"/rok.css\">
<link rel=\"stylesheet\" href=\"/style.css\">
<link rel=\"icon\" href=\"/logo.svg\" type=\"image/svg+xml\">
<link rel=\"icon\" href=\"/favicon.ico\" sizes=\"32x32\">
<link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\">
"
}

/// The footer shared by the Rok sites: link columns, then a bar with the
/// sites and the theme switch.
fn footer(site: Site) -> str {
    let d = esc(site.docs) + "/latest";
    let col = |title: str, links: str| f"<nav aria-label=\"{title}\"><h2 class=\"t-label\">{title}</h2>{links}</nav>";
    let learn = col("Learn", f"<a href=\"{d}/learn\">Guide</a><a href=\"{d}/examples\">Examples</a><a href=\"{esc(site.playground)}\">Playground</a>");
    let refs = col("Reference", f"<a href=\"{d}/spec\">Language spec</a><a href=\"{d}/std\">Std library</a><a href=\"{d}/learn/16-tools\">Tools</a>");
    let eco = col("Ecosystem", f"<a href=\"/\">Stones</a><a href=\"/publishing\">Publishing</a><a href=\"{esc(site.index_repo)}\">Index repository</a><a href=\"https://github.com/rok-lang/rok.vscode\">VS Code</a><a href=\"https://github.com/rok-lang/rok.vim\">Vim</a>");
    let proj = col("Project", f"<a href=\"{esc(site.home)}/roadmap\">Roadmap</a><a href=\"https://github.com/rok-lang\">GitHub</a><a href=\"https://github.com/rok-lang/rok/security/policy\">Security</a><a href=\"https://github.com/rok-lang/rok/blob/main/CODE_OF_CONDUCT.md\">Code of conduct</a>");
    f"<footer class=\"ftr\">
<div class=\"frame cols\">
<div class=\"about\"><a class=\"brand\" href=\"{esc(site.home)}\"><img src=\"/rok.svg\" alt=\"\" width=\"24\" height=\"24\">Rok</a><p>A compiled language that tells you what to write.</p><span class=\"social\"><a href=\"https://github.com/rok-lang\" aria-label=\"GitHub\" title=\"GitHub\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12\"/></svg></a><a href=\"https://x.com/roklangorg\" aria-label=\"X\" title=\"X\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z\"/></svg></a><a href=\"https://bsky.app/profile/rok-lang.org\" aria-label=\"Bluesky\" title=\"Bluesky\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.