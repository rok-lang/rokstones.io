// Page chrome (header, search, footer) and the generated pages: landing,
// stone list, one page per stone.

use pkg::Site;
use markdown::{Options, esc};
use pkg::stones;
use pkg::stones::{Stone, Version};

/// `../` once per directory level of `out`, back to the site root.
pub fn root_of(out: str) -> str {
    let n = 0usize;
    for c in out.chars() {
        if c == '/' { n += 1; }
    }
    "../".repeat(n)
}

pub fn dir_of(p: str) -> str {
    if let k: usize = p.rfind("/") { return p[:k]; }
    ""
}

pub fn stone_out(name: str) -> str { f"stones/{name}.html" }

/// Markdown options: `link` for hrefs, ```rok / ```rokon highlighted.
pub fn md(link: fn(str) -> str) -> Options { Options { link: link, code: code_html } }

fn code_html(lang: str, body: str) -> (str | none) {
    if lang == "rok" { return rok_syntax::highlight_rok(body); }
    if lang == "rokon" { return rok_syntax::highlight_rokon(body); }
    none
}

fn short(rev: str) -> str { if rev.len() > 12 { rev[:12] } else { rev } }

fn search_box(big: bool) -> str {
    let cls = if big { "search big" } else { "search" };
    let id = if big { "results-big" } else { "results" };
    f"<div class=\"{cls}\" role=\"search\"><input class=\"q\" type=\"search\" placeholder=\"Search stones\" aria-label=\"Search stones\" aria-keyshortcuts=\"/\" autocomplete=\"off\" role=\"combobox\" aria-autocomplete=\"list\" aria-expanded=\"false\" aria-controls=\"{id}\"><kbd aria-hidden=\"true\">/</kbd><ul id=\"{id}\" class=\"results\" role=\"listbox\" aria-label=\"Search results\" hidden></ul><p class=\"sr-only\" role=\"status\"></p></div>"
}

/// `s` cut to `n` characters, with an ellipsis if it was longer.
fn clip(s: str, n: usize) -> str {
    let out = StrBuf::new();
    let k = 0usize;
    for c in s.chars() {
        if k == n {
            out.push_str("...");
            break;
        }
        out.push(c);
        k += 1;
    }
    out.to_str()
}

/// `page` with a `<meta name="description">` of its own.
pub fn page(site: Site, out: str, title: str, body: str) -> str { page_desc(site, out, title, "", body) }

pub fn page_desc(site: Site, out: str, title: str, about: str, body: str) -> str {
    // The 404 page is served for any missing path, so its links start at `/`.
    let root = if out == "404.html" { "/" } else { root_of(out) };
    let home = out == "index.html";
    let all = if out == "stones/index.html" { " aria-current=\"page\"" } else { "" };
    let full = if home { site.title + " - " + site.tagline } else { title + " - " + site.title };
    let search = if home { "" } else { search_box(false) };
    let kind = if home { "home" } else if out == "stones/index.html" { "list" } else { "doc" };
    let desc = esc(if about.is_empty() { site.description } else { clip(about, 160) });
    let url = if home { site.base_url + "/" } else { site.base_url + "/" + out };
    // Heading permalinks are aria-hidden, so keep them out of the tab order too.
    let body = body.replace("class=\"anchor\" href=", "class=\"anchor\" tabindex=\"-1\" href=");
    f"<!doctype html>
<html lang=\"en\">
<head>
<meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
<title>{esc(full)}</title>
<script>try{{const t=localStorage.getItem(\"theme\");if(t)document.documentElement.dataset.theme=t}}catch(e){{}}</script>
<meta name=\"description\" content=\"{desc}\">
<link rel=\"canonical\" href=\"{esc(url)}\">
<meta property=\"og:type\" content=\"website\">
<meta property=\"og:site_name\" content=\"{esc(site.title)}\">
<meta property=\"og:title\" content=\"{esc(full)}\">
<meta property=\"og:description\" content=\"{desc}\">
<meta property=\"og:url\" content=\"{esc(url)}\">
<meta property=\"og:image\" content=\"{esc(site.base_url)}/og.png\">
<meta name=\"twitter:card\" content=\"summary_large_image\">
<meta name=\"theme-color\" content=\"#fcfbfd\" media=\"(prefers-color-scheme: light)\">
<meta name=\"theme-color\" content=\"#15151b\" media=\"(prefers-color-scheme: dark)\">
<link rel=\"stylesheet\" href=\"{root}style.css\">
<link rel=\"icon\" href=\"{root}logo.svg\" type=\"image/svg+xml\">
<link rel=\"icon\" href=\"{root}favicon.ico\" sizes=\"32x32\">
<link rel=\"apple-touch-icon\" href=\"{root}apple-touch-icon.png\">
</head>
<body class=\"{kind}\" data-root=\"{root}\">
<a class=\"skip\" href=\"#content\">Skip to content</a>
<header class=\"top\">
<a class=\"brand\" href=\"{root}index.html\"><img src=\"{root}logo.svg\" alt=\"\" width=\"28\" height=\"28\"><span>{esc(site.title)}</span></a>
<nav class=\"main-nav\" aria-label=\"Main\"><a href=\"{root}stones/index.html\"{all}>All stones</a><a href=\"{root}index.html#using-stones\">Using stones</a><a href=\"{root}index.html#publishing\">Publishing</a><a href=\"{esc(site.docs)}\">Docs ↗</a></nav>
{search}
<button class=\"theme\" type=\"button\" aria-label=\"Theme\">◐</button>
</header>
<main id=\"content\">
{body}
</main>
<footer>
<ul class=\"links\"><li><a href=\"{esc(site.home)}\">rok-lang.org</a></li><li><a href=\"{esc(site.docs)}\">rok docs</a></li><li><a href=\"{esc(site.index_repo)}\">Registry index</a></li></ul>
<p class=\"by\">Made and maintained by <a href=\"https://daminstudio.com\">DaminStudio</a></p>
<p class=\"made\">built with a static site generator written in rok</p>
</footer>
<script src=\"{root}search.js\" defer></script>
</body>
</html>
"
}

// ---- pieces ----

/// `<li>` of a stone in a list, linking from `out`.
fn stone_item(out: str, s: Stone, note: str) -> str {
    let href = esc(root_of(out) + stone_out(s.name));
    let desc = if s.desc.is_empty() { "" } else { f"<span class=\"desc\">{esc(s.desc)}</span>" };
    let side = if note.is_empty() { "" } else { f"<span class=\"note\">{esc(note)}</span>" };
    let lic = if s.latest.license.is_empty() { "" } else { f" <span class=\"license\">{esc(s.latest.license)}</span>" };
    // A fully yanked stone: struck through and tagged.
    let gone = if s.latest.yanked { " <span class=\"tag yanked\">yanked</span>" } else { "" };
    let cls = if s.latest.yanked { " class=\"yanked\"" } else { "" };
    f"<li{cls}><a href=\"{href}\"><span class=\"name\">{esc(s.name)}</span> <span class=\"ver\">{esc(s.latest.vers)}</span>{gone}{lic}{side}{desc}</a></li>"
}

fn stone_list(out: str, xs: List<Stone>, notes: List<str>, empty: str) -> str {
    if xs.len() == 0 { return f"<p class=\"empty\">{esc(empty)}</p>"; }
    let b = StrBuf::new();
    b.push_str("<ul class=\"stones\">");
    for k in 0..xs.len() { b.push_str(stone_item(out, xs[k], notes[k])); }
    b.push_str("</ul>");
    b.to_str()
}

fn code(lang: str, body: str) -> str {
    let c = if lang == "rokon" { rok_syntax::highlight_rokon(body) } else { esc(body) };
    f"<pre class=\"{lang}\"><code class=\"language-{lang}\">{c}</code></pre>"
}

// ---- landing ----

pub fn landing(site: Site, all: List<Stone>, guide: str) -> str {
    let out = "index.html";
    let vers = 0usize;
    for s in all { vers += s.versions.len(); }

    let recent: List<Stone> = List::new();
    for s in all { recent.push(s); }
    recent.sort_by(|a: Stone, b: Stone| if a.time != b.time { b.time.cmp(a.time) } else { a.name.cmp(b.name) });
    let popular: List<Stone> = List::new();
    for s in all {
        if s.rdeps.len() > 0 { popular.push(s); }
    }
    popular.sort_by(|a: Stone, b: Stone| if a.rdeps.len() != b.rdeps.len() { b.rdeps.len().cmp(a.rdeps.len()) } else { a.name.cmp(b.name) });

    let rs: List<Stone> = List::new();
    let rn: List<str> = List::new();
    for s in recent {
        if rs.len() == 8 { break; }
        rs.push(s);
        rn.push(s.date);
    }
    let ps: List<Stone> = List::new();
    let pn: List<str> = List::new();
    for s in popular {
        if ps.len() == 8 { break; }
        ps.push(s);
        pn.push(if s.rdeps.len() == 1 { "1 dependent" } else { f"{s.rdeps.len()} dependents" });
    }

    f"<div class=\"hero\">
<img src=\"logo.svg\" alt=\"\" width=\"80\" height=\"80\">
<h1>{esc(site.title)}</h1>
<p class=\"lead\">{esc(site.tagline)}</p>
{search_box(true)}
<p class=\"stats\"><strong>{all.len()}</strong> stones · <strong>{vers}</strong> versions · <a href=\"stones/index.html\">View all</a></p>
</div>
<ol class=\"how\" aria-label=\"How a stone gets into your code\">
<li><code><b>$</b> rok add json</code><span>writes the dependency to <code>rok.rokon</code></span></li>
<li><code><b>$</b> rok build</code><span>fetches the newest matching version and pins it in <code>rok.lock</code></span></li>
<li><code>use json::Value;</code><span>and it is in your code</span></li>
</ol>
<div class=\"columns\">
<section><h2>Recently published</h2>{stone_list(out, rs, rn, "No stones published yet.")}</section>
<section><h2>Most depended on</h2>{stone_list(out, ps, pn, "No stone has dependents yet.")}</section>
</div>
<article>
{guide}</article>
"
}

// ---- stone list ----

pub fn all_stones(all: List<Stone>) -> str {
    let out = "stones/index.html";
    let notes: List<str> = List::new();
    for s in all { notes.push(s.date); }
    let n = if all.len() == 1 { "1 stone" } else { f"{all.len()} stones" };
    f"<article><h1>All stones</h1><p>{n}, sorted by name.</p></article>
{stone_list(out, all, notes, "No stones published yet.")}
"
}

// ---- stone page ----

fn dep_list(out: str, have: Set<str>, deps: List<stones::Req>, kind: str) -> str {
    let b = StrBuf::new();
    for d in deps {
        if d.kind != kind { continue; }
        let name = if !d.registry.is_empty() {
            f"{esc(d.name)} <small title=\"{esc(d.registry)}\">other index</small>"
        } else if have.contains(d.name) {
            f"<a href=\"{esc(root_of(out) + stone_out(d.name))}\">{esc(d.name)}</a>"
        } else {
            f"{esc(d.name)} <small>not in index</small>"
        };
        b.push_str(f"<li>{name} <code>{esc(d.req)}</code></li>");
    }
    if b.is_empty() { "" } else { f"<ul class=\"deps\">{b.to_str()}</ul>" }
}

fn version_row(v: Version, latest: str) -> str {
    let tags = StrBuf::new();
    if v.vers == latest && !v.yanked { tags.push_str(" <span class=\"tag latest\">latest</span>"); }
    if v.yanked { tags.push_str(" <span class=\"tag yanked\">yanked</span>"); }
    if stones::is_pre(v.vers) { tags.push_str(" <span class=\"tag\">pre-release</span>"); }
    let tree = stones::tree_link(v.url, v.rev);
    let commit = if tree.is_empty() {
        f"<code>{short(v.rev)}</code>"
    } else {
        f"<a href=\"{esc(tree)}\"><code>{short(v.rev)}</code></a>"
    };
    let cls = if v.yanked { " class=\"yanked\"" } else { "" };
    f"<li{cls}><span class=\"v\">{esc(v.vers)}</span>{tags.to_str()}<span class=\"commit\">{commit}</span></li>"
}

pub fn stone_page(site: Site, s: Stone, have: Set<str>) -> str {
    let out = stone_out(s.name);
    let l = s.latest;
    let req = stones::caret(l.vers);
    let manifest = f"deps: {{\n    \"{s.name}\": Dep::version(\"{req}\"),\n}},";
    let add = if stones::is_pre(l.vers) { f"rok add {s.name}@{req}" } else { f"rok add {s.name}" };

    let install = if l.yanked {
        "<section><h2>Install</h2><p class=\"empty\">Not installable: every version is yanked.</p></section>"
    } else {
        f"<section><h2>Install</h2>{code("sh", add)}<p>Or in <code>rok.rokon</code>:</p>{code("rokon", manifest)}</section>"
    };
    let notice = if l.yanked { "<p class=\"warn\">All versions are yanked. New projects will not resolve this stone.</p>" } else { "" };
    let readme = if s.readme.is_empty() {
        "<div class=\"empty-box\"><p>No README to show.</p><p>The build was offline, or the repository has none.</p></div>"
    } else {
        s.readme
    };

    let deps = dep_list(out, have, l.deps, "normal");
    let dev = dep_list(out, have, l.deps, "dev");
    let rd = StrBuf::new();
    for r in s.rdeps {
        rd.push_str(f"<li><a href=\"{esc(root_of(out) + stone_out(r.name))}\">{esc(r.name)}</a> <code>{esc(r.req)}</code></li>");
    }
    let fs = StrBuf::new();
    for (name, on) in l.features {
        let what = StrBuf::new();
        for e in on { what.push_str(f" <code>{esc(e)}</code>"); }
        fs.push_str(f"<li><code>{esc(name)}</code>{what.to_str()}</li>");
    }
    let features = if fs.is_empty() { "" } else { f"<section><h2>Features</h2><ul class=\"deps\">{fs.to_str()}</ul></section>" };
    let rdeps = if rd.is_empty() { "<p class=\"empty\">None</p>" } else { f"<ul class=\"deps\">{rd.to_str()}</ul>" };

    let vs = StrBuf::new();
    let sorted: List<Version> = List::new();
    for v in s.versions { sorted.push(v); }
    sorted.sort_by(|a: Version, b: Version| stones::cmp_vers(b.vers, a.vers));
    for v in sorted { vs.push_str(version_row(v, l.vers)); }

    let tree = stones::tree_link(l.url, l.rev);
    let repo = stones::web_of(l.url);
    let shown = esc(l.url.replace("https://", "")).replace("/", "/<wbr>");
    let repo_html = if repo.is_empty() { f"<code class=\"url\">{shown}</code>" } else { f"<a class=\"url\" href=\"{esc(repo)}\">{shown}</a>" };
    let commit = if tree.is_empty() { f"<code>{short(l.rev)}</code>" } else { f"<a href=\"{esc(tree)}\"><code>{short(l.rev)}</code></a>" };
    let date = if s.date.is_empty() { "" } else { f"<dt>Last published</dt><dd>{esc(s.date)}</dd>" };
    let lic = if l.license.is_empty() { "" } else { f"<dt>License</dt><dd>{esc(l.license)}</dd>" };
    let about = if s.desc.is_empty() { "" } else { f"<p class=\"about\">{esc(s.desc)}</p>\n" };

    f"<div class=\"stone-head\">
<h1>{esc(s.name)} <span class=\"ver{if l.yanked { " yanked" } else { "" }}\">{esc(l.vers)}</span></h1>
{about}{notice}</div>
<div class=\"stone\">
<aside class=\"meta\" aria-label=\"Stone details\">
{install}
<section><h2>Source</h2><dl><dt>Repository</dt><dd>{repo_html}</dd><dt>Commit</dt><dd>{commit}</dd><dt>Tree hash</dt><dd><code title=\"{esc(l.cksum)}\">{short(l.cksum)}</code></dd>{lic}{date}<dt>Index file</dt><dd><a href=\"{esc(site.index_repo)}/blob/main/{esc(s.file)}\"><code>{esc(s.file)}</code></a></dd></dl></section>
<section><h2>Dependencies ({l.vers})</h2>{if deps.is_empty() { "<p class=\"empty\">None</p>" } else { deps }}{if dev.is_empty() { "" } else { f"<h3>Dev dependencies</h3>{dev}" }}</section>
{features}<section><h2>Dependents</h2>{rdeps}</section>
<section><h2>Versions ({s.versions.len()})</h2><ul class=\"versions\">{vs.to_str()}</ul></section>
</aside>
<article class=\"readme\">
{readme}</article>
</div>
"
}

/// Body of `404.html`, a compiler-style error; search.js fills in the path.
pub fn not_found() -> str {
    "<div class=\"lost\">
<img src=\"/logo.svg\" alt=\"\" width=\"88\" height=\"88\">
<h1>Stone not found</h1>
<p>Nothing is published at this address.</p>
<pre class=\"err\"><code><span class=\"e\">error[E404]</span>: no such stone or page
 <span class=\"g\">--&gt;</span> <span id=\"lost-path\">this address</span>
  <span class=\"g\">|</span>
  <span class=\"g\">=</span> <span class=\"h\">help</span>: search above with <kbd>/</kbd>, or browse <a href=\"/stones/index.html\">all stones</a></code></pre>
<p><a href=\"/index.html\">← Home</a></p>
</div>
"
}
