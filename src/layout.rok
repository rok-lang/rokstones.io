{learn}{refs}{eco}{proj}
</div>
<div class=\"frame bar\">
<nav aria-label=\"Rok sites\"><a href=\"{esc(site.home)}\">Home</a><a href=\"{esc(site.docs)}/latest\">Docs</a><a href=\"/\">Stones</a><a href=\"{esc(site.playground)}\">Playground</a></nav>
<span>Made by <a href=\"https://daminstudio.com\">DaminStudio</a></span>
<div class=\"seg\" role=\"group\" aria-label=\"Theme\"><button type=\"button\" data-theme=\"system\" aria-pressed=\"true\">System</button><button type=\"button\" data-theme=\"light\" aria-pressed=\"false\">Light</button><button type=\"button\" data-theme=\"dark\" aria-pressed=\"false\">Dark</button></div>
</div>
</footer>
"
}

/// `page` with a `<meta name="description">` of its own.
pub fn page(site: Site, out: str, title: str, body: str) -> str { page_desc(site, out, title, "", body) }

/// `img` and `alt` are a stone's card; the home card by default. Every
/// card is drawn at the home card's size (og/render.mjs).
pub fn page_desc(site: Site, out: str, title: str, about: str, body: str, img: str = "", alt: str = "") -> str {
    let home = out == "index.html";
    let full = if home { site.title + " - " + site.tagline } else { title + " - " + site.title };
    let desc = esc(if about.is_empty() { site.description } else { clip(about, 160) });
    let canon = site.base_url + url(out);
    // Heading permalinks are aria-hidden, so keep them out of the tab order too.
    let body = body.replace("class=\"anchor\" href=", "class=\"anchor\" tabindex=\"-1\" href=");
    let (ogimg, ogalt) = if img.is_empty() { (site.base_url + "/og.png" + (if site.og.is_empty() { "" } else { "?v=" + site.og }), f"{site.title}: {site.tagline}") } else { (img, alt) };
    let cur = |on: bool| if on { " aria-current=\"page\"" } else { "" };
    let browse = cur(out == "stones/index.html" || out.starts_with("stones/"));
    let publish = cur(out == "publishing.html");
    // The server's own pages (`me`, `me/..`) belong to a logged-in account.
    let mine = out == "me" || out.starts_with("me/");
    let account = if mine {
        f"<a class=\"btn-2 btn-sm login\" href=\"/me\" aria-current=\"page\">Account</a>"
    } else {
        f"<a class=\"btn-2 btn-sm login\" href=\"/login\">Log in<span class=\"wide\"> with GitHub</span></a>"
    };
    f"<!doctype html>
<html lang=\"en\" class=\"rk lt\">
<head>
{head(site, full, desc, canon, ogimg, ogalt)}</head>
<body>
<a class=\"skip\" href=\"#content\">Skip to content</a>
<header class=\"hdr\">
<div class=\"frame in\">
<a class=\"brand\" href=\"/\"><img src=\"/logo.svg\" alt=\"\" width=\"26\" height=\"26\">rokstones</a>
{search_box()}
<nav id=\"nav\" class=\"nav\" aria-label=\"Registry\"><a href=\"/stones\"{browse}>Browse</a><a href=\"/publishing\"{publish}>Publishing</a><a href=\"{esc(site.docs)}/latest\">Docs</a></nav>
<button class=\"ib theme\" type=\"button\" aria-label=\"Dark theme\" title=\"Switch to dark theme\" aria-pressed=\"false\"><svg class=\"moon\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z\"/></svg><svg class=\"sun\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg></button>
{account}
<button class=\"ib menu\" type=\"button\" aria-label=\"Menu\" aria-expanded=\"false\" aria-controls=\"nav\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></svg></button>
</div>
</header>
<main id=\"content\">
{body}
</main>
{footer(site)}<script src=\"/search.js\" defer></script>
</body>
</html>
"
}

/// `<li>` of a stone in a list; `note` replaces the date.
fn stone_row(s: Stone, note: str) -> str {
    let href = esc(url(stone_out(s.name)));
    let desc = if s.desc.is_empty() { "<span class=\"desc none\">No description</span>" } else { f"<span class=\"desc\">{esc(s.desc)}</span>" };
    let gone = if s.latest.yanked { " <span class=\"tag\">yanked</span>" } else { "" };
    let when = if !note.is_empty() { f"<span class=\"when\">{note}</span>" } else if s.date.is_empty() { "<span class=\"when\"></span>" } else { f"<time class=\"when\" datetime=\"{esc(s.date)}\">{esc(s.date)}</time>" };
    f"<li{if s.latest.yanked { " class=\"yanked\"" } else { "" }}><a class=\"st\" href=\"{href}\">{glyph(s.name, 34, "gl")}<span class=\"main\"><span class=\"nl\"><b class=\"nm\">{esc(s.name)}</b>{gone}</span>{desc}</span><span class=\"ver\">{esc(s.latest.vers)}</span>{when}</a></li>"
}

fn stone_rows(xs: List<Stone>, empty: str, dependents: bool = false) -> str {
    if xs.len() == 0 { return f"<p class=\"empty\">{esc(empty)}</p>"; }
    let b = StrBuf::new();
    b.push_str("<ul class=\"rows\">");
    for s in xs { b.push_str(stone_row(s, if dependents { plural(s.rdeps.len(), "dependent", "dependents") } else { "" })); }
    b.push_str("</ul>");
    b.to_str()
}

pub fn landing(site: Site, all: List<Stone>) -> str {
    let vers = 0usize;
    for s in all { vers += s.versions.len(); }

    let recent: List<Stone> = List::new();
    for s in all { recent.push(s); }
    recent.sort_by(|a: Stone, b: Stone| if a.time != b.time { b.time.cmp(a.time) } else { a.name.cmp(b.name) });
    let rs: List<Stone> = List::new();
    for s in recent {
        if rs.len() == 10 { break; }
        rs.push(s);
    }
    let popular: List<Stone> = List::new();
    for s in all {
        if s.rdeps.len() > 0 { popular.push(s); }
    }
    popular.sort_by(|a: Stone, b: Stone| if a.rdeps.len() != b.rdeps.len() { b.rdeps.len().cmp(a.rdeps.len()) } else { a.name.cmp(b.name) });
    let ps: List<Stone> = List::new();
    for s in popular {
        if ps.len() == 5 { break; }
        ps.push(s);
    }
    // Only once some stone has dependents: an empty list says nothing.
    let most = if ps.is_empty() {
        ""
    } else {
        f"<section aria-labelledby=\"most\" class=\"block\"><div class=\"list-head\"><h2 class=\"t-h3\" id=\"most\">Most depended on</h2></div>{stone_rows(ps, "", true)}</section>"
    };
    let example = if all.is_empty() { "json" } else { recent[0].name };
    for s in all {
        if s.name == "json" { example = "json"; }
    }

    f"<section class=\"frame intro\">
<h1 class=\"t-h1\">Packages for Rok</h1>
<p class=\"t-lead\">Stones are Rok packages. Add one with <code class=\"ic\">rok add {esc(example)}</code>; the build pins its exact version in <code class=\"ic\">rok.lock</code>.</p>
</section>
<div class=\"frame home\">
<div>
<section aria-labelledby=\"recent\" class=\"block\"><div class=\"list-head\"><h2 class=\"t-h3\" id=\"recent\">Recently updated</h2><span class=\"t-small\">{plural(all.len(), "stone", "stones")}, {plural(vers, "version", "versions")} · <a href=\"/stones\">see all</a></span></div>
{stone_rows(rs, "No stones published yet.")}</section>
{most}</div>
<aside class=\"side-notes\">
<section><h2 class=\"t-h3\">Using a stone</h2>
<p>Run this in a package directory, then <code class=\"ic\">use {esc(example)}::..;</code> in your code.</p>
<pre class=\"cmd\"><code>rok add {esc(example)}</code></pre></section>
<section><h2 class=\"t-h3\">Publishing</h2>
<p>A version is one line in the <a href=\"{esc(site.index_repo)}\">index repository</a> naming a commit of the stone's own repository. Until publishing opens to everyone, send that line as a pull request.</p>
<p><a href=\"/publishing#publishing\">How publishing works</a></p></section>
</aside>
</div>
"
}

pub fn all_stones(all: List<Stone>) -> str {
    f"<div class=\"frame list-page\">
<div class=\"page-head\"><h1 class=\"t-h2\" id=\"list-title\">All stones</h1><p class=\"t-small\" id=\"list-note\">{plural(all.len(), "stone", "stones")}, sorted by name.</p></div>
{stone_rows(all, "No stones published yet.")}<p class=\"empty\" id=\"no-match\" hidden>Try a shorter word, or <a href=\"/stones\">browse all stones</a>.</p>
</div>
"
}

/// Body of `publishing.html`: the guide in `pages/publishing.md`.
pub fn guide(doc: markdown::Doc) -> str {
    let toc = StrBuf::new();
    for h in doc.headings {
        if h.level == 2 { toc.push_str(f"<a href=\"#{esc(h.id)}\">{esc(h.text)}</a>"); }
    }
    f"<div class=\"frame doc\">
<article class=\"prose md\">
<h1 class=\"t-h1\">Using and publishing stones</h1>
{doc.html}</article>
<nav class=\"toc\" aria-label=\"On this page\"><h2 class=\"t-label\">On this page</h2>{toc.to_str()}</nav>
</div>
"
}

// Stone pages. Each stone has a readme page and three tab pages that share
// its heading and side panel.

fn sorted_versions(s: Stone) -> List<Version> {
    let xs: List<Version> = List::new();
    for v in s.versions { xs.push(v); }
    xs.sort_by(|a: Version, b: Version| stones::cmp_vers(b.vers, a.vers));
    xs
}

fn count_deps(v: Version, kind: str) -> usize {
    let n = 0usize;
    for d in v.deps {
        if d.kind == kind { n += 1; }
    }
    n
}

fn commit_link(v: Version) -> str {
    let tree = stones::tree_link(v.url, v.rev);
    if tree.is_empty() { f"<code title=\"{esc(v.rev)}\">{short(v.rev)}</code>" } else { f"<a href=\"{esc(tree)}\" title=\"{esc(v.rev)}\"><code>{short(v.rev)}</code></a>" }
}

fn stone_head(s: Stone, tab: str) -> str {
    let l = s.latest;
    let facts = StrBuf::new();
    if !s.date.is_empty() { facts.push_str(f"<li>updated <time datetime=\"{esc(s.date)}\">{esc(s.date)}</time></li>"); }
    if !l.license.is_empty() { facts.push_str(f"<li>{esc(l.license)}</li>"); }
    facts.push_str(f"<li>{plural(count_deps(l, "normal"), "dependency", "dependencies")}</li>");
    if l.yanked { facts.push_str("<li class=\"bad\">yanked</li>"); }
    let about = if s.desc.is_empty() { "" } else { f"<p class=\"t-lead\">{esc(s.desc)}</p>" };
    let notice = if l.yanked {
        "<p class=\"callout help\"><span class=\"lab\">yanked</span><span>Every version is yanked. Projects that pinned one in <code class=\"ic\">rok.lock</code> keep building; new ones will not resolve this stone.</span></p>"
    } else { "" };
    // Narrow screens: install right under the title (the side panel ends up last).
    let inst = if l.yanked { "" } else { f"<section class=\"inst-head\" aria-label=\"Install\">{install_box(s, "h")}</section>\n" };
    let tabs = StrBuf::new();
    let t = |key: str, label: str, href: str, n: str| {
        let ct = if n.is_empty() { "" } else { f"<span class=\"ct\">{n}</span>" };
        if key == tab {
            f"<a href=\"{esc(href)}\" class=\"on\" aria-current=\"page\">{label}{ct}</a>"
        } else {
            f"<a href=\"{esc(href)}\">{label}{ct}</a>"
        }
    };
    tabs.push_str(t("readme", "Readme", url(stone_out(s.name)), ""));
    tabs.push_str(t("versions", "Versions", url(tab_out(s.name, "versions")), f"{s.versions.len()}"));
    tabs.push_str(t("dependencies", "Dependencies", url(tab_out(s.name, "dependencies")), f"{l.deps.len()}"));
    tabs.push_str(t("dependents", "Dependents", url(tab_out(s.name, "dependents")), f"{s.rdeps.len()}"));
    let tree = stones::tree_link(l.url, l.rev);
    if !tree.is_empty() { tabs.push_str(f"<a href=\"{esc(tree)}\">Source <span aria-hidden=\"true\">↗</span></a>"); }
    f"<div class=\"frame stone-head\">
<nav class=\"crumbs\" aria-label=\"Breadcrumb\"><a href=\"/stones\">stones</a> / {if tab == "readme" { esc(s.name) } else { f"<a href=\"{esc(url(stone_out(s.name)))}\">{esc(s.name)}</a> / {tab}" }}</nav>
<div class=\"title\"><span class=\"gl-box\" style=\"--h:{hue(s.name)}\">{glyph(s.name, 44, "gl")}</span><div class=\"what\"><div class=\"name-line\"><h1>{esc(s.name)}</h1><span class=\"ver{if l.yanked { " gone" } else { "" }}\">{esc(l.vers)}</span></div>{about}</div></div>
<ul class=\"facts\">{facts.to_str()}</ul>
{notice}{inst}<div class=\"tabs-line\"><nav class=\"tabs\" aria-label=\"Stone sections\">{tabs.to_str()}</nav></div>
</div>
"
}

/// The install box: `rok add` and the `rok.rokon` line it writes, as tabs.
/// `id` keeps the ids apart: the box is in the heading on narrow screens
/// and in the side panel on wide ones.
fn install_box(s: Stone, id: str) -> str {
    let l = s.latest;
    if l.yanked { return "<p class=\"t-ui muted\">Not installable: every version is yanked.</p>"; }
    let req = stones::add_req(l.vers);
    let add = if stones::is_pre(l.vers) { f"rok add {s.name}@{req}" } else { f"rok add {s.name}" };
    // As `rok add` writes it into a multi-line rok.rokon.
    let manifest = f"deps: {{\n    \"{s.name}\": Dep::version(\"{req}\"),\n}},";
    f"<div class=\"inst\">
<div class=\"itabs\" role=\"tablist\" aria-label=\"Install with\"><button type=\"button\" role=\"tab\" id=\"{id}t-add\" aria-controls=\"{id}p-add\" aria-selected=\"true\">rok add</button><button type=\"button\" role=\"tab\" id=\"{id}t-rokon\" aria-controls=\"{id}p-rokon\" aria-selected=\"false\" tabindex=\"-1\">rok.rokon</button></div>
<div class=\"ipanel on\" role=\"tabpanel\" id=\"{id}p-add\" aria-labelledby=\"{id}t-add\"><pre class=\"sh\"><code><span class=\"p\" aria-hidden=\"true\">$ </span>{esc(add)}</code></pre></div>
<div class=\"ipanel\" role=\"tabpanel\" id=\"{id}p-rokon\" aria-labelledby=\"{id}t-rokon\"><pre><code class=\"language-rokon\">{rok_syntax::highlight_rokon(manifest)}</code></pre></div>
</div>"
}

fn side(site: Site, s: Stone) -> str {
    let l = s.latest;
    let repo = stones::web_of(l.url);
    let shown = esc(l.url.replace("https://", "").strip_suffix(".git") ?? l.url.replace("https://", "")).replace("/", "/<wbr>");
    let repo_html = if repo.is_empty() { f"<code>{shown}</code>" } else { f"<a href=\"{esc(repo)}\">{shown}</a>" };
    let lic = if l.license.is_empty() { "" } else { f"<dt>License</dt><dd>{esc(l.license)}</dd>" };
    let vs = sorted_versions(s);
    let vb = StrBuf::new();
    let k = 0usize;
    for v in vs {
        if k == 5 { break; }
        k += 1;
        let mark = if v.vers == l.vers && !v.yanked { "<span class=\"dot\" title=\"latest\"></span>" } else { "<span class=\"dot off\"></span>" };
        let tag = if v.yanked { "<span class=\"tag\">yanked</span>" } else if stones::is_pre(v.vers) { "<span class=\"tag\">pre-release</span>" } else { "" };
        vb.push_str(f"<li{if v.yanked { " class=\"yanked\"" } else { "" }}>{mark}<span class=\"v\">{esc(v.vers)}</span>{tag}<span class=\"c\">{commit_link(v)}</span></li>");
    }
    let more = if s.versions.len() > 5 { f"<a href=\"{esc(url(tab_out(s.name, "versions")))}\" class=\"t-ui\">All {s.versions.len()} versions</a>" } else { "" };
    f"<aside class=\"meta\" aria-label=\"Stone details\">
<section class=\"inst-side\"><h2 class=\"t-label\">Install</h2>{install_box(s, "i")}</section>
<dl class=\"kv\"><dt>Repository</dt><dd>{repo_html}</dd><dt>Commit</dt><dd class=\"mono\">{commit_link(l)}</dd><dt>Tree hash</dt><dd class=\"mono\"><code title=\"{esc(l.cksum)}\">{short(l.cksum)}</code></dd>{lic}<dt>Index file</dt><dd class=\"mono\"><a href=\"{esc(site.index_repo)}/blob/main/{esc(s.file)}\">{esc(s.file)}</a></dd></dl>
<section class=\"vers\"><h2 class=\"t-label\">Versions</h2><ul>{vb.to_str()}</ul>{more}</section>
</aside>
"
}

fn stone_frame(site: Site, s: Stone, tab: str, main: str) -> str {
    f"{stone_head(s, tab)}<div class=\"frame stone-body\">
<div class=\"main\">
{main}</div>
{side(site, s)}</div>
"
}

pub fn stone_page(site: Site, s: Stone) -> str {
    let l = s.latest;
    let readme = if s.readme.is_empty() {
        "<p class=\"empty\">No README to show: the repository has none, or the build was offline.</p>"
    } else {
        let src = stones::web_of(l.url).replace("https://", "");
        let from = if src.is_empty() { "" } else { f"<p class=\"from t-small\">Readme from {esc(src)} at <span class=\"mono\">{short(l.rev)}</span>.</p>" };
        f"<article class=\"prose md readme\">\n{s.readme}</article>\n{from}"
    };
    stone_frame(site, s, "readme", readme)
}

pub fn versions_page(site: Site, s: Stone) -> str {
    let b = StrBuf::new();
    for v in sorted_versions(s) {
        let tags = StrBuf::new();
        if v.vers == s.latest.vers && !v.yanked { tags.push_str("<span class=\"tag acc\">latest</span>"); }
        if v.yanked { tags.push_str("<span class=\"tag\">yanked</span>"); }
        if stones::is_pre(v.vers) { tags.push_str("<span class=\"tag\">pre-release</span>"); }
        b.push_str(f"<tr{if v.yanked { " class=\"yanked\"" } else { "" }}><td><span class=\"v\">{esc(v.vers)}</span>{tags.to_str()}</td><td class=\"mono\">{commit_link(v)}</td><td class=\"mono\"><code title=\"{esc(v.cksum)}\">{short(v.cksum)}</code></td><td>{if v.license.is_empty() { "<span class=\"muted\">none</span>" } else { esc(v.license) }}</td></tr>");
    }
    let body = f"<h2 class=\"t-h3\">{plural(s.versions.len(), "version", "versions")}</h2>
<p class=\"t-ui muted\">Newest first. A yanked version stays in the index for the projects that pinned it; new resolves skip it.</p>
<div class=\"table-wrap\"><table class=\"tbl\"><thead><tr><th scope=\"col\">Version</th><th scope=\"col\">Commit</th><th scope=\"col\">Tree hash</th><th scope=\"col\">License</th></tr></thead><tbody>{b.to_str()}</tbody></table></div>
";
    stone_frame(site, s, "versions", body)
}

fn dep_rows(have: Set<str>, deps: List<stones::Req>, kind: str) -> str {
    let b = StrBuf::new();
    for d in deps {
        if d.kind != kind { continue; }
        let name = if !d.registry.is_empty() {
            f"<span class=\"mono\">{esc(d.name)}</span> <span class=\"tag\" title=\"{esc(d.registry)}\">other index</span>"
        } else if have.contains(d.name) {
            f"<a class=\"mono\" href=\"{esc(url(stone_out(d.name)))}\">{esc(d.name)}</a>"
        } else {
            f"<span class=\"mono\">{esc(d.name)}</span> <span class=\"tag\">not in index</span>"
        };
        b.push_str(f"<tr><td>{name}</td><td class=\"mono\">{esc(d.req)}</td></tr>");
    }
    b.to_str()
}

fn dep_table(rows: str) -> str {
    f"<div class=\"table-wrap\"><table class=\"tbl\"><thead><tr><th scope=\"col\">Stone</th><th scope=\"col\">Requirement</th></tr></thead><tbody>{rows}</tbody></table></div>"
}

pub fn deps_page(site: Site, s: Stone, have: Set<str>) -> str {
    let l = s.latest;
    let deps = dep_rows(have, l.deps, "normal");
    let dev = dep_rows(have, l.deps, "dev");
    let b = StrBuf::new();
    b.push_str(f"<h2 class=\"t-h3\">Dependencies of {esc(l.vers)}</h2>\n");
    b.push_str(if deps.is_empty() { "<p class=\"empty\">None. This stone builds on the standard library alone.</p>\n" } else { dep_table(deps) });
    if !dev.is_empty() { b.push_str(f"<h2 class=\"t-h3\">Dev dependencies</h2>\n<p class=\"t-ui muted\">Used by its tests and examples only.</p>\n{dep_table(dev)}"); }
    if !l.features.is_empty() {
        let fs = StrBuf::new();
        for (name, on) in l.features {
            let what = StrBuf::new();
            for e in on { what.push_str(f"<code class=\"ic\">{esc(e)}</code> "); }
            fs.push_str(f"<tr><td class=\"mono\">{esc(name)}</td><td>{if what.is_empty() { "<span class=\"muted\">nothing else</span>" } else { what.to_str() }}</td></tr>");
        }
        b.push_str(f"<h2 class=\"t-h3\">Features</h2>\n<div class=\"table-wrap\"><table class=\"tbl\"><thead><tr><th scope=\"col\">Feature</th><th scope=\"col\">Turns on</th></tr></thead><tbody>{fs.to_str()}</tbody></table></div>\n");
    }
    stone_frame(site, s, "dependencies", b.to_str())
}

pub fn dependents_page(site: Site, s: Stone) -> str {
    let b = StrBuf::new();
    b.push_str(f"<h2 class=\"t-h3\">Stones that depend on {esc(s.name)}</h2>\n<p class=\"t-ui muted\">Counted from the latest version of every stone in the index.</p>\n");
    if s.rdeps.is_empty() {
        b.push_str("<p class=\"empty\">None yet.</p>\n");
    } else {
        let rows = StrBuf::new();
        for d in s.rdeps {
            rows.push_str(f"<tr><td><a class=\"mono\" href=\"{esc(url(stone_out(d.name)))}\">{esc(d.name)}</a></td><td class=\"mono\">{esc(d.req)}</td></tr>");
        }
        b.push_str(dep_table(rows.to_str()));
    }
    stone_frame(site, s, "dependents", b.to_str())
}

/// Body of `404.html`, a compiler-style error; search.js fills in the path.
pub fn not_found() -> str {
    "<div class=\"frame lost\">
<h1 class=\"t-h1\">Page not found</h1>
<p class=\"t-lead\">Nothing is published at this address.</p>
<pre class=\"term\"><code><span class=\"e\">error[E404]</span>: no such stone or page
 <span class=\"g\">--&gt;</span> <span id=\"lost-path\">this address</span>
  <span class=\"g\">|</span>
  <span class=\"g\">=</span> <span class=\"h\">help</span>: search with <kbd class=\"kbd\">/</kbd>, or browse <a href=\"/stones\">all stones</a></code></pre>
<p><a href=\"/\">Back to rokstones</a></p>
</div>
"
}
