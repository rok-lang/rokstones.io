// rokstones.io: renders the registry index (rokstones.io-index) into a
// static site, then checks every internal link.
//
//   rok run                      build into `out` (site.rokon)
//   rok run -- check             build, and exit 1 on a broken link or a bad index line
//   rok run -- --demo            use fixtures/index and fixtures/readme
//   rok run -- --offline         no `git fetch` for READMEs (cache only)
//   rok run -- --index <dir>     another index checkout
//   rok run -- serve             serve the site and the API (see server.rok)

mod layout;
mod stones;
mod secret;
mod index;
mod server;
mod apidoc;

use rok::std::env;
use rok::std::fs;
use rok::std::rokon;
use rok::core::crypto::HashAlgorithm;
use rok::core::crypto::sha2::Digest;
use rok::core::task::time::Instant;
use layout::dir_of;
use web::kit;
use web::url;

#[derive(Rokon)]
pub struct Site {
    pub title: str;
    pub tagline: str;
    /// `<meta name="description">` of pages without one of their own.
    pub description: str = "";
    /// Checkout of the index, relative to this file.
    pub index: str = "../rokstones.io-index";
    /// The index's web page (links to stone files, pull requests).
    pub index_repo: str;
    pub base_url: str = "https://rokstones.io";
    pub docs: str = "https://docs.rok-lang.org";
    /// The language's home site.
    pub home: str = "https://rok-lang.org";
    pub playground: str = "https://playground.rok-lang.org";
    /// The toolchain release the footer names (`rok 0.1.4`).
    pub release: str = "";
    /// README cache (git objects and extracted READMEs).
    pub cache: str = ".cache";
    pub out: str = "public";
    /// The home card's version and pixel size (og_version), set on load.
    pub og: str = "";
    pub og_w: i64 = 0i64;
    pub og_h: i64 = 0i64;
}

/// site.rokon, with the home card's version and size.
fn load_site() throws -> Site {
    let site: Site = try rokon::from_str(try fs::read_to_str("site.rokon"));
    site.og = og_version(try og_inputs("home.html"), "");
    let (w, h) = try png_size("static/og.png");
    site.og_w = w;
    site.og_h = h;
    site
}

/// A running hash of what og/render.mjs draws a card from: itself, the
/// template, the assets the templates load, and for the home card the
/// static/og.png it replaces. og_version adds the card's text. The kit's
/// stylesheet and mark come from the copies built in, so a server
/// without web/ beside it still agrees with the build.
fn og_inputs(tpl: str) throws -> Digest {
    let d = Digest::new(HashAlgorithm::Sha256);
    let built: Dict<str, str> = Dict::new();
    built.insert("web/assets/rokstones.svg", kit::ROKSTONES_SVG);
    built.insert("web/css/rok.css", kit::ROK_CSS);
    let files = ["og/render.mjs", "og/" + tpl, "web/assets/rokstones.svg", "web/css/rok.css"];
    if tpl == "home.html" { files.push("static/og.png"); }
    // A missing input only changes the version, so its pages fall back to
    // the site card; it must never stop the server.
    if fs::exists("og/fonts") {
        for entry in fs::walk("og/fonts") {
            let e = try entry.get() catch _ { continue; };
            if e.is_file() { files.push(e.path().as_str()); }
        }
    }
    files.sort();
    for f in files {
        d.update(f + "\n");
        if let b: str = built.get(f) {
            d.update(b);
            continue;
        }
        d.update(try fs::read(f) catch _ { continue; });
    }
    d
}

/// Whether the live site has `card` drawn at version `v`: its `.v` matches.
fn drawn(site: Site, card: str, v: str) -> bool {
    let f = site.out + "/" + card;
    if !fs::exists(f) { return false; }
    let got = try fs::read_to_str(f + ".v") catch _ { "" };
    got.trim() == v
}

/// A card's version: the first 10 hex digits of its inputs' SHA-256. It
/// changes exactly when the rendered card would, so a new card gets a
/// new URL and link previews refetch it.
pub fn og_version(inputs: Digest, text: str) -> str {
    let d = inputs;
    d.update(text);
    secret::hex(d.finish()[0:5])
}

/// Width and height from a PNG's IHDR chunk.
fn png_size(path: str) throws -> (i64, i64) {
    let b = try fs::read(path);
    if b.len() < 24 { throw ValueError { msg: f"{path}: not a PNG" }; }
    let be = |k: usize| ((b[k] as i64) << 24) | ((b[k + 1] as i64) << 16) | ((b[k + 2] as i64) << 8) | (b[k + 3] as i64);
    (be(16), be(20))
}

fn json_str(s: str) -> str {
    let out = StrBuf::new();
    out.push('"');
    for c in s.chars() {
        if c == '"' {
            out.push_str("\\\"");
        } else if c == '\\' {
            out.push_str("\\\\");
        } else if c == '\n' {
            out.push_str("\\n");
        } else if (c as u32) < 0x20u32 {
            out.push(' ');
        } else {
            out.push(c);
        }
    }
    out.push('"');
    out.to_str()
}

fn write(root: str, path: str, data: str) throws {
    let full = root + "/" + path;
    try fs::create_dir_all(dir_of(full));
    try fs::write(full, data);
}

/// Every value of `name="..."` in `html`.
fn attr_values(cs: List<char>, name: str) -> List<str> {
    let pat: List<char> = List::new();
    for c in name.chars() { pat.push(c); }
    pat.push('=');
    pat.push('"');
    let out: List<str> = List::new();
    let n = cs.len();
    let m = pat.len();
    let i = 0usize;
    while i + m <= n {
        let hit = i == 0 || cs[i - 1] == ' ';
        let k = 0usize;
        while hit && k < m {
            if cs[i + k] != pat[k] { hit = false; }
            k += 1;
        }
        if !hit {
            i += 1;
            continue;
        }
        let v = StrBuf::new();
        let j = i + m;
        while j < n && cs[j] != '"' {
            v.push(cs[j]);
            j += 1;
        }
        out.push(v.to_str().replace("&quot;", "\"").replace("&amp;", "&"));
        i = j;
    }
    out
}

fn chars_of(s: str) -> List<char> {
    let cs: List<char> = List::new();
    for c in s.chars() { cs.push(c); }
    cs
}

/// Broken internal `href` / `src` targets: missing file or anchor, or an
/// address that is relative or not canonical (`url::canonical`).
fn check(files: Dict<str, str>, statics: Set<str>) -> List<str> {
    let ids: Dict<str, Set<str>> = Dict::new();
    let refs: Dict<str, List<str>> = Dict::new();
    for out in files.keys() {
        let cs = chars_of(files[out]);
        let s: Set<str> = Set::new();
        for id in attr_values(cs, "id") { s.insert(id); }
        ids.insert(out, s);
        let r = attr_values(cs, "href");
        r.extend(attr_values(cs, "src"));
        r.extend(attr_values(cs, "action"));
        refs.insert(out, r);
    }
    let bad: List<str> = List::new();
    for out in files.keys() {
        for href in refs[out] {
            if href.contains("://") || href.starts_with("mailto:") || href == "#" { continue; }
            let path = href;
            let frag = "";
            if let k: usize = href.find("#") {
                path = href[:k];
                frag = href[k + 1:];
            }
            if !path.is_empty() && !path.starts_with("/") {
                bad.push(f"{out}: {href} (relative; write /{path})");
                continue;
            }
            if path.is_empty() {
                if !frag.is_empty() && !ids[out].contains(frag) { bad.push(f"{out}: {href} (no anchor)"); }
                continue;
            }
            if let c: str = url::canonical(path) {
                bad.push(f"{out}: {href} (not canonical; write {c})");
                continue;
            }
            let rel = path[1:];
            let target = if rel.is_empty() {
                "index.html"
            } else if ids.contains_key(rel + ".html") {
                rel + ".html"
            } else {
                rel + "/index.html"
            };
            if let s: Set<str> = ids.get(target) {
                if !frag.is_empty() && !s.contains(frag) { bad.push(f"{out}: {href} (no anchor)"); }
            } else if !statics.contains(rel) {
                bad.push(f"{out}: {href} (no page)");
            }
        }
    }
    bad
}

fn main() throws {
    let t0 = Instant::now();
    let args = env::args();
    if args.len() == 2 && args[1] == "serve" {
        try server::serve(try load_site());
        return;
    }
    let strict = false;
    let demo = false;
    let offline = false;
    let index_arg = "";
    let i = 1usize;
    while i < args.len() {
        let a = args[i];
        if a == "check" {
            strict = true;
        } else if a == "--demo" {
            demo = true;
        } else if a == "--offline" {
            offline = true;
        } else if a == "--index" && i + 1 < args.len() {
            i += 1;
            index_arg = args[i];
        } else {
            eprintln(f"unknown argument `{a}` (check, --demo, --offline, --index <dir>)");
            env::exit(2);
        }
        i += 1;
    }

    let site = try load_site();
    let dir = if demo { "fixtures/index" } else if !index_arg.is_empty() { index_arg } else { site.index };
    dir = dir.strip_suffix("/") ?? dir;
    if !fs::exists(dir) {
        eprintln(f"error: no index at {dir} (site.rokon `index`, or --demo)");
        env::exit(1);
    }
    let readmes = stones::Readmes { cache: site.cache, fixed: if demo { "fixtures/readme" } else { "" }, fixed_src: if demo { "fixtures/src" } else { "" }, offline: offline };
    let idx = stones::load(dir, readmes);
    for e in idx.errors { eprintln(f"index: {e}"); }
    let all = idx.stones;
    let have: Set<str> = Set::new();
    for s in all { have.insert(s.name); }

    // OG cards for og/render.mjs, one per line: card version, name, stone
    // version, description; the home card has no name.
    let stone_card = try og_inputs("stone.html");
    let og_v: Dict<str, str> = Dict::new();
    let mani = StrBuf::new();
    mani.push_str(f"{site.og}\t\t\t\n");
    for s in all {
        let text = s.name + "\t" + s.latest.vers + "\t" + s.desc.replace("\t", " ").replace("\n", " ");
        let v = og_version(stone_card, text);
        og_v.insert(s.name, v);
        mani.push_str(v + "\t" + text + "\n");
    }
    try fs::write("og/manifest.tsv", mani.to_str());

    let files: Dict<str, str> = Dict::new();
    let guide = markdown::render(try fs::read_to_str("pages/publishing.md"), layout::md(|h| h));
    files.insert("index.html", layout::page(site, "index.html", site.title, layout::landing(site, all)));
    files.insert("publishing.html", layout::page_desc(site, "publishing.html", "Using and publishing stones", "How to add a stone to a Rok package, and how a version gets into the index.", layout::guide(guide)));
    files.insert("404.html", layout::page(site, "404.html", "Not found", layout::not_found()));
    files.insert("stones/index.html", layout::page(site, "stones/index.html", "All stones", layout::all_stones(all)));
    for s in all {
        let out = layout::stone_out(s.name);
        let about = if s.desc.is_empty() { f"{s.name} {s.latest.vers}, a Rok stone" } else { s.desc };
        // Until render.mjs draws this card, link previews get the site card.
        let (og, alt) = if drawn(site, "og/" + s.name + ".png", og_v[s.name]) {
            (site.base_url + "/og/" + s.name + ".png?v=" + og_v[s.name], f"{s.name} {s.latest.vers}: {about}")
        } else { ("", "") };
        files.insert(out, layout::page_desc(site, out, s.name, about, layout::stone_page(site, s), og, alt));
        let ao = layout::tab_out(s.name, "api");
        files.insert(ao, layout::page_desc(site, ao, f"API of {s.name}", about, layout::api_page(site, s), og, alt));
        let vo = layout::tab_out(s.name, "versions");
        files.insert(vo, layout::page_desc(site, vo, f"Versions of {s.name}", about, layout::versions_page(site, s), og, alt));
        let dpo = layout::tab_out(s.name, "dependencies");
        files.insert(dpo, layout::page_desc(site, dpo, f"Dependencies of {s.name}", about, layout::deps_page(site, s, have), og, alt));
        let rdo = layout::tab_out(s.name, "dependents");
        files.insert(rdo, layout::page_desc(site, rdo, f"Dependents of {s.name}", about, layout::dependents_page(site, s), og, alt));
    }

    // Search index: every stone, its latest version and description.
    let sx = StrBuf::new();
    sx.push('[');
    for k in 0..all.len() {
        let s = all[k];
        if k > 0 { sx.push_str(",\n"); }
        sx.push_str(f"{{\"t\":{json_str(s.name)},\"u\":{json_str(layout::url(layout::stone_out(s.name)))},\"v\":{json_str(s.latest.vers)},\"p\":{json_str(s.desc)}}}");
    }
    sx.push_str("]\n");

    // Built beside the old site, then swapped in: `serve` keeps serving.
    let out_root = site.out + ".new";
    if fs::exists(out_root) { try fs::remove_dir_all(out_root); }
    for out in files.keys() { try write(out_root, out, files[out]); }
    let urls: List<str> = List::new();
    for out in files.keys() {
        if out != "404.html" { urls.push(site.base_url + layout::url(out)); }
    }
    urls.sort();
    let map = StrBuf::new();
    map.push_str("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n");
    for u in urls { map.push_str(f"<url><loc>{markdown::esc(u)}</loc></url>\n"); }
    map.push_str("</urlset>\n");
    try write(out_root, "sitemap.xml", map.to_str());
    try write(out_root, "robots.txt", f"User-agent: *\nDisallow: /me\nSitemap: {site.base_url}/sitemap.xml\n");
    try write(out_root, "search-index.json", sx.to_str());
    let statics: Set<str> = Set::new();
    statics.insert("search-index.json");
    // Served by `serve`, not files.
    statics.insert("login");
    statics.insert("me");
    // The kit's files (web/, built in), then static/.
    for f in kit::files(kit::Mark::Rokstones) {
        try fs::write(out_root + "/" + f.name, f.data);
        statics.insert(f.name);
    }
    for entry in fs::walk("static") {
        let e = try entry.get();
        if !e.is_file() { continue; }
        let name = e.path().as_str()["static/".len():];
        try fs::copy(e.path(), out_root + "/" + name);
        statics.insert(name);
    }
    // Rendered cards outlive the rebuild while still current: each has a
    // `.v` beside it naming the version render.mjs drew (server.rok).
    let cards: List<(str, str)> = [("og.png", site.og)];
    for s in all { cards.push(("og/" + s.name + ".png", og_v[s.name])); }
    for (card, v) in cards {
        if !drawn(site, card, v) { continue; }
        let from = site.out + "/" + card;
        try fs::create_dir_all(dir_of(out_root + "/" + card));
        try fs::copy(from, out_root + "/" + card);
        try fs::copy(from + ".v", out_root + "/" + card + ".v");
    }

    let old = site.out + ".old";
    if fs::exists(old) { try fs::remove_dir_all(old); }
    if fs::exists(site.out) { try fs::rename(site.out, old); }
    try fs::rename(out_root, site.out);
    if fs::exists(old) { try fs::remove_dir_all(old); }
    out_root = site.out;

    let bad = check(files, statics);
    for b in bad { eprintln(f"broken link: {b}"); }
    let readme_n = 0usize;
    for s in all {
        if !s.readme.is_empty() { readme_n += 1; }
    }
    println(f"{dir}: {all.len()} stones ({readme_n} with README), {idx.errors.len()} index errors → {out_root}/ ({files.len()} html), {bad.len()} broken links, {t0.elapsed():?}");
    if strict && (bad.len() > 0 || idx.errors.len() > 0) { env::exit(1); }
}

#[test]
fn og_versions() {
    let d = Digest::new(HashAlgorithm::Sha256);
    let a = og_version(d, "abc");
    if a != "ba7816bf8f" || og_version(d, "abc") != a || og_version(d, "abd") == a { panic(a); }
}

#[test]
fn link_check() {
    let files: Dict<str, str> = Dict::new();
    files.insert("index.html", "<a href=\"/stones\">a</a><a href=\"/stones/json#x\">b</a><a href=\"#top\">c</a><img src=\"/rok.svg\">");
    files.insert("stones/index.html", "<a href=\"stones/json.html\">rel</a><a href=\"/stones/json.html\">html</a><a href=\"/stones/\">slash</a><a href=\"/nope\">gone</a><a href=\"#top\">top</a>");
    files.insert("stones/json.html", "<h2 id=\"x\">x</h2><a href=\"/login\">in</a>");
    let statics: Set<str> = Set::new();
    statics.insert("rok.svg");
    statics.insert("login");
    let bad = check(files, statics);
    let want = ["(relative; write /stones/json.html)", "(not canonical; write /stones/json)", "(not canonical; write /stones)", "/nope (no page)", "index.html: #top (no anchor)", "stones/index.html: #top (no anchor)"];
    if bad.len() != want.len() { panic(f"{bad:?}"); }
    for w in want {
        let hit = false;
        for b in bad {
            if b.contains(w) { hit = true; }
        }
        if !hit { panic(f"no `{w}` in {bad:?}"); }
    }
}
