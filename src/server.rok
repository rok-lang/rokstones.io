// `serve`: the site in `public/`, GitHub login, publish tokens, trusted
// publishing and the publish / yank API over plain HTTP (TLS ends at a
// reverse proxy).
//
// One thread per connection. Everything that reads or writes the data
// file or the index holds `LOCK`, so writes are serialized. After an
// index commit `STALE` is set and a background thread rebuilds the site
// by running this program again.

use rok::std::env;
use rok::std::fs;
use rok::std::net;
use rok::std::net::TcpStream;
use rok::std::rokon;
use rok::std::rokon::Value;
use rok::std::process::{Command, Stdio, ChildStdin, ChildStdout};
use rok::std::thread;
use rok::std::time::SystemTime;
use markdown::esc;
use pkg::Site;
use pkg::layout;
use web::http;
use web::http::Request;
use web::url;
use pkg::index;
use pkg::index::ApiError;
use pkg::stones;
use pkg::secret;
use pkg::meta;
use pkg::meta::{Release, Actor};
use pkg::json;
use pkg::trust;
use pkg::trust::{TrustedPublisher, TrustToken};
use rok::core::crypto::rsa::PublicKey;

static LOCK: Mutex<i32> = Mutex::new(0);
static STALE: Atomic<i32> = Atomic::new(0);
static ACTIVE: Atomic<i32> = Atomic::new(0);
/// When the issuer's keys were last fetched (unix seconds).
static JWKS_AT: Atomic<i64> = Atomic::new(0i64);

const MAX_CONNS: i32 = 256;
const SESSION_SECS: i64 = 2592000;
const MAX_TOKENS: usize = 20;
/// The body of a token exchange; GitHub's OIDC tokens are about 1 KiB.
const MAX_EXCHANGE: usize = 16384;

/// Settings from the environment, then `.env`.
pub struct Cfg {
    /// Public base URL, no trailing `/`.
    pub url: str;
    pub addr: str;
    pub client_id: str;
    pub client_secret: str;
    /// `,a,b,` (lowercase GitHub logins).
    pub admins: str;
    pub data: str;
    pub index: str;
    pub oauth: str;
    pub api: str;
    /// The `aud` an OIDC token must carry: ROKSTONES_AUDIENCE, else the
    /// host of `url`.
    pub audience: str = "";
    /// The OIDC issuer, no trailing `/`; tests point it at a fake.
    pub issuer: str = trust::GITHUB_ISSUER;
    /// ROKSTONES_TRUSTED: the bootstrap file of trusted publishers; "": none.
    pub trusted: str = "";
    /// ROKSTONES_OPEN_PUBLISHING=1: accounts other than the admins get
    /// tokens, trusted publishers and publishing. Off: they only log in.
    pub open: bool = false;
}

/// `KEY=value` lines; `#` comments, blank lines, `export ` and one pair
/// of matching quotes around the value allowed.
pub fn parse_env(text: str) -> Dict<str, str> {
    let out: Dict<str, str> = Dict::new();
    for raw in text.split("\n") {
        let l = raw.trim();
        if l.is_empty() || l.starts_with("#") { continue; }
        l = l.strip_prefix("export ") ?? l;
        let (k, v) = l.split_once("=") ?? ("", "");
        let key = k.trim();
        if key.is_empty() { continue; }
        let val = v.trim();
        if val.len() >= 2 && ((val.starts_with("\"") && val.ends_with("\"")) || (val.starts_with("'") && val.ends_with("'"))) {
            val = val[1:val.len() - 1];
        }
        out.insert(key, val);
    }
    out
}

fn setting(file: Dict<str, str>, k: str, dflt: str) throws -> str {
    let v = try env::var(k) catch _ { file.get(k) ?? dflt };
    if v.is_empty() { throw ApiError { status: 0, msg: f"{k} is not set (environment or .env)" }; }
    v
}

fn optional(file: Dict<str, str>, k: str) -> str { try env::var(k) catch _ { file.get(k) ?? "" } }

/// `rokstones.io` of `https://rokstones.io:443/x`.
pub fn host_of(url: str) -> str {
    let rest = url.split_once("://") ?? ("", url);
    let h = (rest.1.split_once("/") ?? (rest.1, "")).0;
    (h.split_once(":") ?? (h, "")).0.to_lowercase()
}

pub fn load_cfg(path: str) throws -> Cfg {
    let text = if fs::exists(path) { try fs::read_to_str(path) } else { "" };
    let f = parse_env(text);
    let admins = StrBuf::new();
    admins.push(',');
    for a in (try env::var("ROKSTONES_ADMINS") catch _ { f.get("ROKSTONES_ADMINS") ?? "" }).split(",") {
        let t = a.trim().to_lowercase();
        if !t.is_empty() { admins.push_str(t + ","); }
    }
    let url = try setting(f, "ROKSTONES_URL", "");
    let aud = optional(f, "ROKSTONES_AUDIENCE");
    let issuer = optional(f, "GITHUB_OIDC_ISSUER");
    if issuer.is_empty() { issuer = trust::GITHUB_ISSUER; }
    Cfg {
        url: url.strip_suffix("/") ?? url,
        addr: try setting(f, "ROKSTONES_ADDR", "127.0.0.1:8080"),
        client_id: try setting(f, "GITHUB_CLIENT_ID", ""),
        client_secret: try setting(f, "GITHUB_CLIENT_SECRET", ""),
        admins: admins.to_str(),
        data: try setting(f, "ROKSTONES_DATA", ""),
        index: try setting(f, "ROKSTONES_INDEX", ""),
        oauth: try setting(f, "GITHUB_OAUTH_URL", "https://github.com"),
        api: try setting(f, "GITHUB_API_URL", "https://api.github.com"),
        audience: if aud.is_empty() { host_of(url) } else { aud },
        issuer: issuer.strip_suffix("/") ?? issuer,
        trusted: optional(f, "ROKSTONES_TRUSTED"),
        open: ["1", "true"].contains(optional(f, "ROKSTONES_OPEN_PUBLISHING").to_lowercase()),
    }
}

pub fn is_admin(cfg: Cfg, login: str) -> bool {
    !login.is_empty() && cfg.admins.contains("," + login.to_lowercase() + ",")
}

/// Whether account `login` may do more than log in: create tokens, add
/// trusted publishers, publish and yank.
pub fn may_act(cfg: Cfg, login: str) -> bool { is_admin(cfg, login) || (cfg.open && !login.is_empty()) }

/// Whether trusted publisher `p` may be granted: from the seed file, or
/// added by an account that may act.
pub fn counts(cfg: Cfg, p: TrustedPublisher) -> bool { p.seeded || may_act(cfg, p.added_by) }

#[derive(Rokon)]
pub struct Account {
    /// GitHub's numeric user id.
    pub id: i64;
    pub login: str;
    pub created: i64;
}

#[derive(Rokon)]
pub struct Session {
    /// SHA-256 of the cookie value.
    pub hash: str;
    pub account: i64;
    pub csrf: str;
    pub expires: i64;
}

#[derive(Rokon)]
pub struct Token {
    pub id: str;
    pub name: str;
    pub account: i64;
    /// SHA-256 of the token.
    pub hash: str;
    pub created: i64;
    pub last_used: i64;
}

/// Who may publish a package: `name` is `index::key`, `native/` prefixed
/// for native packages.
#[derive(Rokon)]
pub struct Owner {
    pub name: str;
    pub accounts: List<i64>;
}

#[derive(Rokon)]
pub struct Db {
    pub accounts: List<Account>;
    pub sessions: List<Session>;
    pub tokens: List<Token>;
    pub owners: List<Owner>;
    /// Every version published, yanked or unyanked through the API, and
    /// the metadata of versions from before it (migrate-index).
    pub releases: List<Release> = List::new();
    /// Workflows that may trade an OIDC token for a publish token.
    pub trusted: List<TrustedPublisher> = List::new();
    /// Tokens traded for OIDC tokens, until they and their OIDC token expire.
    pub trust_tokens: List<TrustToken> = List::new();
}

fn load_db(cfg: Cfg) throws -> Db { try read_db(cfg.data) }

/// `dir/db.rokon`; empty when there is none.
pub fn read_db(dir: str) throws -> Db {
    let p = dir + "/db.rokon";
    if !fs::exists(p) { return Db { accounts: List::new(), sessions: List::new(), tokens: List::new(), owners: List::new(), releases: List::new() }; }
    try rokon::from_str(try fs::read_to_str(p))
}

/// `dir/db.rokon` written whole (sessions kept as they are).
pub fn write_db(dir: str, db: Db) throws { try fs::write_atomic(dir + "/db.rokon", (try rokon::to_str(db)) + "\n"); }

/// Where `db.releases` has `k` (`index::key`, `native/` prefixed) at
/// `version`; a record is added when there is none.
pub fn release_at(db: Db, k: str, version: str) -> usize {
    for i in 0..db.releases.len() {
        if db.releases[i].name == k && db.releases[i].version == version { return i; }
    }
    db.releases.push(Release { name: k, version: version, meta: meta::empty(), published_by: none, yanked_by: none, unyanked_by: none });
    db.releases.len() - 1
}

fn save_db(cfg: Cfg, db: Db) throws {
    let now = now_secs();
    let live: List<Session> = List::new();
    for s in db.sessions {
        if s.expires > now { live.push(s); }
    }
    db.sessions = live;
    let kept: List<TrustToken> = List::new();
    for t in db.trust_tokens {
        if trust::live(t, now) { kept.push(t); }
    }
    db.trust_tokens = kept;
    try write_db(cfg.data, db);
}

fn now_secs() -> i64 { SystemTime::now().unix_secs() }

fn account(db: Db, id: i64) -> Account | none {
    for a in db.accounts {
        if a.id == id { return a; }
    }
    none
}

/// The live session a request's cookie names.
fn session_of(db: Db, r: Request) -> Session | none {
    let c = http::cookie(r, "rks_session");
    if c.is_empty() { return none; }
    let h = secret::sha256_hex(c);
    let now = now_secs();
    for s in db.sessions {
        if secret::same(s.hash, h) && s.expires > now { return s; }
    }
    none
}

/// The token `t` (`rks_` + 64 hex), checked against every stored hash.
fn token_of(db: Db, t: str) -> Token | none {
    if !t.starts_with("rks_") || t.len() != 68 { return none; }
    let h = secret::sha256_hex(t);
    let found: Token | none = none;
    for k in db.tokens {
        if secret::same(k.hash, h) { found = k; }
    }
    found
}

/// The first publisher owns a name; a name already in the index with no
/// owner on record (published before this server) is the admins'.
pub fn may_publish(owners: List<i64> | none, in_index: bool, id: i64, admin: bool) -> bool {
    if admin { return true; }
    if let o: List<i64> = owners { return o.contains(id); }
    !in_index
}

fn owners_of(db: Db, k: str) -> List<i64> | none {
    for o in db.owners {
        if o.name == k { return o.accounts; }
    }
    none
}

pub struct Resp {
    pub status: i32;
    pub headers: List<str>;
    pub body: str;
    /// A static file sent as the body instead; `""`: none.
    pub file: str;
}

// Every page, generated or from public/: Cloudflare injects its Web
// Analytics beacon; a README may show images from anywhere on https. No
// style attributes: a stone's hue is a class (layout::hue_class).
const CSP: str = "Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" + http::REPORT_TO;
/// The CSP of a page with a <select> (the list's sort): WebKit's own select
/// shadow DOM sets style attributes, so those are allowed there alone.
const CSP_SELECT: str = "Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" + http::REPORT_TO;

fn html(status: i32, body: str) -> Resp {
    Resp {
        status: status,
        headers: [
            "Content-Type: text/html; charset=utf-8",
            "Cache-Control: no-store",
        ],
        body: body,
        file: "",
    }
}

/// Pages anyone may cache: short, and revalidated by ETag (handle).
pub const HTML_CACHE: str = "public, max-age=60, must-revalidate";
pub const IMMUTABLE: str = "public, max-age=31536000, immutable";

/// A generated page anyone may see, like the files in `public/`.
fn shared_html(status: i32, body: str) -> Resp {
    let r = html(status, body);
    r.headers[1] = "Cache-Control: " + HTML_CACHE;
    r
}

fn redirect(to: str, cookies: List<str>) -> Resp {
    let h: List<str> = [f"Location: {to}", "Cache-Control: no-store"];
    for c in cookies { h.push("Set-Cookie: " + c); }
    Resp { status: 303, headers: h, body: "", file: "" }
}

fn rokon_resp(status: i32, name: str, fields: List<(str, Value)>) -> Resp {
    let f: Dict<str, Value> = Dict::new();
    for (k, v) in fields { f.insert(k, v); }
    Resp {
        status: status,
        headers: ["Content-Type: application/rokon; charset=utf-8", "Cache-Control: no-store"],
        // Strings and bools only: nothing that has no ROKON form.
        body: (try! rokon::to_str_flat(Value::Struct { name: name, fields: f })) + "\n",
        file: "",
    }
}

fn api_error(status: i32, msg: str) -> Resp { rokon_resp(status, "Error", [("message", Value::Str(msg))]) }

fn cookie(name: str, value: str, max_age: i64) -> str {
    f"{name}={value}; Path=/; Max-Age={max_age}; HttpOnly; Secure; SameSite=Lax"
}

/// `YYYY-MM-DD` (UTC) of a unix time.
pub fn date(t: i64) -> str {
    if t <= 0i64 { return "never"; }
    let z = t / 86400i64 + 719468i64;
    let era = z / 146097i64;
    let doe = z - era * 146097i64;
    let yoe = (doe - doe / 1460i64 + doe / 36524i64 - doe / 146096i64) / 365i64;
    let doy = doe - (365i64 * yoe + yoe / 4i64 - yoe / 100i64);
    let mp = (5i64 * doy + 2i64) / 153i64;
    let d = doy - (153i64 * mp + 2i64) / 5i64 + 1i64;
    let m = if mp < 10i64 { mp + 3i64 } else { mp - 9i64 };
    let y = yoe + era * 400i64 + (if m <= 2i64 { 1i64 } else { 0i64 });
    let p2 = |x: i64| if x < 10i64 { f"0{x}" } else { f"{x}" };
    f"{y}-{p2(m)}-{p2(d)}"
}

fn page(site: Site, path: str, title: str, body: str, status: i32) -> Resp {
    html(status, layout::page(site, path[1:], title, f"<div class=\"frame acct\">\n{body}\n</div>"))
}

fn message(site: Site, path: str, status: i32, title: str, text: str) -> Resp {
    page(site, path, title, f"<h1 class=\"t-h1\">{esc(title)}</h1>\n<p class=\"t-lead\">{esc(text)}</p>\n<p><a href=\"/\">Back to rokstones</a></p>", status)
}

/// A curl config value, quoted.
fn cq(s: str) -> str {
    if s.contains("\n") || s.contains("\r") { panic("newline in a curl config value"); }
    "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\""
}

/// Run `curl` with `config` on stdin (secrets never reach argv); its stdout.
fn curl(config: str) throws (ApiError) -> str {
    let c = try Command::new("curl").args(["--config", "-"]).stdin(Stdio::Piped).stdout(Stdio::Piped).stderr(Stdio::Null).spawn() catch e {
        throw index::err(502, f"cannot run curl: {e}");
    };
    let full = config + "silent\nshow-error\nfail\nmax-time = 20\n";
    if let w: ChildStdin = c.take_stdin() {
        try w.write_all(full) catch _ {};
        try w.close() catch _ {};
    }
    let out = "";
    if let rd: ChildStdout = c.take_stdout() {
        out = try str::from_utf8(try rd.read_to_end() catch _ { List::<u8>::new() }) catch _ { "" };
        try rd.close() catch _ {};
    }
    let st = try c.wait() catch _ { throw index::err(502, "GitHub did not answer"); };
    if !st.success() { throw index::err(502, "GitHub did not answer"); }
    out
}

fn safe_token(t: str) -> bool {
    if t.is_empty() || t.len() > 512 { return false; }
    for c in t.chars() {
        if !(c.is_ascii_alphanumeric() || c == '_' || c == '-' || c == '.') { return false; }
    }
    true
}

/// A GitHub login: letters, digits, `-`.
fn is_login(s: str) -> bool {
    if s.is_empty() || s.len() > 39 { return false; }
    for c in s.chars() {
        if !(c.is_ascii_alphanumeric() || c == '-') { return false; }
    }
    true
}

/// The GitHub account behind an OAuth `code`: (id, login).
fn github_user(cfg: Cfg, code: str) throws (ApiError) -> (i64, str) {
    let callback = cfg.url + "/auth/github/callback";
    let data = f"client_id={http::pct_encode(cfg.client_id)}&client_secret={http::pct_encode(cfg.client_secret)}&code={http::pct_encode(code)}&redirect_uri={http::pct_encode(callback)}";
    let ua = "header = " + cq("User-Agent: rokstones.io") + "\n";
    let tok = json::fields(try curl(f"url = {cq(cfg.oauth + "/login/oauth/access_token")}\n{ua}header = {cq("Accept: application/json")}\ndata = {cq(data)}\n"));
    let access = tok.get("access_token") ?? "";
    if !safe_token(access) { throw index::err(400, "GitHub refused the login; try again"); }
    let user = json::fields(try curl(f"url = {cq(cfg.api + "/user")}\n{ua}header = {cq("Accept: application/vnd.github+json")}\nheader = {cq("Authorization: Bearer " + access)}\n"));
    let id = try (user.get("id") ?? "").parse::<i64>() catch _ { throw index::err(502, "GitHub sent no user id"); };
    let login = user.get("login") ?? "";
    if id <= 0i64 || !is_login(login) { throw index::err(502, "GitHub sent a malformed user"); }
    (id, login)
}

fn login(cfg: Cfg) throws -> Resp {
    let state = try secret::random_hex(16);
    let to = f"{cfg.oauth}/login/oauth/authorize?client_id={http::pct_encode(cfg.client_id)}&redirect_uri={http::pct_encode(cfg.url + "/auth/github/callback")}&state={state}&scope=read:user";
    redirect(to, [cookie("rks_state", state, 600i64)])
}

fn callback(cfg: Cfg, site: Site, r: Request) throws -> Resp {
    let q = http::form(r.query);
    let state = q.get("state") ?? "";
    let want = http::cookie(r, "rks_state");
    if want.is_empty() || !secret::same(state, want) {
        return message(site, r.path, 400, "Login failed", "The login expired or did not start here. Log in again.");
    }
    let code = q.get("code") ?? "";
    if code.is_empty() {
        return message(site, r.path, 400, "Login cancelled", "GitHub did not authorize the login.");
    }
    let (id, login) = try github_user(cfg, code) catch e {
        return message(site, r.path, e.status, "Login failed", e.msg);
    };
    let sid = try secret::random_hex(32);
    let csrf = try secret::random_hex(16);
    let now = now_secs();
    let out = Resp { status: 500, headers: List::new(), body: "", file: "" };
    using g = LOCK.lock() {
        let db = try load_db(cfg);
        let seen = false;
        for i in 0..db.accounts.len() {
            if db.accounts[i].id == id {
                db.accounts[i].login = login;
                seen = true;
            }
        }
        if !seen { db.accounts.push(Account { id: id, login: login, created: now }); }
        db.sessions.push(Session { hash: secret::sha256_hex(sid), account: id, csrf: csrf, expires: now + SESSION_SECS });
        try save_db(cfg, db);
        out = redirect("/me", [cookie("rks_session", sid, SESSION_SECS), cookie("rks_state", "", 0i64)]);
    }
    out
}

fn me_page(cfg: Cfg, site: Site, path: str, db: Db, s: Session, fresh: str) -> Resp {
    let a = account(db, s.account) ?? Account { id: 0i64, login: "", created: 0i64 };
    let csrf = esc(s.csrf);
    let b = StrBuf::new();
    b.push_str(f"<h1 class=\"t-h1\">Account</h1>\n<p class=\"t-lead\">Logged in with GitHub as <strong>{esc(a.login)}</strong>.</p>\n");
    b.push_str(f"<form method=\"post\" action=\"/logout\"><input type=\"hidden\" name=\"csrf\" value=\"{csrf}\"><button class=\"btn-2 btn-sm\" type=\"submit\">Log out</button></form>\n");
    b.push_str("<h2 class=\"t-h3\">Publish tokens</h2>\n");
    let admin = is_admin(cfg, a.login);
    if !may_act(cfg, a.login) {
        b.push_str("<p>Publishing is not open yet: this account can log in, but cannot create tokens, add trusted publishers, publish or yank. Until it is, stones are added by pull request to the index; <a href=\"/publishing#publishing\">Publishing</a> says how.</p>\n");
        return page(site, path, "Account", b.to_str(), 200);
    }
    let trusted = managed(db, a.id, admin);
    if !fresh.is_empty() {
        b.push_str(f"<div class=\"callout help\"><span class=\"lab\">New token, shown once: copy it now</span><pre class=\"cmd\"><code>{esc(fresh)}</code></pre><p>Save it with <code class=\"ic\">rok login</code>, which reads it from stdin.</p></div>\n");
    }
    let mine: List<Token> = List::new();
    for t in db.tokens {
        if t.account == a.id { mine.push(t); }
    }
    if mine.is_empty() {
        b.push_str("<p>No tokens yet.</p>\n");
    } else {
        b.push_str("<div class=\"table-wrap\"><table class=\"tbl\">\n<thead><tr><th>Name</th><th>Created</th><th>Last used</th><th></th></tr></thead>\n<tbody>\n");
        for t in mine {
            b.push_str(f"<tr><td>{esc(t.name)}</td><td>{date(t.created)}</td><td>{date(t.last_used)}</td><td><form method=\"post\" action=\"/me/tokens/{esc(t.id)}/revoke\"><input type=\"hidden\" name=\"csrf\" value=\"{csrf}\"><button class=\"btn-2 btn-sm\" type=\"submit\">Revoke</button></form></td></tr>\n");
        }
        b.push_str("</tbody>\n</table></div>\n");
    }
    b.push_str(f"<form method=\"post\" action=\"/me/tokens\"><input type=\"hidden\" name=\"csrf\" value=\"{csrf}\"><label>Name <input name=\"name\" maxlength=\"64\" required></label> <button class=\"btn btn-sm\" type=\"submit\">Create token</button></form>\n");
    trusted_section(b, csrf, trusted);
    page(site, path, "Account", b.to_str(), 200)
}

/// The trusted publishers of the stones the account manages, a remove
/// button on each (not on ROKSTONES_TRUSTED's), and the form to add one.
fn trusted_section(b: StrBuf, csrf: str, list: List<TrustedPublisher>) {
    b.push_str("<h2 class=\"t-h3\">Trusted publishers</h2>\n");
    b.push_str(f"<p>A GitHub Actions workflow named here publishes its stone with no token kept anywhere: it trades the job's OIDC token for one that lasts {trust::TOKEN_SECS / 60i64} minutes. <a href=\"/publishing#trusted-publishing\">Publishing</a> has the workflow.</p>\n");
    if list.is_empty() {
        b.push_str("<p>No trusted publishers yet.</p>\n");
    } else {
        b.push_str("<div class=\"table-wrap\"><table class=\"tbl\">\n<thead><tr><th>Stone</th><th>Repository</th><th>Workflow</th><th>Environment</th><th></th></tr></thead>\n<tbody>\n");
        for p in list {
            let env = if p.environment.is_empty() { "<span class=\"muted\">any</span>" } else { esc(p.environment) };
            let act = if p.seeded { "<span class=\"muted\">server config</span>" } else { f"<form method=\"post\" action=\"/me/trusted/{esc(p.id)}/remove\"><input type=\"hidden\" name=\"csrf\" value=\"{csrf}\"><button class=\"btn-2 btn-sm\" type=\"submit\">Remove</button></form>" };
            b.push_str(f"<tr><td>{esc(p.stone)}</td><td>{esc(p.repository)}</td><td>{esc(p.workflow)}</td><td>{env}</td><td>{act}</td></tr>\n");
        }
        b.push_str("</tbody>\n</table></div>\n");
    }
    b.push_str(f"<form method=\"post\" action=\"/me/trusted\"><input type=\"hidden\" name=\"csrf\" value=\"{csrf}\"><label>Stone <input name=\"stone\" maxlength=\"64\" required></label> <label>Repository <input name=\"repository\" placeholder=\"owner/repo\" maxlength=\"140\" required></label> <label>Workflow <input name=\"workflow\" placeholder=\"publish.yml\" maxlength=\"255\" required></label> <label>Environment <input name=\"environment\" placeholder=\"optional\" maxlength=\"255\"></label> <button class=\"btn btn-sm\" type=\"submit\">Add</button></form>\n");
}

/// `/me`, `/logout`, `/me/tokens..` and `/me/trusted..`: the session's
/// account pages.
fn account_route(cfg: Cfg, site: Site, r: Request) throws -> Resp {
    let out = Resp { status: 500, headers: List::new(), body: "", file: "" };
    using g = LOCK.lock() {
        out = try account_locked(cfg, site, r);
    }
    out
}

fn account_locked(cfg: Cfg, site: Site, r: Request) throws -> Resp {
    let db = try load_db(cfg);
    let s = session_of(db, r) ?? Session { hash: "", account: 0i64, csrf: "", expires: 0i64 };
    if s.hash.is_empty() {
        return if r.method == "GET" { redirect("/login", []) } else { message(site, r.path, 401, "Not logged in", "Log in first.") };
    }
    if r.method == "GET" { return me_page(cfg, site, r.path, db, s, ""); }
    if !r.header("content-type").starts_with("application/x-www-form-urlencoded") {
        return message(site, r.path, 415, "Bad form", "Send the form from the account page.");
    }
    let f = http::form(r.body);
    if !secret::same(f.get("csrf") ?? "", s.csrf) {
        return message(site, r.path, 403, "Bad form", "The form expired; reload the account page.");
    }
    if r.path == "/logout" {
        let keep: List<Session> = List::new();
        for x in db.sessions {
            if x.hash != s.hash { keep.push(x); }
        }
        db.sessions = keep;
        try save_db(cfg, db);
        return redirect("/", [cookie("rks_session", "", 0i64)]);
    }
    let a = account(db, s.account) ?? Account { id: 0i64, login: "", created: 0i64 };
    let admin = is_admin(cfg, a.login);
    if !may_act(cfg, a.login) {
        return message(site, r.path, 403, "Publishing is not open yet", "This account can log in, but cannot create tokens, add trusted publishers, publish or yank yet.");
    }
    if r.path == "/me/trusted" {
        let p = TrustedPublisher { stone: (f.get("stone") ?? "").trim(), repository: (f.get("repository") ?? "").trim(), workflow: (f.get("workflow") ?? "").trim(), environment: (f.get("environment") ?? "").trim() };
        try add_trusted(cfg, db, a, admin, p) catch e { return message(site, r.path, e.status, "Trusted publisher not added", e.msg); };
        return redirect("/me", []);
    }
    if let rest: str = r.path.strip_prefix("/me/trusted/") {
        try remove_trusted(cfg, db, a, admin, rest.strip_suffix("/remove") ?? "") catch e { return message(site, r.path, e.status, "Trusted publisher not removed", e.msg); };
        return redirect("/me", []);
    }
    if r.path == "/me/tokens" {
        let name = (f.get("name") ?? "").trim();
        if name.is_empty() || name.char_count() > 64 {
            return message(site, r.path, 400, "Bad token name", "A token name is 1 to 64 characters.");
        }
        let n = 0usize;
        for t in db.tokens {
            if t.account == a.id { n += 1; }
        }
        if n >= MAX_TOKENS { return message(site, r.path, 400, "Too many tokens", f"Revoke one first (at most {MAX_TOKENS})."); }
        let tok = "rks_" + try secret::random_hex(32);
        db.tokens.push(Token { id: try secret::random_hex(8), name: name, account: a.id, hash: secret::sha256_hex(tok), created: now_secs(), last_used: 0i64 });
        try save_db(cfg, db);
        return me_page(cfg, site, r.path, db, s, tok);
    }
    // `/me/tokens/<id>/revoke`
    let id = (r.path.strip_prefix("/me/tokens/") ?? "").strip_suffix("/revoke") ?? "";
    let keep: List<Token> = List::new();
    let gone = false;
    for t in db.tokens {
        if t.id == id && t.account == a.id { gone = true; } else { keep.push(t); }
    }
    if !gone { return message(site, r.path, 404, "No such token", "It was revoked already."); }
    db.tokens = keep;
    try save_db(cfg, db);
    redirect("/me", [])
}

#[derive(Rokon)]
#[rokon(deny_unknown_fields)]
pub struct Yank {
    pub name: str;
    pub version: str;
    pub undo: bool = false;
    pub native: bool = false;
    /// Why; kept with the version until it is unyanked.
    pub message: str = "";
}

const YANK_MESSAGE_MAX: usize = 512;

fn api_route(cfg: Cfg, r: Request) -> Resp {
    let out = api_error(500, "internal error");
    using g = LOCK.lock() {
        out = try api_locked(cfg, r) catch e { api_error(e.status, e.msg) };
    }
    out
}

fn actor_value(a: Actor | none) -> Value {
    match a {
        x: Actor => {
            let v = rokon::to_value(x);
            // An account's record keeps its old shape.
            if let Value::Struct { name: n, fields } = v {
                if fields.get("via") == Value::None { fields.remove("via"); }
                return Value::Struct { name: n, fields: fields };
            }
            v
        },
        none => Value::None,
    }
}

/// `GET /api/v1/stones/<name>` and `/api/v1/native/<name>`: the owners,
/// and each version in the index with its dependencies (as the index
/// line has them), metadata, README presence, downloads and who
/// published, yanked and unyanked it. No token needed.
fn stone_info(cfg: Cfg, db: Db, native: bool, name: str) throws (ApiError) -> Resp {
    if !stones::is_name(name) { throw index::err(404, f"`{name}` is not a stone name"); }
    let k = (if native { "native/" } else { "" }) + index::key(name);
    let lines = try index::lines_for(cfg.index, native, name);
    if lines.is_empty() { throw index::err(404, f"{if native { "native package" } else { "stone" }} `{name}` is not in the index"); }
    let owners: List<Value> = List::new();
    for id in owners_of(db, k) ?? List::new() {
        let a = account(db, id) ?? Account { id: id, login: "", created: 0i64 };
        let f: Dict<str, Value> = Dict::new();
        f.insert("id", Value::Int(Int::from(a.id)));
        f.insert("login", Value::Str(a.login));
        owners.push(Value::Struct { name: none, fields: f });
    }
    let list: List<Value> = List::new();
    for line in lines {
        let v = if let Value::Str(x) = line.get("version") ?? Value::None { x } else { "" };
        let yanked = line.get("yanked") == Value::Bool(true);
        let rel = Release { name: k, version: v, meta: meta::empty(), published_by: none, yanked_by: none, unyanked_by: none };
        for r in db.releases {
            if r.name == k && r.version == v { rel = r; }
        }
        let f: Dict<str, Value> = Dict::new();
        f.insert("version", Value::Str(v));
        f.insert("yanked", Value::Bool(yanked));
        f.insert("yank_message", if yanked && !rel.yank_message.is_empty() { Value::Str(rel.yank_message) } else { Value::None });
        f.insert("deps", line.get("deps") ?? (if native { Value::Dict(Dict::new()) } else { Value::List(List::new()) }));
        f.insert("meta", meta::to_value(rel.meta));
        f.insert("has_readme", Value::Bool(fs::exists(meta::readme_file(cfg.data, k, v))));
        f.insert("downloads", Value::Int(Int::from(rel.downloads)));
        f.insert("published_by", actor_value(rel.published_by));
        f.insert("yanked_by", actor_value(rel.yanked_by));
        f.insert("unyanked_by", actor_value(rel.unyanked_by));
        list.push(Value::Struct { name: "Version", fields: f });
    }
    rokon_resp(200, "Stone", [("name", Value::Str(name)), ("native", Value::Bool(native)), ("owners", Value::List(owners)), ("versions", Value::List(list))])
}

/// `GET /api/v1/stones/<name>/<version>/readme`: the README text sent
/// with that version, as Markdown.
fn readme_of(cfg: Cfg, native: bool, name: str, version: str) throws (ApiError) -> Resp {
    if !stones::is_name(name) || !index::is_version(version) { throw index::err(404, "no such stone version"); }
    let k = (if native { "native/" } else { "" }) + index::key(name);
    let p = meta::readme_file(cfg.data, k, version);
    if !fs::exists(p) { throw index::err(404, f"{name} {version} was published without a README"); }
    let text = try fs::read_to_str(p) catch e { throw index::err(500, f"readme: {e}"); };
    Resp { status: 200, headers: ["Content-Type: text/markdown; charset=utf-8", "Cache-Control: public, max-age=60"], body: text, file: "" }
}

/// Who a request's token speaks for: an account, or a token traded for
/// an OIDC token, which may touch only the stones in `scope`.
struct Auth {
    account: Account;
    admin: bool;
    /// `index::key`s an exchanged token may publish and yank; none: an
    /// account's token.
    scope: List<str> | none;
    /// Shown by `/api/v1/me` and recorded as the actor.
    login: str;
    /// The index commit's author.
    who: str;
    /// Recorded as who published or yanked.
    actor: Actor;
}

fn nobody_did() -> Actor { Actor { id: 0i64, login: "", at: 0i64 } }

/// Who an exchanged token acts for: the user who triggered the run, and
/// the run. A token with no run on record names its workflow instead.
fn trusted_actor(t: TrustToken) -> Actor {
    match t.via {
        v: meta::Via => Actor { id: t.actor_id, login: t.actor, at: 0i64, via: v },
        none => Actor { id: 0i64, login: t.publisher, at: 0i64 },
    }
}

fn may(auth: Auth, db: Db, k: str, in_index: bool) -> bool {
    match auth.scope {
        s: List<str> => s.contains(k),
        none => may_publish(owners_of(db, k), in_index, auth.account.id, auth.admin),
    }
}

/// Whether account `id` may add and remove `k`'s trusted publishers: its
/// owners and the admins. A stone with no owner on record (not published
/// yet, or published before this server) is the admins' alone.
fn may_manage(db: Db, k: str, id: i64, admin: bool) -> bool {
    admin || (owners_of(db, k) ?? List::new()).contains(id)
}

/// The trusted publishers account `id` may see and change.
fn managed(db: Db, id: i64, admin: bool) -> List<TrustedPublisher> {
    let out: List<TrustedPublisher> = List::new();
    for p in db.trusted {
        if may_manage(db, index::key(p.stone), id, admin) { out.push(p); }
    }
    out
}

/// GitHub's spelling of `repo` and its owner's numeric id.
fn github_repo(cfg: Cfg, repo: str) throws (ApiError) -> (str, i64) {
    let ua = "header = " + cq("User-Agent: rokstones.io") + "\n";
    let text = try curl(f"url = {cq(cfg.api + "/repos/" + repo)}\n{ua}header = {cq("Accept: application/vnd.github+json")}\n") catch _ {
        throw index::err(400, f"GitHub shows no public repository {repo}");
    };
    let full = json::fields(text).get("full_name") ?? "";
    let owner = json::fields(json::member(text, "owner") ?? "{}");
    let id = try (owner.get("id") ?? "").parse::<i64>() catch _ { 0i64 };
    if !trust::is_repo(full) || id <= 0i64 { throw index::err(502, "GitHub sent a malformed repository"); }
    (full, id)
}

/// Add `p` for account `a`, with its repository's owner id from GitHub.
fn add_trusted(cfg: Cfg, db: Db, a: Account, admin: bool, p: TrustedPublisher) throws (ApiError) -> TrustedPublisher {
    try trust::check_publisher(p);
    let k = index::key(p.stone);
    if !may_manage(db, k, a.id, admin) {
        throw index::err(403, f"only the owners of `{p.stone}` and the admins add its trusted publishers");
    }
    let n = 0usize;
    for q in db.trusted {
        if trust::same(q, p) { throw index::err(409, f"`{p.stone}` already trusts {q.repository} {q.workflow}"); }
        if index::key(q.stone) == k { n += 1; }
    }
    if n >= trust::MAX_PER_STONE { throw index::err(400, f"a stone has at most {trust::MAX_PER_STONE} trusted publishers; remove one first"); }
    let (full, owner_id) = try github_repo(cfg, p.repository);
    let out = TrustedPublisher {
        stone: p.stone,
        repository: full,
        owner_id: owner_id,
        workflow: p.workflow,
        environment: p.environment,
        id: try secret::random_hex(8) catch e { throw index::err(500, f"{e}"); },
        added_by: a.login,
        added: now_secs(),
    };
    db.trusted.push(out);
    try save_db(cfg, db) catch e { throw index::err(500, f"data: {e}"); };
    out
}

/// Remove trusted publisher `id` for account `a`.
fn remove_trusted(cfg: Cfg, db: Db, a: Account, admin: bool, id: str) throws (ApiError) {
    let keep: List<TrustedPublisher> = List::new();
    let gone = false;
    for p in db.trusted {
        if p.id != id {
            keep.push(p);
            continue;
        }
        if !may_manage(db, index::key(p.stone), a.id, admin) { throw index::err(404, "no such trusted publisher"); }
        if p.seeded { throw index::err(400, "this trusted publisher is in the server's ROKSTONES_TRUSTED file; remove it there"); }
        gone = true;
    }
    if !gone { throw index::err(404, "no such trusted publisher"); }
    db.trusted = keep;
    try save_db(cfg, db) catch e { throw index::err(500, f"data: {e}"); };
}

/// The issuer's key `kid`: from the cached JWKS, else fetched again (at
/// most once a minute, so made-up kids cannot make us hammer it).
fn oidc_key(cfg: Cfg, kid: str) throws (ApiError) -> PublicKey {
    let cache = cfg.data + "/jwks.json";
    let have = try fs::read_to_str(cache) catch _ { "" };
    if let k: PublicKey = trust::find_key(have, kid) { return k; }
    let unknown = index::err(401, f"the OIDC token's key is not one {cfg.issuer} lists");
    let now = now_secs();
    if now - JWKS_AT.load() < 60i64 { throw unknown; }
    JWKS_AT.store(now);
    let ua = "header = " + cq("User-Agent: rokstones.io") + "\n";
    let conf = try curl(f"url = {cq(cfg.issuer + "/.well-known/openid-configuration")}\n{ua}");
    let uri = json::fields(conf).get("jwks_uri") ?? "";
    if !uri.starts_with(cfg.issuer + "/") { throw index::err(502, "the issuer's OIDC configuration names no jwks_uri of its own"); }
    let keys = try curl(f"url = {cq(uri)}\n{ua}");
    try fs::write_atomic(cache, keys) catch e { eprintln(f"jwks cache: {e}"); };
    trust::find_key(keys, kid) ?? { throw unknown; }
}

/// The `jwt` of `TrustedPublishing { jwt: ".." }` or `{"jwt": ".."}`.
fn jwt_of(body: str) throws (ApiError) -> str {
    let want = index::err(400, "the body is `TrustedPublishing { jwt: \"<GitHub Actions OIDC token>\" }`");
    if body.trim().starts_with("{") { return json::fields(body).get("jwt") ?? { throw want; }; }
    let v = try rokon::parse(body) catch _ { throw want; };
    if let Value::Struct { name: _, fields } = v {
        if let Value::Str(t) = fields.get("jwt") ?? Value::None { return t; }
    }
    throw want;
}

/// `POST /api/v1/trusted-publishing/token`: a GitHub Actions OIDC token
/// in, a publish token for the stones that trust its workflow out.
fn exchange(cfg: Cfg, db: Db, body: str) throws (ApiError) -> Resp {
    if body.len() > MAX_EXCHANGE { throw index::err(413, f"the body is at most {MAX_EXCHANGE} bytes"); }
    let j = try trust::parse_jwt(try jwt_of(body));
    let key = try oidc_key(cfg, j.header.get("kid") ?? "");
    let now = now_secs();
    try trust::check(j, key, cfg.issuer, cfg.audience, now);
    let c = j.claims;
    let jti = c.get("jti") ?? "";
    for t in db.trust_tokens {
        if t.jti == jti { throw index::err(401, "this OIDC token was exchanged already; request a new one"); }
    }
    let repo = c.get("repository") ?? "";
    let wref = c.get("workflow_ref") ?? "";
    // Only publishers from the seed file or from an account that may act.
    let usable: List<TrustedPublisher> = List::new();
    for p in db.trusted {
        if counts(cfg, p) { usable.push(p); }
    }
    let keys = trust::grant(usable, c);
    if keys.is_empty() {
        let file = ((wref.split_once("/.github/workflows/") ?? ("", wref)).1.split_once("@") ?? (wref, "")).0;
        let env = c.get("environment") ?? "";
        throw index::err(403, f"no stone trusts {repo}, workflow {file}{if env.is_empty() { "" } else { ", environment " + env }}: an owner adds it as a trusted publisher at {cfg.url}/me");
    }
    let names: List<Value> = List::new();
    for p in usable {
        if trust::matches(p, c) && !names.contains(Value::Str(p.stone)) { names.push(Value::Str(p.stone)); }
    }
    let tok = "rkt_" + try secret::random_hex(32) catch e { throw index::err(500, f"{e}"); };
    let exp = try (c.get("exp") ?? "").parse::<i64>() catch _ { now };
    let (actor, actor_id) = trust::actor_of(c);
    db.trust_tokens.push(TrustToken {
        hash: secret::sha256_hex(tok),
        stones: keys,
        publisher: "github:" + wref,
        repository: repo,
        jti: jti,
        created: now,
        expires: now + trust::TOKEN_SECS,
        jwt_expires: exp,
        actor: actor,
        actor_id: actor_id,
        via: trust::via_of(c),
    });
    try save_db(cfg, db) catch e { throw index::err(500, f"data: {e}"); };
    eprintln(f"trusted publishing: github:{wref} for {keys.join(", ")}");
    rokon_resp(200, "TrustedToken", [("token", Value::Str(tok)), ("expires", Value::Int(Int::from(now + trust::TOKEN_SECS))), ("stones", Value::List(names))])
}

fn rokon_value(status: i32, v: Value) -> Resp {
    Resp {
        status: status,
        headers: ["Content-Type: application/rokon; charset=utf-8", "Cache-Control: no-store"],
        body: (try! rokon::to_str_flat(v)) + "\n",
        file: "",
    }
}

/// Fill in what `rok publish --index-dir` left out of a version already
/// in the index from the same tree: its metadata, README and publisher. A
/// version published through this API is taken.
fn fill_in(cfg: Cfg, db: Db, k: str, p: index::Publish, have: str, by: Actor) throws (ApiError) {
    let e = p.entry;
    let taken = index::err(409, f"{e.name} {e.version} is already in the index");
    if e.native { throw taken; }
    let (_, v) = try stones::parse_line(e.line) catch x { throw index::err(400, x.msg); };
    if v.tree != have { throw index::err(409, f"{e.name} {e.version} is already in the index from another tree ({have}); publish a new version"); }
    for r in db.releases {
        if r.name == k && r.version == e.version && r.published_by is Actor { throw taken; }
    }
    let i = release_at(db, k, e.version);
    db.releases[i].meta = meta::over(db.releases[i].meta, p.meta);
    db.releases[i].published_by = by;
    let rp = meta::readme_file(cfg.data, k, e.version);
    if !p.readme.is_empty() && !fs::exists(rp) {
        try {
            fs::create_dir_all(layout::dir_of(rp));
            fs::write(rp, p.readme);
        } catch x { eprintln(f"readme: {x}"); };
    }
}

fn api_locked(cfg: Cfg, r: Request) throws (ApiError) -> Resp {
    for (prefix, native) in [("/api/v1/stones/", false), ("/api/v1/native/", true)] {
        if let rest: str = r.path.strip_prefix(prefix) {
            let parts: List<str> = List::new();
            for x in rest.split("/") { parts.push(http::pct_decode(x, false) ?? x); }
            let what = if parts.len() == 3 { f"{prefix}<name>/<version>/readme" } else { f"{prefix}<name>" };
            if r.method != "GET" && r.method != "HEAD" { throw index::err(405, f"use GET {what}"); }
            if parts.len() == 3 && parts[2] == "readme" { return try readme_of(cfg, native, parts[0], parts[1]); }
            if parts.len() != 1 { throw index::err(404, "no such API route"); }
            let db = try load_db(cfg) catch e { throw index::err(500, f"data: {e}"); };
            return try stone_info(cfg, db, native, parts[0]);
        }
    }
    let routes: List<(str, str)> = [
        ("GET", "/api/v1/me"),
        ("POST", "/api/v1/publish"),
        ("POST", "/api/v1/yank"),
        ("POST", "/api/v1/trusted-publishing/token"),
        ("GET", "/api/v1/trusted-publishers"),
        ("POST", "/api/v1/trusted-publishers"),
        ("POST", "/api/v1/trusted-publishers/remove"),
    ];
    let methods: List<str> = List::new();
    for (m, p) in routes {
        if p == r.path { methods.push(m); }
    }
    if methods.is_empty() { throw index::err(404, "no such API route"); }
    if !methods.contains(r.method) { throw index::err(405, f"use {methods.join(" or ")} {r.path}"); }
    let db = try load_db(cfg) catch e { throw index::err(500, f"data: {e}"); };
    if r.path == "/api/v1/trusted-publishing/token" { return try exchange(cfg, db, r.body); }
    let presented = (r.header("authorization").strip_prefix("Bearer ") ?? "").trim();
    let no_account = Account { id: 0i64, login: "", created: 0i64 };
    let auth = Auth { account: no_account, admin: false, scope: none, login: "", who: "", actor: nobody_did() };
    if presented.starts_with("rkt_") {
        let t = trust::token_of(db.trust_tokens, presented, now_secs()) ?? {
            throw index::err(401, "the trusted publishing token expired or is not valid; exchange a new OIDC token");
        };
        auth = Auth { account: no_account, admin: false, scope: t.stones, login: t.publisher, who: f"{t.repository} <index@rokstones.io>", actor: trusted_actor(t) };
    } else {
        let tok = token_of(db, presented) ?? Token { id: "", name: "", account: 0i64, hash: "", created: 0i64, last_used: 0i64 };
        if tok.id.is_empty() { throw index::err(401, "a valid token is required (Authorization: Bearer rks_..)"); }
        let a = account(db, tok.account) ?? no_account;
        // A token kept from before publishing closed authorizes nothing.
        if !may_act(cfg, a.login) { throw index::err(403, "Publishing is not open yet"); }
        auth = Auth { account: a, admin: is_admin(cfg, a.login), scope: none, login: a.login, who: f"{a.login} <{a.id}+{a.login}@users.noreply.github.com>", actor: Actor { id: a.id, login: a.login, at: 0i64 } };
        tok.last_used = now_secs();
        try save_db(cfg, db) catch e { throw index::err(500, f"data: {e}"); };
    }
    let trusted = auth.scope is List<str>;
    if r.path == "/api/v1/me" {
        return rokon_resp(200, "Me", [("login", Value::Str(auth.login)), ("publish", Value::Bool(trusted || may_act(cfg, auth.login)))]);
    }
    if r.path.starts_with("/api/v1/trusted-publishers") {
        if trusted { throw index::err(403, "trusted publishers are managed with an account's token, not a trusted publishing one"); }
        let a = auth.account;
        if r.method == "GET" {
            let list: List<Value> = List::new();
            for p in managed(db, a.id, auth.admin) { list.push(rokon::to_value(p)); }
            return rokon_resp(200, "TrustedPublishers", [("publishers", Value::List(list))]);
        }
        if r.path == "/api/v1/trusted-publishers/remove" {
            let id = "";
            if let Value::Struct { name: _, fields } = try rokon::parse(r.body) catch _ { Value::None } {
                if let Value::Str(x) = fields.get("id") ?? Value::None { id = x; }
            }
            if id.is_empty() { throw index::err(400, "the body is `Remove { id: \"..\" }`"); }
            try remove_trusted(cfg, db, a, auth.admin, id);
            return rokon_resp(200, "Removed", [("id", Value::Str(id))]);
        }
        let p: TrustedPublisher = try rokon::from_str(r.body) catch e {
            throw index::err(400, f"the body is `TrustedPublisher {{ stone: .., repository: \"owner/repo\", workflow: \"publish.yml\", environment: \"\" }}`: {e}");
        };
        return rokon_value(200, rokon::to_value(try add_trusted(cfg, db, a, auth.admin, p)));
    }
    if !trusted && !may_act(cfg, auth.login) { throw index::err(403, "Publishing is not open yet"); }
    try index::sync(cfg.index);
    let by = auth.actor;
    by.at = now_secs();
    if r.path == "/api/v1/publish" {
        let p = try index::parse_publish(r.body);
        let e = p.entry;
        let k = (if e.native { "native/" } else { "" }) + index::key(e.name);
        let owners = owners_of(db, k);
        if !may(auth, db, k, try index::exists(cfg.index, e.native, e.name)) {
            throw index::err(403, if trusted { f"this token publishes only the stones that trust its workflow, not `{e.name}`" } else { f"`{e.name}` belongs to other accounts" });
        }
        let warnings: List<Value> = List::new();
        for w in p.warnings { warnings.push(Value::Str(w)); }
        try index::check_source(cfg.data + "/sources", e);
        if let have: str = try index::tree_at(cfg.index, e.native, e.name, e.version) {
            try fill_in(cfg, db, k, p, have, by);
            warnings.push(Value::Str(f"{e.name} {e.version} was already in the index from this tree; its missing metadata is filled in"));
        } else {
            try index::publish(cfg.index, e, auth.who);
            // An exchanged token has no account to own the name.
            if owners is none && !trusted { db.owners.push(Owner { name: k, accounts: [auth.account.id] }); }
            if !p.readme.is_empty() {
                let rp = meta::readme_file(cfg.data, k, e.version);
                try {
                    fs::create_dir_all(layout::dir_of(rp));
                    fs::write(rp, p.readme);
                } catch x { eprintln(f"readme: {x}"); };
            }
            let i = release_at(db, k, e.version);
            db.releases[i].meta = p.meta;
            db.releases[i].published_by = by;
        }
        try save_db(cfg, db) catch x { eprintln(f"data: {x}"); };
        STALE.store(1);
        return rokon_resp(200, "Published", [("name", Value::Str(e.name)), ("version", Value::Str(e.version)), ("file", Value::Str(e.file)), ("warnings", Value::List(warnings))]);
    }
    let y: Yank = try rokon::from_str(r.body) catch e { throw index::err(400, f"the body is `Yank {{ name: .., version: .., undo: false, native: false, message: \"..\" }}`: {e}"); };
    if y.message.len() > YANK_MESSAGE_MAX { throw index::err(400, f"a yank message is at most {YANK_MESSAGE_MAX} bytes"); }
    if y.undo && !y.message.is_empty() { throw index::err(400, "an unyank takes no message"); }
    let k = (if y.native { "native/" } else { "" }) + index::key(y.name);
    if !may(auth, db, k, true) { throw index::err(403, f"`{y.name}` belongs to other accounts"); }
    let changed = try index::yank(cfg.index, y.name, y.version, !y.undo, y.native, auth.who);
    // Yanking a yanked version again only replaces its message.
    if changed || (!y.undo && !y.message.is_empty()) {
        let i = release_at(db, k, y.version);
        if changed {
            if y.undo { db.releases[i].unyanked_by = by; } else { db.releases[i].yanked_by = by; }
        }
        db.releases[i].yank_message = y.message;
        try save_db(cfg, db) catch x { eprintln(f"data: {x}"); };
        STALE.store(1);
    }
    rokon_resp(200, "Yanked", [("name", Value::Str(y.name)), ("version", Value::Str(y.version)), ("yanked", Value::Bool(!y.undo))])
}

/// An OG card asked for by the version render.mjs drew it from (the `.v`
/// beside it), and a stylesheet or script asked for by its content
/// version (layout::asset), never change: cache them for good. Bare,
/// stale or unrendered card addresses stay short; pages are cached for a
/// minute; everything else revalidates.
pub fn cache_for(site: Site, path: str, f: str, query: str) -> str {
    let v = http::form(query).get("v") ?? "";
    if path == "/og.png" || (path.starts_with("/og/") && path.ends_with(".png")) {
        let drawn = try fs::read_to_str(f + ".v") catch _ { "" };
        return if !v.is_empty() && v == drawn.trim() { IMMUTABLE } else { "public, max-age=3600" };
    }
    // The kit's fonts: unversioned names, so a day and the ETag.
    if path.starts_with("/fonts/") { return "public, max-age=86400"; }
    let want = layout::asset_version(site, path[1:]);
    if !want.is_empty() { return if v == want { IMMUTABLE } else { "no-cache" }; }
    if f.ends_with(".html") { HTML_CACHE } else { "no-cache" }
}

/// `public/.stones.rokon` (main.rok); empty when it cannot be read.
fn rows(site: Site) -> List<layout::Row> {
    // A rebuild swaps `public/` (see route): look again a few times.
    for k in 0..4 {
        if k > 0 { thread::sleep(Duration::ms(50)); }
        let text = try fs::read_to_str(site.out + "/.stones.rokon") catch _ { continue; };
        return try rokon::from_str(text) catch _ { List::new() };
    }
    List::new()
}

/// `/stones/<name>..` with no page: a 301 when the name only differs in
/// case, else a 404 naming the stone (or its missing version) and the
/// closest names. None when `name` is a stone and the page is something
/// else.
fn missing_stone(site: Site, p: str, rest: str, query: str) -> Resp | none {
    let (raw, tail) = rest.split_once("/") ?? (rest, "");
    let name = http::pct_decode(raw, false) ?? raw;
    let names: List<str> = List::new();
    for row in rows(site) { names.push(row.name); }
    let has = names.contains(name);
    if !has {
        for n in names {
            if n == name.to_lowercase() {
                let to = "/stones/" + n + (if tail.is_empty() { "" } else { "/" + tail });
                return Resp { status: 301, headers: [url::moved(to, query), "Cache-Control: public, max-age=3600"], body: "", file: "" };
            }
        }
        let near: List<(str, str)> = List::new();
        for n in layout::closest(names, name) { near.push(("/stones/" + n, n)); }
        let sentence = if near.is_empty() { "Nothing in the index has that name. Search with <kbd class=\"kbd\">/</kbd>, or go to:" } else { "Stones with a similar name:" };
        near.push(("/stones", "All stones"));
        near.push(("/publishing", "Publishing a stone"));
        let body = f"<div class=\"frame lost-page\">{web::chrome::not_found(f"No stone named {name}", sentence, near)}</div>\n";
        return html(404, layout::page(site, p[1:], f"No stone named {name}", body));
    }
    let ver = (tail.split_once("/") ?? (tail, "")).0;
    if !ver.is_empty() && ver.byte(0) >= 48u8 && ver.byte(0) <= 57u8 {
        let links: List<(str, str)> = [(f"/stones/{name}/versions", f"Versions of {name}"), (f"/stones/{name}", f"{name}, latest version")];
        let body = f"<div class=\"frame lost-page\">{web::chrome::not_found(f"No version {ver} of {name}", "The index has no such version. Go to:", links)}</div>\n";
        return html(404, layout::page(site, p[1:], f"No version {ver} of {name}", body));
    }
    none
}

fn route(cfg: Cfg, site: Site, r: Request) throws -> Resp {
    let p = r.path;
    if p.starts_with("/api/") { return api_route(cfg, r); }
    if p == http::REPORT_PATH {
        if r.method != "POST" { return Resp { status: 405, headers: ["Content-Type: text/plain; charset=utf-8", "Cache-Control: no-store"], body: "POST only\n", file: "" }; }
        if let line: str = http::csp_report(r.body) { eprintln(line); }
        return Resp { status: 204, headers: ["Cache-Control: no-store"], body: "", file: "" };
    }
    if p == http::SPECULATION_PATH && (r.method == "GET" || r.method == "HEAD") {
        return Resp { status: 200, headers: [http::SPECULATION_TYPE, "Cache-Control: public, max-age=3600"], body: http::SPECULATION_RULES, file: "" };
    }
    let post = r.method == "POST";
    let get = r.method == "GET" || r.method == "HEAD";
    if p == "/login" && get { return try login(cfg); }
    if p == "/auth/github/callback" && get { return try callback(cfg, site, r); }
    if (p == "/me" && get) || (post && (p == "/logout" || p == "/me/tokens" || (p.starts_with("/me/tokens/") && p.ends_with("/revoke")) || p == "/me/trusted" || (p.starts_with("/me/trusted/") && p.ends_with("/remove")))) {
        return try account_route(cfg, site, r);
    }
    if !get { return message(site, p, 405, "Method not allowed", "Only GET here."); }
    if let c: str = url::canonical(p) {
        return Resp { status: 301, headers: [url::moved(c, r.query), "Cache-Control: public, max-age=3600"], body: "", file: "" };
    }
    // A search or another order: the list page, filtered and sorted here
    // (it works without JS). The bare list is a file.
    if p == "/stones" {
        let f = http::form(r.query);
        let q = f.get("q") ?? "";
        let sort = f.get("sort") ?? "";
        if !q.trim().is_empty() || !sort.is_empty() {
            let (title, body) = layout::list_page(rows(site), q, sort);
            return shared_html(200, layout::page(site, "stones/index.html", title, body));
        }
    }
    // Stone names are lowercase: never let a case-insensitive file system
    // answer for `/stones/JSON`.
    if let rest: str = p.strip_prefix("/stones/") {
        let seg = (rest.split_once("/") ?? (rest, "")).0;
        if seg != seg.to_lowercase() {
            if let m: Resp = missing_stone(site, p, rest, r.query) { return m; }
        }
    }
    // A rebuild renames `public/` away and the new site into its place
    // (main.rok): in between there is no site, which is not a 404.
    for k in 0..5 {
        if k > 0 {
            if fs::exists(site.out) { break; }
            thread::sleep(Duration::ms(50));
        }
        if let f: str = http::page_file(site.out, p) {
            return Resp { status: 200, headers: [f"Content-Type: {http::content_type(f)}", "Cache-Control: " + cache_for(site, p, f, r.query)], body: "", file: f };
        }
    }
    if let rest: str = p.strip_prefix("/stones/") {
        if let m: Resp = missing_stone(site, p, rest, r.query) { return m; }
    }
    // The 404 every Rok site shares, as public/404.html has it.
    html(404, layout::page(site, p[1:], "Not found", layout::not_found()))
}

/// The bytes of `file`, found for `path`. A rebuild swaps `public/` for
/// the new site (main.rok), so a file found a moment ago can be gone:
/// look it up again a few times before giving up. Never an empty 200.
fn read_page(site: Site, path: str, file: str) -> List<u8> | none {
    let f = file;
    for k in 0..4 {
        if k > 0 {
            thread::sleep(Duration::ms(50));
            f = http::page_file(site.out, path) ?? f;
        }
        let got = true;
        let b = try fs::read(f) catch _ {
            got = false;
            List::new()
        };
        if got { return b; }
    }
    none
}

fn handle(s: TcpStream, cfg: Cfg, site: Site) {
    let t0 = Instant::now();
    let r = try http::read_request(s, http::MAX_BODY, Duration::secs(30)) catch e {
        try http::send(s, e.status, ["Content-Type: text/plain; charset=utf-8"], e.msg + "\n", false) catch _ {};
        try s.close() catch _ {};
        return;
    };
    let resp = try route(cfg, site, r) catch e {
        eprintln(f"{r.method} {r.path}: {e}");
        message(site, r.path, 500, "Server error", "Something went wrong.")
    };
    let sent = resp.status;
    if !resp.file.is_empty() {
        if let data: List<u8> = read_page(site, r.path, resp.file) {
            sent = respond(s, r, 200, resp.headers, data);
        } else {
            resp = message(site, r.path, 503, "Try again", "The site is being rebuilt. Reload the page in a moment.");
            resp.headers.push("Retry-After: 1");
            sent = respond(s, r, resp.status, resp.headers, resp.body.as_bytes().to_list());
        }
    } else {
        sent = respond(s, r, resp.status, resp.headers, resp.body.as_bytes().to_list());
    }
    try s.close() catch _ {};
    // The path only: queries carry OAuth codes.
    eprintln(f"{r.method} {r.path} {sent} {t0.elapsed().as_ms()}ms");
}

/// Whether an If-None-Match value names `tag` (http::etag). A proxy that
/// compresses may have marked the tag (`"..-gzip"`), which
/// http::not_modified does not undo, and `W/` is ignored (weak
/// comparison, as RFC 9110 has for If-None-Match).
pub fn etag_matches(header: str, tag: str) -> bool {
    for part in header.split(",") {
        let t = part.trim();
        if t == "*" { return true; }
        t = t.strip_prefix("W/") ?? t;
        if let k: usize = t.find("-") { t = t[:k] + "\""; }
        if t == tag { return true; }
    }
    false
}

/// Send a response. A 200 anyone may cache gets an ETag, and a request
/// that already has it a 304. The status sent.
fn respond(s: TcpStream, r: Request, status: i32, headers: List<str>, body: List<u8>) -> i32 {
    let head = r.method == "HEAD";
    if headers.contains("Content-Type: text/html; charset=utf-8") {
        let text = (try? str::from_utf8(body)) ?? "";
        headers.push(if text.contains("<select") { CSP_SELECT } else { CSP });
        headers.push(http::REPORTING);
        headers.push(http::SPECULATION);
    }
    if status == 200 && (r.method == "GET" || head) && !headers.contains("Cache-Control: no-store") {
        let tag = http::etag(body);
        headers.push("ETag: " + tag);
        if etag_matches(r.header("if-none-match"), tag) {
            // The validators and Cache-Control, not the type; http::send
            // writes a 304 without a body or Content-Length.
            let kept: List<str> = List::new();
            for x in headers {
                if !x.to_lowercase().starts_with("content-type:") { kept.push(x); }
            }
            try http::send(s, 304, kept, "", head) catch _ {};
            return 304;
        }
    }
    try http::send(s, status, headers, body, head) catch _ {};
    status
}

/// Rebuild the site whenever `STALE` is set, one build at a time. Where
/// og/node_modules is installed, draw the new cards with og/render.mjs
/// and build again so the pages point at them; elsewhere they keep the
/// site card until a deploy draws them.
fn rebuild_loop(index_dir: str, data: str, out: str) {
    let exe = try env::current_exe() catch e {
        eprintln(f"cannot find this program to rebuild the site: {e}");
        return;
    };
    loop {
        if STALE.swap(0) == 1 {
            let st = try Command::new(exe.as_str()).args(["--index", index_dir, "--data", data]).status() catch e {
                eprintln(f"site rebuild: {e}");
                continue;
            };
            if !st.success() {
                eprintln(f"site rebuild: {st}");
                continue;
            }
            if !fs::exists("og/node_modules") { continue; }
            let r = try Command::new("node").args(["og/render.mjs", out, "og/manifest.tsv"]).status() catch e {
                eprintln(f"og cards: node: {e}");
                continue;
            };
            if !r.success() {
                eprintln(f"og cards: {r}");
                continue;
            }
            let again = try Command::new(exe.as_str()).args(["--index", index_dir, "--data", data]).status() catch e {
                eprintln(f"site rebuild: {e}");
                continue;
            };
            if !again.success() { eprintln(f"site rebuild: {again}"); }
        }
        thread::sleep(Duration::secs(1));
    }
}

pub fn serve(site: Site) throws {
    let cfg = try load_cfg(".env");
    if !fs::exists(cfg.index + "/.git") { throw ApiError { status: 0, msg: f"ROKSTONES_INDEX={cfg.index} is not a git checkout" }; }
    // Start from the index's state: lines pushed by others (a deploy, an
    // --index-dir publish) reach the checkout only through a sync.
    try index::sync(cfg.index) catch e { eprintln(f"index sync: {e.msg}"); };
    try fs::create_dir_all(cfg.data);
    // Fail now on a bad data file or bootstrap file, not on the first
    // request.
    let db = try load_db(cfg);
    let seeds = if cfg.trusted.is_empty() { List::<TrustedPublisher>::new() } else { try trust::read_seeds(cfg.trusted) };
    db.trusted = trust::merge_seeds(db.trusted, seeds);
    try save_db(cfg, db);
    eprintln(f"trusted publishing: OIDC tokens from {cfg.issuer} for audience {cfg.audience}; {seeds.len()} publishers from ROKSTONES_TRUSTED");
    using l = try net::tcp_listen(cfg.addr) {
        eprintln(f"serving {site.out}/ and the API on http://{cfg.addr} for {cfg.url}");
        STALE.store(1);
        let ix = cfg.index;
        let data = cfg.data;
        let out = site.out;
        let bg = thread::spawn(|| {
            rebuild_loop(ix, data, out);
            0
        });
        bg.detach();
        for c in l.incoming().results() {
            let s = try c.get() catch e {
                eprintln(f"accept: {e}");
                continue;
            };
            if ACTIVE.fetch_add(1) >= MAX_CONNS {
                ACTIVE.fetch_sub(1);
                // Read what the request sent first: closing a socket with
                // unread data resets it, and a proxy that sees the reset
                // before the answer reports a 502 instead of this 503.
                s.set_read_timeout(Duration::ms(20));
                _ = try s.read(secret::zeros(16384)) catch _ { 0usize };
                try http::send(s, 503, ["Content-Type: text/plain; charset=utf-8", "Retry-After: 1"], "busy\n", false) catch _ {};
                try s.close() catch _ {};
                continue;
            }
            let t = thread::spawn(|| {
                handle(s, cfg, site);
                ACTIVE.fetch_sub(1);
                0
            });
            t.detach();
        }
    }
}

#[cfg(test)]
fn expect(ok: bool, what: str) {
    if !ok { panic(what); }
}

#[test]
fn env_files() {
    let f = parse_env("# c\n\nA=1\nexport B = \"two words\"\nC='x=y'\n=bad\nD=\n");
    expect(f["A"] == "1" && f["B"] == "two words" && f["C"] == "x=y" && f["D"] == "" && f.len() == 4, "parse");
    let cfg = Cfg { url: "", addr: "", client_id: "", client_secret: "", admins: ",alice,bob-2,", data: "", index: "", oauth: "", api: "" };
    expect(is_admin(cfg, "Alice") && is_admin(cfg, "bob-2") && !is_admin(cfg, "bob") && !is_admin(cfg, ""), "admins");
    // Closed: only the admins act, and only their publishers and the seeds count.
    expect(may_act(cfg, "alice") && !may_act(cfg, "bob") && !may_act(cfg, ""), "closed");
    let p = TrustedPublisher { stone: "geom", repository: "acme/geom", workflow: "publish.yml", added_by: "bob" };
    expect(!counts(cfg, p), "a non-admin's publisher");
    p.added_by = "alice";
    expect(counts(cfg, p), "an admin's publisher");
    let seed = TrustedPublisher { stone: "geom", repository: "acme/geom", workflow: "publish.yml", seeded: true };
    expect(counts(cfg, seed), "seeded");
    cfg.open = true;
    p.added_by = "bob";
    expect(may_act(cfg, "bob") && !may_act(cfg, "") && counts(cfg, p), "open");
}

#[test]
fn ownership_and_tokens() {
    expect(may_publish(none, false, 5i64, false), "first publisher");
    expect(!may_publish(none, true, 5i64, false), "unowned names in the index are the admins'");
    expect(may_publish([5i64], true, 5i64, false) && !may_publish([6i64], true, 5i64, false), "owners");
    expect(may_publish([6i64], true, 5i64, true), "admins publish any");
    let t = "rks_" + "ab".repeat(32);
    let db = Db { releases: List::new(), accounts: List::new(), sessions: List::new(), tokens: [Token { id: "1", name: "n", account: 1i64, hash: secret::sha256_hex(t), created: 0i64, last_used: 0i64 }], owners: List::new() };
    expect(token_of(db, t) is Token && token_of(db, t.replace("rks_a", "rks_b")) is none && token_of(db, "ab".repeat(34)) is none, "lookup");
    let back: Db = try rokon::from_str(try! rokon::to_str(db)) catch e { panic(f"{e}"); };
    expect(back.tokens.len() == 1 && back.tokens[0].hash == db.tokens[0].hash, "data file round trip");
    expect(date(0i64) == "never" && date(1700000000i64) == "2023-11-14" && date(951782400i64) == "2000-02-29", "dates");
}

#[test]
fn trusted_scope() {
    let db = Db { accounts: List::new(), sessions: List::new(), tokens: List::new(), owners: [Owner { name: "geom", accounts: [5i64] }] };
    let nobody = Account { id: 0i64, login: "", created: 0i64 };
    let t = Auth { account: nobody, admin: false, scope: ["geom", "ge_om"], login: "github:x", who: "", actor: nobody_did() };
    expect(may(t, db, "geom", true) && may(t, db, "ge_om", false) && !may(t, db, "json", true) && !may(t, db, "native/geom", true), "scope");
    let owner = Auth { account: Account { id: 5i64, login: "o", created: 0i64 }, admin: false, scope: none, login: "o", who: "", actor: nobody_did() };
    expect(may(owner, db, "geom", true) && !may(owner, db, "json", true), "account");
    expect(may_manage(db, "geom", 5i64, false) && !may_manage(db, "geom", 6i64, false), "owners manage");
    expect(!may_manage(db, "markdown", 5i64, false) && may_manage(db, "markdown", 6i64, true), "unowned names are the admins'");
}

#[test]
fn validators() {
    let t = http::etag("abc");
    expect(t == "\"ba7816bf8f01cfea\"", t);
    expect(etag_matches(t, t) && etag_matches("W/" + t, t) && etag_matches("\"x\", \"ba7816bf8f01cfea-gzip\"", t) && etag_matches("*", t), "matches");
    expect(!etag_matches("", t) && !etag_matches("\"ba7816bf8f01cfeb\"", t), "misses");
}

#[test]
fn curl_quoting() {
    expect(cq("a\"b\\c") == "\"a\\\"b\\\\c\"", "curl quoting");
    expect(host_of("https://rokstones.io") == "rokstones.io" && host_of("http://Localhost:8080/x") == "localhost", "hosts");
}
